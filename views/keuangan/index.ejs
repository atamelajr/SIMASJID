                                <div class="col-md-6">
                                    <label class="form-label extra-small fw-bold">Tanggal Jatuh Tempo (Opsional)</label>
                                    <input type="date" name="due_date" id="edit_due_date" class="form-control form-control-sm">
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Kategori Transaksi (COA)</label>
                            <select name="category_id" id="edit_category_id" class="form-select" required>
                                <% categories.forEach(cat => { %>
                                    <option value="<%= cat.id %>">
                                        <%= cat.account_code %> - <%= cat.name %> (<%= cat.sub_type %>)
                                    </option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" id="edit_labelAmount">Jumlah / Nilai Estimasi (Rp)</label>
                            <input type="number" step="0.01" name="amount" id="edit_amount" class="form-control" placeholder="Contoh: 500000" required>
                        </div>
                        <div class="col-md-6" id="edit_wrapperDonor">
                            <label class="form-label fw-semibold">Nama Donatur / Penyumbang</label>
                            <input type="text" name="donor_name" id="edit_donor_name" class="form-control" placeholder="Nama Donatur">
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-semibold">Keterangan / Catatan</label>
                            <textarea name="description" id="edit_description" class="form-control" rows="2"></textarea>
                        </div>

                        <!-- In-Kind Item Type Selector for Edit Modal -->
                        <div id="edit_wrapperItemType" class="col-12 border p-3 rounded bg-warning-subtle d-none">
                            <label class="form-label fw-bold text-dark"><i class="bi bi-box-seam me-1"></i>Jenis Donasi Barang Yang Diterima:</label>
                            <div class="d-flex gap-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="item_kind_type" id="edit_kindAsset" value="Asset" onchange="toggleEditInKindForm('Asset')" checked>
                                    <label class="form-check-label fw-semibold" for="edit_kindAsset">
                                        Barang Modal / Aset Tetap (Sound System, AC, Karpet, Mimbar, dll.)
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="item_kind_type" id="edit_kindMaterial" value="Material" onchange="toggleEditInKindForm('Material')">
                                    <label class="form-check-label fw-semibold" for="edit_kindMaterial">
                                        Material / Persediaan (Semen, Pasir, Cat, Sabun, dll.)
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Dynamic Section for Modal (Fixed Asset) for Edit Modal -->
                        <div id="edit_sectionAsset" class="col-12 border p-3 rounded bg-light d-none">
                            <h6 class="fw-bold text-primary mb-2"><i class="bi bi-box-fill me-1"></i>Detail Barang Aset Tetap</h6>
                            <div class="row g-2">
                                <div class="col-md-5">
                                    <label class="form-label extra-small fw-bold">Pilih Barang Aset (Dari Katalog)</label>
                                    <select name="asset_name" id="edit_asset_select" class="form-select form-select-sm">
                                        <option value="">-- Pilih dari Katalog Aset --</option>
                                        <% masterItems.filter(i => i.type === 'Aset').forEach(i => { %>
                                            <option value="<%= i.name %>"><%= i.name %> (<%= i.unit_name || '' %>)</option>
                                        <% }) %>
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label extra-small fw-bold">Jumlah (Qty)</label>
                                    <input type="number" name="asset_qty" id="edit_asset_qty" class="form-control form-control-sm fw-bold" value="1" min="1">
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label extra-small fw-bold">Kondisi Barang</label>
                                    <select name="asset_condition" id="edit_asset_condition" class="form-select form-select-sm">
                                        <option value="Baik">Kondisi: Baik</option>
                                        <option value="Rusak Ringan">Rusak Ringan</option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label extra-small fw-bold">Lokasi Penempatan</label>
                                    <select name="asset_location" id="edit_asset_location" class="form-select form-select-sm">
                                        <% if (typeof locations !== 'undefined' && locations.length > 0) { %>
                                            <% locations.forEach(loc => { %>
                                                <option value="<%= loc.name %>"><%= loc.name %></option>
                                            <% }) %>
                                        <% } else { %>
                                            <option value="Ruang Utama Sholat">Ruang Utama Sholat</option>
                                            <option value="Masjid">Masjid</option>
                                        <% } %>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Dynamic Section for Material (Inventory) for Edit Modal -->
                        <div id="edit_sectionInventory" class="col-12 border p-3 rounded bg-light d-none">
                            <h6 class="fw-bold text-warning mb-2"><i class="bi bi-boxes me-1"></i>Detail Material / Persediaan (Stok Masuk)</h6>
                            <div class="row g-2">
                                <div class="col-md-4">
                                    <label class="form-label extra-small fw-bold">Pilih Material (Dari Katalog)</label>
                                    <select name="inventory_name" id="edit_inventory_select" class="form-select form-select-sm">
                                        <option value="">-- Pilih dari Katalog Material --</option>
                                        <% masterItems.filter(i => i.type === 'Material').forEach(i => { %>
                                            <option value="<%= i.name %>"><%= i.name %></option>
                                        <% }) %>
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label extra-small fw-bold">Jumlah Stok</label>
                                    <input type="number" step="0.1" name="inventory_qty" id="edit_inventory_qty" class="form-control form-control-sm" placeholder="Jumlah" value="1">
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label extra-small fw-bold">Satuan (Dropdown)</label>
                                    <select name="inventory_unit" id="edit_inventory_unit_select" class="form-select form-select-sm">
                                        <% units.forEach(u => { %>
                                            <option value="<%= u.code %>"><%= u.name %> (<%= u.code %>)</option>
                                        <% }) %>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label extra-small fw-bold">Kategori</label>
                                    <select name="inventory_category" id="edit_inventory_category" class="form-select form-select-sm">
                                        <option value="Bahan Bangunan">Bahan Bangunan</option>
                                        <option value="Bahan & Alat Kebersihan">Bahan & Alat Kebersihan</option>
                                        <option value="Alat Tulis Kantor (ATK)">Alat Tulis Kantor (ATK)</option>
                                        <option value="Perlengkapan Dapur & Harian">Perlengkapan Dapur & Harian</option>
                                        <option value="Material dan Bahan Lainnya">Material dan Bahan Lainnya</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label fw-semibold">Ganti Bukti Transaksi (Opsional)</label>
                            <input type="file" name="proof_file" class="form-control">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-warning fw-bold"><i class="bi bi-check-circle me-1"></i> Simpan Perubahan</button>
