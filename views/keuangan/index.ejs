            </form>
        </div>
    </div>
</div>

<!-- Modal Pelunasan Utang -->
<div class="modal fade" id="modalPayDebt" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success-subtle">
                <h5 class="modal-title fw-bold text-dark"><i class="bi bi-cash-stack me-2"></i>Pelunasan Utang Usaha</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="formPayDebt" action="" method="POST">
                <div class="modal-body">
                    <div class="alert alert-info py-2 small">
                        <div class="fw-bold mb-1" id="pay_debt_trx_code">TRX-0000</div>
                        <div>Supplier/Toko: <strong id="pay_debt_creditor">Toko Abadi</strong></div>
                        <div>Total Utang: <strong class="text-danger fs-6" id="pay_debt_amount">Rp 0</strong></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Sumber Rekening Kas Pembayar</label>
                        <select name="paid_account_id" class="form-select" required>
                            <% accounts.forEach(acc => { %>
                                <option value="<%= acc.id %>"><%= acc.name %> (Saldo: <%= formatRupiah(acc.balance) %>)</option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tanggal Pelunasan Real</label>
                        <input type="date" name="payment_date" class="form-control" value="<%= new Date().toISOString().split('T')[0] %>" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-success fw-bold"><i class="bi bi-check-circle me-1"></i> Simpan Pelunasan Kas</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openPayDebtModal(trx) {
        document.getElementById('formPayDebt').action = '/keuangan/pay-debt/' + trx.id;
        document.getElementById('pay_debt_trx_code').innerText = trx.transaction_code;
        document.getElementById('pay_debt_creditor').innerText = trx.creditor_name || 'Supplier / Toko';
        document.getElementById('pay_debt_amount').innerText = 'Rp ' + Number(trx.amount).toLocaleString('id-ID');
        
        const modal = new bootstrap.Modal(document.getElementById('modalPayDebt'));
        modal.show();
    }

    function openEditModal(trx) {
        document.getElementById('formEditTransaction').action = '/keuangan/update/' + trx.id;
        document.getElementById('edit_transaction_date').value = trx.transaction_date ? trx.transaction_date.split('T')[0] : '';
        document.getElementById('edit_type').value = trx.type;

        let mode = 'Tunai';
        if (trx.payment_mode === 'Hutang') {
            mode = 'Hutang';
        } else if (trx.is_in_kind == 1 || trx.payment_mode === 'Donasi Barang') {
            mode = 'Donasi Barang';
        } else if (trx.payment_mode === 'Non-Tunai') {
            mode = 'Non-Tunai';
        } else {
            mode = 'Tunai';
        }
        document.getElementById('edit_payment_mode').value = mode;

        document.getElementById('edit_account_id').value = trx.account_id;
        document.getElementById('edit_category_id').value = trx.category_id;
        document.getElementById('edit_amount').value = trx.amount;
        document.getElementById('edit_donor_name').value = trx.donor_name || 'Hamba Allah';
        if (document.getElementById('edit_creditor_name')) {
            document.getElementById('edit_creditor_name').value = trx.creditor_name || '';
        }
        if (document.getElementById('edit_due_date')) {
            document.getElementById('edit_due_date').value = trx.due_date ? trx.due_date.split('T')[0] : '';
        }
        document.getElementById('edit_description').value = trx.description || '';

        // Reset/Populate Asset and Inventory fields for Edit Modal
        const editKindAsset = document.getElementById('edit_kindAsset');
        const editKindMaterial = document.getElementById('edit_kindMaterial');

        if (trx.inventory_name) {
            if (editKindMaterial) editKindMaterial.checked = true;
            document.getElementById('edit_inventory_select').value = trx.inventory_name;
            document.getElementById('edit_inventory_qty').value = trx.inventory_qty || 1;
            if (trx.inventory_unit) {
                document.getElementById('edit_inventory_unit_select').value = trx.inventory_unit;
            }
        } else {
            if (editKindAsset) editKindAsset.checked = true;
            document.getElementById('edit_asset_select').value = trx.asset_name || '';
            document.getElementById('edit_asset_condition').value = trx.asset_condition || 'Baik';
            document.getElementById('edit_asset_location').value = trx.asset_location || '';
        }

        onEditPaymentModeChange();

        const modal = new bootstrap.Modal(document.getElementById('modalEditTransaction'));
        modal.show();
    }

    function toggleEditInKindForm(kind) {
        const sectionAsset = document.getElementById('edit_sectionAsset');
        const sectionInventory = document.getElementById('edit_sectionInventory');
        if (kind === 'Asset') {
            if (sectionAsset) sectionAsset.classList.remove('d-none');
            if (sectionInventory) sectionInventory.classList.add('d-none');
        } else if (kind === 'Material') {
            if (sectionAsset) sectionAsset.classList.add('d-none');
            if (sectionInventory) sectionInventory.classList.remove('d-none');
        }
    }

    function onEditPaymentModeChange() {
        const mode = document.getElementById('edit_payment_mode').value;
        const isInKindInput = document.getElementById('edit_is_in_kind');
        const labelAmount = document.getElementById('edit_labelAmount');
        const wrapperAccount = document.getElementById('edit_wrapperAccount');
        const accountSelect = document.getElementById('edit_account_id');
        const amountInput = document.getElementById('edit_amount');
        const editWrapperItemType = document.getElementById('edit_wrapperItemType');
        const editWrapperDebt = document.getElementById('edit_wrapperDebt');
        const editWrapperDonor = document.getElementById('edit_wrapperDonor');

        if (mode === 'Hutang') {
            isInKindInput.value = '0';
            labelAmount.innerText = 'Jumlah Belanja Hutang (Rp)';
            if (wrapperAccount) wrapperAccount.classList.add('d-none');
            if (accountSelect) accountSelect.required = false;
            if (amountInput) amountInput.required = true;
            if (editWrapperItemType) editWrapperItemType.classList.add('d-none');
            if (editWrapperDebt) editWrapperDebt.classList.remove('d-none');
            if (editWrapperDonor) editWrapperDonor.classList.add('d-none');
            document.getElementById('edit_sectionAsset')?.classList.add('d-none');
            document.getElementById('edit_sectionInventory')?.classList.add('d-none');
        } else if (mode === 'Donasi Barang') {
            isInKindInput.value = '1';
            labelAmount.innerText = 'Nilai Estimasi Barang (Rp) (Opsional)';
            if (wrapperAccount) wrapperAccount.classList.add('d-none');
            if (accountSelect) accountSelect.required = false;
            if (amountInput) amountInput.required = false;
            if (editWrapperItemType) editWrapperItemType.classList.remove('d-none');
            if (editWrapperDebt) editWrapperDebt.classList.add('d-none');
            if (editWrapperDonor) editWrapperDonor.classList.remove('d-none');

            const isMaterial = document.getElementById('edit_kindMaterial')?.checked;
            toggleEditInKindForm(isMaterial ? 'Material' : 'Asset');
        } else {
            isInKindInput.value = '0';
            labelAmount.innerText = 'Jumlah (Rp)';
            if (wrapperAccount) wrapperAccount.classList.remove('d-none');
            if (accountSelect) accountSelect.required = true;
            if (amountInput) amountInput.required = true;
            if (editWrapperItemType) editWrapperItemType.classList.add('d-none');
            if (editWrapperDebt) editWrapperDebt.classList.add('d-none');
            if (editWrapperDonor) editWrapperDonor.classList.remove('d-none');
            document.getElementById('edit_sectionAsset')?.classList.add('d-none');
            document.getElementById('edit_sectionInventory')?.classList.add('d-none');
        }
    }
    function onAssetItemSelect() {
        const select = document.getElementById('asset_select');
        const selectedOption = select.options[select.selectedIndex];
        const unitId = selectedOption ? selectedOption.getAttribute('data-unitid') : null;
    }

    function onInventoryItemSelect() {
        const select = document.getElementById('inventory_select');
        const selectedOption = select.options[select.selectedIndex];
        const unitId = selectedOption ? selectedOption.getAttribute('data-unitid') : null;
        
        if (unitId) {
            const unitSelect = document.getElementById('inventory_unit_select');
            for (let i = 0; i < unitSelect.options.length; i++) {
                if (unitSelect.options[i].getAttribute('data-unitid') === unitId) {
                    unitSelect.selectedIndex = i;
                    break;
                }
            }
        }
    }

    function onCategoryChange() {
        const select = document.getElementById('categoryId');
        if (!select || select.selectedIndex === -1) return;
        const selectedOption = select.options[select.selectedIndex];
        const subType = selectedOption ? selectedOption.getAttribute('data-subtype') : null;
        const mode = document.getElementById('paymentMode').value;

        if (mode !== 'Donasi Barang') {
            document.getElementById('sectionAsset').classList.add('d-none');
            document.getElementById('sectionInventory').classList.add('d-none');

            if (subType === 'Modal') {
                document.getElementById('sectionAsset').classList.remove('d-none');
            } else if (subType === 'Material') {
                document.getElementById('sectionInventory').classList.remove('d-none');
            }
        }
    }

    function onPaymentModeChange() {
        const mode = document.getElementById('paymentMode').value;
        const isInKindInput = document.getElementById('isInKind');
        const labelAmount = document.getElementById('labelAmount');
        const wrapperItemType = document.getElementById('wrapperItemType');
        const wrapperAccount = document.getElementById('wrapperAccount');
        const wrapperDebt = document.getElementById('wrapperDebt');
        const wrapperDonor = document.getElementById('wrapperDonor');
        const accountSelect = wrapperAccount ? wrapperAccount.querySelector('select') : null;
        const amountInput = document.querySelector('input[name="amount"]');
        const donorInput = wrapperDonor ? wrapperDonor.querySelector('input[name="donor_name"]') : null;

        if (mode === 'Hutang') {
            isInKindInput.value = '0';
            labelAmount.innerText = 'Jumlah Belanja Hutang (Rp)';
            if (wrapperItemType) wrapperItemType.classList.add('d-none');
            if (wrapperAccount) wrapperAccount.classList.add('d-none');
            if (wrapperDebt) wrapperDebt.classList.remove('d-none');
            if (wrapperDonor) wrapperDonor.classList.add('d-none');
            if (accountSelect) accountSelect.required = false;
            if (amountInput) amountInput.required = true;
            if (donorInput) donorInput.required = false;
            onCategoryChange();
        } else if (mode === 'Donasi Barang') {
            isInKindInput.value = '1';
            labelAmount.innerText = 'Nilai Estimasi Barang (Rp) (Opsional)';
            if (wrapperItemType) wrapperItemType.classList.remove('d-none');
            if (wrapperAccount) wrapperAccount.classList.add('d-none');
            if (wrapperDebt) wrapperDebt.classList.add('d-none');
            if (wrapperDonor) wrapperDonor.classList.remove('d-none');
            if (accountSelect) accountSelect.required = false;
            if (amountInput) amountInput.required = false;
            if (donorInput) donorInput.required = true;
            
            const selectedKind = document.querySelector('input[name="item_kind_type"]:checked').value;
            toggleInKindForm(selectedKind);
        } else {
            isInKindInput.value = '0';
            labelAmount.innerText = 'Jumlah (Rp)';
            if (wrapperItemType) wrapperItemType.classList.add('d-none');
            if (wrapperAccount) wrapperAccount.classList.remove('d-none');
            if (wrapperDebt) wrapperDebt.classList.add('d-none');
            if (wrapperDonor) wrapperDonor.classList.remove('d-none');
            if (accountSelect) accountSelect.required = true;
            if (amountInput) amountInput.required = true;
            if (donorInput) donorInput.required = true;
            onCategoryChange();
        }
    }

    function toggleInKindForm(kindType) {
        document.getElementById('sectionAsset').classList.add('d-none');
        document.getElementById('sectionInventory').classList.add('d-none');

        if (kindType === 'Asset') {
            document.getElementById('sectionAsset').classList.remove('d-none');
        } else if (kindType === 'Material') {
            document.getElementById('sectionInventory').classList.remove('d-none');
        }
    }

    function onTypeChange() {
        const selectedType = document.getElementById('trxType').value;
        const categorySelect = document.getElementById('categoryId');
        const options = categorySelect.options;
        let firstValidOption = null;

        for (let i = 0; i < options.length; i++) {
            const optionType = options[i].getAttribute('data-type');
            if (optionType === selectedType) {
                options[i].hidden = false;
                options[i].disabled = false;
                if (!firstValidOption) {
                    firstValidOption = options[i];
                }
            } else {
                options[i].hidden = true;
                options[i].disabled = true;
            }
        }

        if (firstValidOption) {
            categorySelect.value = firstValidOption.value;
        }

        const paymentModeSelect = document.getElementById('paymentMode');
        const donasiOption = paymentModeSelect.querySelector('option[value="Donasi Barang"]');
        const hutangOption = paymentModeSelect.querySelector('option[value="Hutang"]');

        if (selectedType === 'Pengeluaran') {
            if (paymentModeSelect.value === 'Donasi Barang') {
                paymentModeSelect.value = 'Tunai';
            }
            if (donasiOption) donasiOption.disabled = true;
            if (hutangOption) hutangOption.disabled = false;
        } else {
            if (paymentModeSelect.value === 'Hutang') {
                paymentModeSelect.value = 'Tunai';
            }
            if (donasiOption) donasiOption.disabled = false;
            if (hutangOption) hutangOption.disabled = true;
        }

        onPaymentModeChange();
    }

    document.addEventListener('DOMContentLoaded', function() {
        onTypeChange();
    });

    const modalAddTrx = document.getElementById('modalAddTransaction');
    if (modalAddTrx) {
        modalAddTrx.addEventListener('shown.bs.modal', function () {
            onTypeChange();
        });
    }

    function validateMutationForm(form) {
        const source = form.querySelector('[name="account_id"]').value;
        const target = form.querySelector('[name="target_account_id"]').value;
        if (source && target && source === target) {
            alert('Rekening Asal dan Rekening Tujuan tidak boleh sama! Silakan pilih rekening yang berbeda.');
            return false;
        }
        return true;
    }
</script>

<!-- Modal Tambah Mutasi Kas & Bank -->
<div class="modal fade" id="modalAddMutation" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="bi bi-arrow-left-right me-2 text-primary"></i>Transfer Internal / Mutasi Kas & Bank</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/keuangan/create" method="POST" enctype="multipart/form-data" onsubmit="return validateMutationForm(this)">
                <input type="hidden" name="type" value="Mutasi">
                <div class="modal-body">
                    <div class="alert alert-info py-2 extra-small mb-3">
                        <i class="bi bi-info-circle me-1"></i> Transaksi mutasi memindahkan saldo dari <strong>Rekening Asal</strong> ke <strong>Rekening Tujuan</strong>. Total saldo gabungan kas masjid tidak berubah.
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Tanggal Mutasi / Transfer</label>
                            <input type="date" name="transaction_date" class="form-control" value="<%= new Date().toISOString().split('T')[0] %>" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Jumlah / Nominal Mutasi (Rp)</label>
                            <div class="input-group">
                                <span class="input-group-text font-monospace">Rp</span>
                                <input type="number" name="amount" class="form-control font-monospace" placeholder="0" min="1" step="any" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-danger"><i class="bi bi-dash-circle me-1"></i>Rekening Asal (Kas Berkurang)</label>
                            <select name="account_id" class="form-select" required>
                                <option value="">-- Pilih Rekening Asal --</option>
                                <% accounts.forEach(acc => { %>
                                    <option value="<%= acc.id %>"><%= acc.name %> (Saldo: <%= formatRupiah(acc.balance) %>)</option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-success"><i class="bi bi-plus-circle me-1"></i>Rekening Tujuan (Kas Bertambah)</label>
                            <select name="target_account_id" class="form-select" required>
                                <option value="">-- Pilih Rekening Tujuan --</option>
                                <% accounts.forEach(acc => { %>
                                    <option value="<%= acc.id %>"><%= acc.name %> (Saldo: <%= formatRupiah(acc.balance) %>)</option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-semibold">Keterangan / Keperluan Transfer</label>
                            <textarea name="description" class="form-control" rows="2" placeholder="Contoh: Setor tunai saldo kas jumat ke rekening BSI Pembangunan..." required></textarea>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-semibold">Upload Bukti Transfer / Resi Setor (Opsional)</label>
                            <input type="file" name="proof_file" class="form-control" accept="image/*,application/pdf">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle me-1"></i>Simpan Mutasi Kas</button>
                </div>
            </form>
        </div>
    </div>
</div>
