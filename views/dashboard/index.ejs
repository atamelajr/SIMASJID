<!-- Summary Cards Row -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card card-custom bg-primary text-white p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-white-50 mb-1 fw-semibold">Total Saldo Kas saat ini</h6>
                    <h3 class="fw-bold mb-0"><%= formatRupiah(summary.totalSaldo) %></h3>
                </div>
                <div class="bg-white bg-opacity-25 rounded-circle p-3">
                    <i class="bi bi-wallet-fill fs-2"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-custom bg-success text-white p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-white-50 mb-1 fw-semibold">Pemasukan Bulan Ini</h6>
                    <h3 class="fw-bold mb-0"><%= formatRupiah(summary.totalPenerimaanBulanIni) %></h3>
                </div>
                <div class="bg-white bg-opacity-25 rounded-circle p-3">
                    <i class="bi bi-arrow-down-left-circle-fill fs-2"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-custom bg-danger text-white p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-white-50 mb-1 fw-semibold">Pengeluaran Bulan Ini</h6>
                    <h3 class="fw-bold mb-0"><%= formatRupiah(summary.totalPengeluaranBulanIni) %></h3>
                </div>
                <div class="bg-white bg-opacity-25 rounded-circle p-3">
                    <i class="bi bi-arrow-up-right-circle-fill fs-2"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Progres Pembangunan Project Card -->
    <div class="col-md-7">
        <div class="card card-custom h-100 p-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0"><i class="bi bi-tools text-warning me-2"></i>Progres Pembangunan</h5>
                    <a href="/proyek" class="btn btn-sm btn-outline-primary">Lihat Detail Proyek</a>
                </div>

                <% if (activeProject) { %>
                    <h6 class="fw-semibold text-secondary"><%= activeProject.title %></h6>
                    <div class="d-flex justify-content-between small text-muted mb-2">
                        <span>Target RAB: <strong><%= formatRupiah(activeProject.target_budget) %></strong></span>
                        <span class="badge bg-warning text-dark"><%= activeProject.status %></span>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="small fw-bold">Realisasi Fisik</span>
                            <span class="small fw-bold text-primary"><%= activeProject.current_percentage %>%</span>
                        </div>
                        <div class="progress" style="height: 14px;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated bg-success" 
                                 role="progressbar" 
                                 style="width: <%= activeProject.current_percentage %>%;" 
                                 aria-valuenow="<%= activeProject.current_percentage %>" 
                                 aria-valuemin="0" 
                                 aria-valuemax="100">
                            </div>
                        </div>
                    </div>
                    <p class="text-muted small mb-0">Target Penyelesaian: <%= formatDate(activeProject.target_date) %></p>
                <% } else { %>
                    <p class="text-muted">Belum ada proyek pembangunan aktif.</p>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="col-md-5">
        <div class="card card-custom h-100 p-3">
            <div class="card-body">
                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-lightning-charge-fill text-primary me-2"></i>Aksi Cepat</h5>
                <div class="d-grid gap-2">
                    <a href="/keuangan" class="btn btn-light border text-start py-2 d-flex align-items-center">
                        <i class="bi bi-plus-circle-fill text-success fs-5 me-3"></i>
                        <div>
                            <div class="fw-bold">Input Penerimaan / Infaq</div>
                            <div class="small text-muted">Catat ZIS, Wakaf, Donasi</div>
                        </div>
                    </a>
                    <a href="/keuangan" class="btn btn-light border text-start py-2 d-flex align-items-center">
                        <i class="bi bi-dash-circle-fill text-danger fs-5 me-3"></i>
                        <div>
                            <div class="fw-bold">Input Pengeluaran / Belanja</div>
                            <div class="small text-muted">Belanja Modal, Material & Operasional</div>
                        </div>
                    </a>
                    <a href="/laporan" class="btn btn-light border text-start py-2 d-flex align-items-center">
                        <i class="bi bi-printer-fill text-info fs-5 me-3"></i>
                        <div>
                            <div class="fw-bold">Cetak Laporan Kasir / Kas</div>
                            <div class="small text-muted">Rekapitulasi masuk-keluar kas</div>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Log Aktivitas Terbaru -->
<div class="row">
    <div class="col-12">
        <div class="card card-custom p-3">
            <div class="card-body">
                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-clock-history text-secondary me-2"></i>Log Aktivitas Pengguna Terbaru</h5>
                <% if (summary.recentLogs && summary.recentLogs.length > 0) { %>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Waktu</th>
                                    <th>Pengguna</th>
                                    <th>Aksi</th>
                                    <th>Detail</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% summary.recentLogs.forEach(log => { %>
                                    <tr>
                                        <td class="small text-muted"><%= formatDate(log.created_at) %></td>
                                        <td class="fw-semibold"><%= log.user_name || 'Sistem' %></td>
                                        <td><span class="badge bg-secondary"><%= log.action %></span></td>
                                        <td class="small"><%= log.details %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <p class="text-muted small mb-0">Belum ada rekam aktivitas terbaru.</p>
                <% } %>
            </div>
        </div>
    </div>
</div>
