<!-- Modern Dashboard SIMASJID -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

<style>
    .dash-stat-card {
        border: none;
        border-radius: 16px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .dash-stat-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important;
    }
    .icon-shape {
        width: 54px;
        height: 54px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .btn-period {
        border-radius: 8px;
        padding: 6px 14px;
        font-weight: 500;
        font-size: 0.85rem;
    }
    .account-item {
        border-bottom: 1px solid #f1f5f9;
        padding: 10px 0;
    }
    .account-item:last-child {
        border-bottom: none;
    }
</style>

<!-- Top Stat Cards -->
<div class="row g-3 mb-4">
    <!-- Total Saldo Kas -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card dash-stat-card shadow-sm bg-white p-3 h-100 border-start border-4 border-primary">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase tracking-wider">Total Saldo Kas</span>
                    <h3 class="fw-bold text-dark mb-0 mt-1"><%= formatRupiah(summary.totalSaldo) %></h3>
                    <span class="badge bg-primary-subtle text-primary mt-2">
                        <i class="bi bi-wallet2 me-1"></i> <%= summary.cashAccounts ? summary.cashAccounts.length : 0 %> Rekening Kas
                    </span>
                </div>
                <div class="icon-shape bg-primary text-white shadow-sm">
                    <i class="bi bi-bank fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Pemasukan Bulan Ini -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card dash-stat-card shadow-sm bg-white p-3 h-100 border-start border-4 border-success">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase tracking-wider">Pemasukan Bulan Ini</span>
                    <h3 class="fw-bold text-success mb-0 mt-1"><%= formatRupiah(summary.totalPenerimaanBulanIni) %></h3>
                    <span class="badge bg-success-subtle text-success mt-2">
                        <i class="bi bi-arrow-down-left me-1"></i> Infaq & Donasi
                    </span>
                </div>
                <div class="icon-shape bg-success text-white shadow-sm">
                    <i class="bi bi-arrow-down-right-circle-fill fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Pengeluaran Bulan Ini -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card dash-stat-card shadow-sm bg-white p-3 h-100 border-start border-4 border-danger">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase tracking-wider">Pengeluaran Bulan Ini</span>
                    <h3 class="fw-bold text-danger mb-0 mt-1"><%= formatRupiah(summary.totalPengeluaranBulanIni) %></h3>
                    <span class="badge bg-danger-subtle text-danger mt-2">
                        <i class="bi bi-arrow-up-right me-1"></i> Operasional & Modal
                    </span>
                </div>
                <div class="icon-shape bg-danger text-white shadow-sm">
                    <i class="bi bi-arrow-up-left-circle-fill fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Belanja Utang / Info Kas -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card dash-stat-card shadow-sm bg-white p-3 h-100 border-start border-4 border-warning">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase tracking-wider">Belanja Utang</span>
                    <h3 class="fw-bold text-warning mb-0 mt-1"><%= formatRupiah(summary.unpaidDebt ? summary.unpaidDebt.amount : 0) %></h3>
                    <span class="badge bg-warning-subtle text-warning-emphasis mt-2">
                        <i class="bi bi-exclamation-circle me-1"></i> <%= summary.unpaidDebt ? summary.unpaidDebt.count : 0 %> Belum Lunas
                    </span>
                </div>
                <div class="icon-shape bg-warning text-dark shadow-sm">
                    <i class="bi bi-credit-card-2-front-fill fs-3"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Section: Grafik Transaksi Multi-Periode -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card card-custom p-4 shadow-sm border-0">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                <div>
                    <h5 class="fw-bold text-dark mb-1">
                        <i class="bi bi-graph-up-arrow text-primary me-2"></i>Grafik Transaksi & Arus Kas
                    </h5>
                    <p class="text-muted small mb-0">Perbandingan penerimaan (infaq/donasi) dan pengeluaran secara real-time</p>
                </div>
                <div class="btn-group shadow-sm p-1 bg-light rounded-3" role="group" id="periodBtnGroup">
                    <button type="button" class="btn btn-period btn-light text-secondary" onclick="updateChartPeriod('daily', this)">Harian</button>
                    <button type="button" class="btn btn-period btn-light text-secondary" onclick="updateChartPeriod('weekly', this)">Mingguan</button>
                    <button type="button" class="btn btn-period btn-primary active shadow-sm" onclick="updateChartPeriod('monthly', this)">Bulanan</button>
                    <button type="button" class="btn btn-period btn-light text-secondary" onclick="updateChartPeriod('yearly', this)">Tahunan</button>
                </div>
            </div>

            <!-- Canvas Container -->
            <div style="position: relative; height: 340px; width: 100%;">
                <canvas id="transactionChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Section: Detail Kas, Utang & Aset -->
<div class="row g-4 mb-4">
    <!-- Rincian Rekening Kas & Bank -->
    <div class="col-lg-6">
        <div class="card card-custom p-3 h-100 shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-building-fill text-info me-2"></i>Rincian Saldo Rekening Kas & Bank
                    </h5>
                    <a href="/master/accounts" class="btn btn-sm btn-outline-secondary">Kelola Rekening</a>
                </div>

                <% if (summary.cashAccounts && summary.cashAccounts.length > 0) { %>
                    <div class="mt-3">
                        <% summary.cashAccounts.forEach(acc => { 
                            const percentage = summary.totalSaldo > 0 ? Math.round((acc.balance / summary.totalSaldo) * 100) : 0;
                        %>
                            <div class="account-item">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <div>
                                        <span class="fw-semibold text-dark"><%= acc.name %></span>
                                        <% if (acc.account_number) { %>
                                            <span class="small text-muted ms-1">(<%= acc.account_number %>)</span>
                                        <% } %>
                                        <span class="badge bg-light text-secondary border ms-1"><%= acc.type %></span>
                                    </div>
                                    <span class="fw-bold text-primary"><%= formatRupiah(acc.balance) %></span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar bg-info" role="progressbar" style="width: <%= Math.max(2, percentage) %>%;" aria-valuenow="<%= percentage %>" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <p class="text-muted small">Belum ada akun kas yang terdaftar.</p>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Ringkasan Utang & Aset / Inventaris -->
    <div class="col-lg-6">
        <div class="card card-custom p-3 h-100 shadow-sm border-0">
            <div class="card-body">
                <h5 class="fw-bold text-dark mb-3">
                    <i class="bi bi-shield-check text-success me-2"></i>Ringkasan Utang, Aset & Inventaris
                </h5>

                <div class="row g-3">
                    <!-- Status Utang -->
                    <div class="col-12">
                        <div class="p-3 bg-light rounded-3 d-flex align-items-center justify-content-between border">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-warning-subtle text-warning p-3 rounded-3">
                                    <i class="bi bi-receipt-cutoff fs-4"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark">Belanja Kredit / Utang Belum Lunas</div>
                                    <div class="small text-muted"><%= summary.unpaidDebt ? summary.unpaidDebt.count : 0 %> Transaksi memerlukan pelunasan</div>
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="fw-bold text-danger fs-6"><%= formatRupiah(summary.unpaidDebt ? summary.unpaidDebt.amount : 0) %></div>
                                <a href="/keuangan" class="btn btn-sm btn-outline-warning text-dark mt-1">Lihat / Pelunasan</a>
                            </div>
                        </div>
                    </div>

                    <!-- Ringkasan Aset Tetap -->
                    <div class="col-6">
                        <div class="p-3 bg-light rounded-3 border">
                            <div class="text-secondary small fw-semibold">Total Aset Tetap</div>
                            <div class="fs-4 fw-bold text-dark mt-1"><%= summary.assetSummary ? summary.assetSummary.totalAssets : 0 %> <span class="fs-6 fw-normal text-muted">Unit</span></div>
                            <div class="extra-small text-muted mt-1">Nilai: <%= formatRupiah(summary.assetSummary ? summary.assetSummary.totalAssetValue : 0) %></div>
                        </div>
                    </div>

                    <!-- Ringkasan Inventaris -->
                    <div class="col-6">
                        <div class="p-3 bg-light rounded-3 border">
                            <div class="text-secondary small fw-semibold">Inventaris & Material</div>
                            <div class="fs-4 fw-bold text-dark mt-1"><%= summary.assetSummary ? summary.assetSummary.totalInventoryItems : 0 %> <span class="fs-6 fw-normal text-muted">Jenis</span></div>
                            <div class="extra-small text-muted mt-1">Total Stok: <%= summary.assetSummary ? summary.assetSummary.totalInventoryStock : 0 %></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Section: Progres Pembangunan & Log Aktivitas -->
<div class="row g-4">
    <!-- Progres Pembangunan Project Card -->
    <div class="col-lg-6">
        <div class="card card-custom h-100 p-3 shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-tools text-warning me-2"></i>Progres Pembangunan
                    </h5>
                    <a href="/proyek" class="btn btn-sm btn-outline-primary">Detail Proyek</a>
                </div>

                <% if (activeProject) { %>
                    <h6 class="fw-semibold text-secondary"><%= activeProject.title %></h6>
                    <div class="d-flex justify-content-between small text-muted mb-2">
                        <span>Target RAB: <strong><%= formatRupiah(activeProject.target_budget) %></strong></span>
                        <span class="badge bg-warning text-dark"><%= activeProject.status %></span>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="small fw-bold">Realisasi Fisik</span>
                            <span class="small fw-bold text-primary"><%= activeProject.current_percentage %>%</span>
                        </div>
                        <div class="progress" style="height: 12px; border-radius: 6px;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated bg-success" 
                                 role="progressbar" 
                                 style="width: <%= activeProject.current_percentage %>%;" 
                                 aria-valuenow="<%= activeProject.current_percentage %>" 
                                 aria-valuemin="0" 
                                 aria-valuemax="100">
                            </div>
                        </div>
                    </div>
                    <p class="text-muted small mb-0"><i class="bi bi-calendar-event me-1"></i> Target Selesai: <%= formatDate(activeProject.target_date) %></p>
                <% } else { %>
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-building fs-1 d-block mb-2 text-secondary opacity-50"></i>
                        Belum ada proyek pembangunan aktif.
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Log Aktivitas Terbaru -->
    <div class="col-lg-6">
        <div class="card card-custom h-100 p-3 shadow-sm border-0">
            <div class="card-body">
                <h5 class="fw-bold text-dark mb-3">
                    <i class="bi bi-clock-history text-secondary me-2"></i>Log Aktivitas Pengguna Terbaru
                </h5>
                <% if (summary.recentLogs && summary.recentLogs.length > 0) { %>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Waktu</th>
                                    <th>Pengguna</th>
                                    <th>Aksi</th>
                                    <th>Detail</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% summary.recentLogs.forEach(log => { %>
                                    <tr>
                                        <td class="small text-muted"><%= formatDate(log.created_at) %></td>
                                        <td class="fw-semibold text-truncate" style="max-width: 110px;"><%= log.user_name || 'Sistem' %></td>
                                        <td><span class="badge bg-secondary-subtle text-secondary border"><%= log.action %></span></td>
                                        <td class="small text-truncate" style="max-width: 160px;" title="<%= log.details %>"><%= log.details %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="text-center py-4 text-muted small">
                        Belum ada rekam aktivitas terbaru.
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>

<!-- Chart initialization & AJAX logic -->
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const initialData = <%- JSON.stringify(summary.initialChartData || { labels: [], income: [], expense: [] }) %>;
        
        const ctx = document.getElementById('transactionChart').getContext('2d');
        
        // Gradient fill for income
        const incomeGradient = ctx.createLinearGradient(0, 0, 0, 300);
        incomeGradient.addColorStop(0, 'rgba(16, 185, 129, 0.35)');
        incomeGradient.addColorStop(1, 'rgba(16, 185, 129, 0.0)');

        // Gradient fill for expense
        const expenseGradient = ctx.createLinearGradient(0, 0, 0, 300);
        expenseGradient.addColorStop(0, 'rgba(239, 68, 68, 0.35)');
        expenseGradient.addColorStop(1, 'rgba(239, 68, 68, 0.0)');

        window.simasjidChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: initialData.labels || [],
                datasets: [
                    {
                        label: 'Pemasukan',
                        data: initialData.income || [],
                        borderColor: '#10b981',
                        backgroundColor: incomeGradient,
                        borderWidth: 3,
                        fill: true,
                        tension: 0.35,
                        pointRadius: 4,
                        pointHoverRadius: 6
                    },
                    {
                        label: 'Pengeluaran',
                        data: initialData.expense || [],
                        borderColor: '#ef4444',
                        backgroundColor: expenseGradient,
                        borderWidth: 3,
                        fill: true,
                        tension: 0.35,
                        pointRadius: 4,
                        pointHoverRadius: 6
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'top',
                        labels: {
                            usePointStyle: true,
                            font: { size: 13, weight: 'bold' }
                        }
                    },
                    tooltip: {
                        backgroundColor: 'rgba(15, 23, 42, 0.9)',
                        padding: 12,
                        callbacks: {
                            label: function (context) {
                                let label = context.dataset.label || '';
                                if (label) {
                                    label += ': ';
                                }
                                if (context.parsed.y !== null) {
                                    label += new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(context.parsed.y);
                                }
                                return label;
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: { font: { size: 11 } }
                    },
                    y: {
                        beginAtZero: true,
                        grid: { color: '#f1f5f9' },
                        ticks: {
                            font: { size: 11 },
                            callback: function (value) {
                                if (value >= 1000000000) return 'Rp ' + (value / 1000000000).toFixed(1) + ' M';
                                if (value >= 1000000) return 'Rp ' + (value / 1000000).toFixed(0) + ' Jt';
                                if (value >= 1000) return 'Rp ' + (value / 1000).toFixed(0) + ' Rb';
                                return 'Rp ' + value;
                            }
                        }
                    }
                }
            }
        });
    });

    function updateChartPeriod(period, btn) {
        // Toggle active button style
        const btnGroup = document.getElementById('periodBtnGroup');
        const buttons = btnGroup.querySelectorAll('.btn-period');
        buttons.forEach(b => {
            b.classList.remove('btn-primary', 'active', 'shadow-sm');
            b.classList.add('btn-light', 'text-secondary');
        });
        btn.classList.remove('btn-light', 'text-secondary');
        btn.classList.add('btn-primary', 'active', 'shadow-sm');

        // Fetch new chart data via AJAX
        fetch(`/dashboard/chart-data?period=${period}`)
            .then(res => res.json())
            .then(data => {
                if (data.success && window.simasjidChart) {
                    window.simasjidChart.data.labels = data.labels;
                    window.simasjidChart.data.datasets[0].data = data.income;
                    window.simasjidChart.data.datasets[1].data = data.expense;
                    window.simasjidChart.update('active');
                }
            })
            .catch(err => console.error('Gagal memperbarui grafik:', err));
    }
</script>
