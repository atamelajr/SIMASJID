<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'SIMASJID - Portal Informasi Masjid' %></title>
    <link rel="icon" type="image/png" href="/logo.png">
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 CSS & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    
    <style>
        :root {
            --primary-emerald: #0d9488;
            --primary-dark: #0f766e;
            --secondary-amber: #f59e0b;
            --bg-light: #f8fafc;
            --text-dark: #0f172a;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--bg-light);
            color: var(--text-dark);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* Navbar Styling */
        .navbar-public {
            background: #ffffff;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
            padding: 14px 0;
            transition: all 0.3s ease;
        }

        .navbar-brand {
            font-weight: 800;
            color: var(--primary-dark) !important;
            font-size: 1.35rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .navbar-brand img {
            height: 42px;
            width: auto;
            border-radius: 8px;
        }

        .nav-public-link {
            font-weight: 600;
            color: #475569 !important;
            padding: 8px 16px !important;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .nav-public-link:hover, .nav-public-link.active {
            color: var(--primary-emerald) !important;
            background-color: #f0fdf4;
        }

        .btn-login-dkm {
            background-color: #1e293b;
            color: #ffffff !important;
            font-weight: 600;
            border-radius: 8px;
            padding: 8px 18px;
            transition: all 0.2s ease;
        }

        .btn-login-dkm:hover {
            background-color: #0f172a;
            transform: translateY(-1px);
        }

        /* Footer */
        footer {
            margin-top: auto;
            background-color: #0f172a;
            color: #94a3b8;
            padding: 50px 0 20px;
        }

        footer h5 {
            color: #ffffff;
            font-weight: 700;
            margin-bottom: 20px;
        }

        footer a {
            color: #cbd5e1;
            text-decoration: none;
            transition: color 0.2s ease;
        }

        footer a:hover {
            color: #38bdf8;
        }

        .footer-bottom {
            border-top: 1px solid #334155;
            margin-top: 40px;
            padding-top: 20px;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>

    <!-- Header Navbar -->
    <nav class="navbar navbar-expand-lg navbar-public sticky-top">
        <div class="container">
            <a class="navbar-brand" href="/">
                <img src="/logo.png" alt="Logo Masjid" onerror="this.style.display='none'">
                <span><%= masjidProfile.name || 'SIMASJID' %></span>
            </a>
            
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarPublicContent">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarPublicContent">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-1">
                    <li class="nav-item">
                        <a class="nav-link nav-public-link <%= typeof currentRoute !== 'undefined' && currentRoute === 'home' ? 'active' : '' %>" href="/">
                            <i class="bi bi-house-door me-1"></i> Beranda
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-public-link <%= typeof currentRoute !== 'undefined' && currentRoute === 'jadwal' ? 'active' : '' %>" href="/jadwal-sholat">
                            <i class="bi bi-clock-history me-1"></i> Jadwal Sholat
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-public-link <%= typeof currentRoute !== 'undefined' && currentRoute === 'transparansi' ? 'active' : '' %>" href="/transparansi">
                            <i class="bi bi-wallet2 me-1"></i> Transparansi Kas
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-public-link <%= typeof currentRoute !== 'undefined' && currentRoute === 'proyek' ? 'active' : '' %>" href="/proyek-donasi">
                            <i class="bi bi-building me-1"></i> Proyek Donasi
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-public-link text-warning fw-bold" href="/display-tv" target="_blank">
                            <i class="bi bi-tv me-1"></i> Mode TV Masjid <i class="bi bi-box-arrow-up-right small"></i>
                        </a>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-2">
                    <% if (user) { %>
                        <a href="/dashboard" class="btn btn-sm px-3 fw-semibold text-white" style="background-color: var(--primary-emerald);">
                            <i class="bi bi-speedometer2 me-1"></i> Back Office
                        </a>
                    <% } else { %>
                        <a href="/auth/login" class="btn btn-login-dkm btn-sm">
                            <i class="bi bi-person-lock me-1"></i> Login Pengurus
                        </a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Body Content -->
    <main class="flex-grow-1">
        <%- body %>
    </main>

    <!-- Footer -->
    <footer>
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-5 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <img src="/logo.png" alt="Logo" height="36" onerror="this.style.display='none'">
                        <h5 class="m-0"><%= masjidProfile.name || 'SIMASJID' %></h5>
                    </div>
                    <p class="text-secondary small leading-relaxed">
                        <%= masjidProfile.address || 'Alamat Masjid Belum Diatur.' %>
                    </p>
                    <div class="d-flex gap-3 text-secondary">
                        <% if (masjidProfile.phone) { %>
                            <span><i class="bi bi-telephone text-emerald me-1"></i> <%= masjidProfile.phone %></span>
                        <% } %>
                        <% if (masjidProfile.email) { %>
                            <span><i class="bi bi-envelope text-emerald me-1"></i> <%= masjidProfile.email %></span>
                        <% } %>
                    </div>
                </div>
                
                <div class="col-lg-3 col-md-6">
                    <h5>Navigasi Cepat</h5>
                    <ul class="list-unstyled d-flex flex-column gap-2 small">
                        <li><a href="/"><i class="bi bi-chevron-right me-1 small"></i> Beranda Utama</a></li>
                        <li><a href="/jadwal-sholat"><i class="bi bi-chevron-right me-1 small"></i> Waktu Sholat & Imsakiyah</a></li>
                        <li><a href="/transparansi"><i class="bi bi-chevron-right me-1 small"></i> Laporan Keuangan Transparan</a></li>
                        <li><a href="/proyek-donasi"><i class="bi bi-chevron-right me-1 small"></i> Penggalangan Donasi Masjid</a></li>
                    </ul>
                </div>

                <div class="col-lg-4 col-md-12">
                    <h5>Visi & Misi</h5>
                    <p class="small text-secondary">
                        <%= (masjidProfile.vision && masjidProfile.vision.substring(0, 150)) || 'Menjadi pusat peradaban dan pembinaan umat yang mandiri, makmur, dan berakhlak mulia.' %>...
                    </p>
                    <a href="/display-tv" target="_blank" class="btn btn-outline-light btn-sm rounded-pill px-3">
                        <i class="bi bi-tv me-1"></i> Buka Mode TV Digital Masjid
                    </a>
                </div>
            </div>

            <div class="footer-bottom d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                <div>
                    &copy; <%= new Date().getFullYear() %> <strong><%= masjidProfile.name || 'SIMASJID' %></strong>. Hak Cipta Dilindungi.
                </div>
                <div class="text-secondary small">
                    Powered by SIMASJID System
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
