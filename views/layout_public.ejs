<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : (masjidProfile.name || 'SIMASJID') + (masjidProfile.tagline ? ' - ' + masjidProfile.tagline : ' - Portal Informasi Masjid') %></title>
    <% if (masjidProfile.meta_description) { %>
        <meta name="description" content="<%= masjidProfile.meta_description %>">
    <% } %>
    <% if (masjidProfile.meta_keywords) { %>
        <meta name="keywords" content="<%= masjidProfile.meta_keywords %>">
    <% } %>
    <link rel="icon" type="image/png" href="<%= masjidProfile.favicon || '/logo.png' %>">
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 CSS & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    
    <style>
        :root {
            --primary-emerald: #0d9488;
            --primary-dark: #0f766e;
            --secondary-amber: #f59e0b;
            --bg-light: #f8fafc;
            --text-dark: #0f172a;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--bg-light);
            color: var(--text-dark);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* Top Bar Socials & Contact */
        .top-bar-public {
            background-color: #0f172a;
            color: #94a3b8;
            font-size: 0.85rem;
            padding: 6px 0;
        }

        .top-bar-public a {
            color: #cbd5e1;
            text-decoration: none;
            transition: color 0.2s ease;
        }
        .top-bar-public a:hover {
            color: #38bdf8;
        }

        /* Navbar Styling */
        .navbar-public {
            background: #ffffff;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
            padding: 12px 0;
            transition: all 0.3s ease;
        }

        .navbar-brand {
            font-weight: 800;
            color: var(--primary-dark) !important;
            font-size: 1.35rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .navbar-brand img {
            height: 44px;
            width: auto;
            border-radius: 8px;
            object-fit: contain;
        }

        .nav-public-link {
            font-weight: 600;
            color: #475569 !important;
            padding: 8px 14px !important;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .nav-public-link:hover, .nav-public-link.active {
            color: var(--primary-emerald) !important;
            background-color: #f0fdf4;
        }

        .btn-login-dkm {
            background-color: #1e293b;
            color: #ffffff !important;
            font-weight: 600;
            border-radius: 8px;
            padding: 8px 18px;
            transition: all 0.2s ease;
        }

        .btn-login-dkm:hover {
            background-color: #0f172a;
            transform: translateY(-1px);
        }

        /* Running Text Bar */
        .running-text-bar {
            background-color: #0f766e;
            color: #ffffff;
            padding: 6px 0;
            font-weight: 600;
            font-size: 0.9rem;
        }

        /* Footer */
        footer {
            margin-top: auto;
            background-color: #0f172a;
            color: #94a3b8;
            padding: 50px 0 20px;
        }

        footer h5 {
            color: #ffffff;
            font-weight: 700;
            margin-bottom: 20px;
        }

        footer a {
            color: #cbd5e1;
            text-decoration: none;
            transition: color 0.2s ease;
        }

        footer a:hover {
            color: #38bdf8;
        }

        .footer-bottom {
            border-top: 1px solid #334155;
            margin-top: 40px;
            padding-top: 20px;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>

    <!-- Top Bar Kontak & Sosial Media -->
    <div class="top-bar-public">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
                <% if (masjidProfile.phone) { %>
                    <span><i class="bi bi-telephone me-1 text-teal" style="color: #14b8a6;"></i> <%= masjidProfile.phone %></span>
                <% } %>
                <% if (masjidProfile.email) { %>
                    <span class="d-none d-md-inline"><i class="bi bi-envelope me-1 text-teal" style="color: #14b8a6;"></i> <%= masjidProfile.email %></span>
                <% } %>
            </div>

            <div class="d-flex align-items-center gap-3">
                <% if (masjidProfile.social_whatsapp) { %>
                    <a href="https://wa.me/<%= masjidProfile.social_whatsapp %>" target="_blank" title="WhatsApp Center"><i class="bi bi-whatsapp text-success fs-6"></i></a>
                <% } %>
                <% if (masjidProfile.social_instagram) { %>
                    <a href="<%= masjidProfile.social_instagram %>" target="_blank" title="Instagram"><i class="bi bi-instagram text-danger fs-6"></i></a>
                <% } %>
                <% if (masjidProfile.social_facebook) { %>
                    <a href="<%= masjidProfile.social_facebook %>" target="_blank" title="Facebook"><i class="bi bi-facebook text-primary fs-6"></i></a>
                <% } %>
                <% if (masjidProfile.social_youtube) { %>
                    <a href="<%= masjidProfile.social_youtube %>" target="_blank" title="YouTube"><i class="bi bi-youtube text-danger fs-6"></i></a>
                <% } %>
                <% if (masjidProfile.social_tiktok) { %>
                    <a href="<%= masjidProfile.social_tiktok %>" target="_blank" title="TikTok"><i class="bi bi-tiktok text-light fs-6"></i></a>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Header Navbar Navigasi Dinamis -->
    <nav class="navbar navbar-expand-lg navbar-public sticky-top">
        <div class="container">
            <a class="navbar-brand" href="/">
                <img src="<%= masjidProfile.logo || '/logo.png' %>" alt="Logo Masjid" onerror="this.src='/logo.png'">
                <div>
                    <span><%= masjidProfile.name || 'SIMASJID' %></span>
                    <% if (masjidProfile.tagline) { %>
                        <small class="d-block text-muted fw-normal" style="font-size: 0.72rem; margin-top: -3px;"><%= masjidProfile.tagline %></small>
                    <% } %>
                </div>
            </a>
            
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarPublicContent">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarPublicContent">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-1">
                    <% if (typeof webMenus !== 'undefined' && webMenus && webMenus.length > 0) { %>
                        <% webMenus.forEach(m => { %>
                            <li class="nav-item">
                                <a class="nav-link nav-public-link <%= (typeof currentRoute !== 'undefined' && currentRoute === m.url) ? 'active' : '' %>" href="<%= m.url %>" target="<%= m.target || '_self' %>">
                                    <%= m.title %>
                                </a>
                            </li>
                        <% }); %>
                    <% } else { %>
                        <li class="nav-item"><a class="nav-link nav-public-link active" href="/">Beranda</a></li>
                        <li class="nav-item"><a class="nav-link nav-public-link" href="/jadwal-sholat">Jadwal Sholat</a></li>
                        <li class="nav-item"><a class="nav-link nav-public-link" href="/transparansi">Transparansi Kas</a></li>
                        <li class="nav-item"><a class="nav-link nav-public-link" href="/proyek-donasi">Proyek Donasi</a></li>
                        <li class="nav-item"><a class="nav-link nav-public-link" href="/berita">Berita & Artikel</a></li>
                        <li class="nav-item"><a class="nav-link nav-public-link" href="/galeri">Galeri Foto</a></li>
                    <% } %>
                </ul>

                <div class="d-flex align-items-center gap-2">
                    <% if (user) { %>
                        <a href="/dashboard" class="btn btn-sm px-3 fw-semibold text-white" style="background-color: var(--primary-emerald);">
                            <i class="bi bi-speedometer2 me-1"></i> Back Office
                        </a>
                    <% } else { %>
                        <a href="/auth/login" class="btn btn-login-dkm btn-sm">
                            <i class="bi bi-person-lock me-1"></i> Login Pengurus
                        </a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>

    <!-- Running Text Pengumuman jika ada -->
    <% if (masjidProfile.running_text) { %>
        <div class="running-text-bar">
            <div class="container d-flex align-items-center">
                <span class="badge bg-warning text-dark me-2 px-2 py-1 small fw-bold">INFO</span>
                <marquee behavior="scroll" direction="left" scrollamount="6" class="m-0">
                    <%= masjidProfile.running_text %>
                </marquee>
            </div>
        </div>
    <% } %>

    <!-- Main Body Content -->
    <main class="flex-grow-1">
        <%- body %>
    </main>

    <!-- Footer -->
    <footer>
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-5 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <img src="<%= masjidProfile.logo || '/logo.png' %>" alt="Logo" height="40" onerror="this.src='/logo.png'">
                        <h5 class="m-0"><%= masjidProfile.name || 'SIMASJID' %></h5>
                    </div>
                    <p class="text-secondary small leading-relaxed">
                        <%= masjidProfile.address || 'Alamat Masjid Belum Diatur.' %>
                    </p>
                    <div class="d-flex gap-3 text-secondary small">
                        <% if (masjidProfile.phone) { %>
                            <span><i class="bi bi-telephone text-emerald me-1"></i> <%= masjidProfile.phone %></span>
                        <% } %>
                        <% if (masjidProfile.email) { %>
                            <span><i class="bi bi-envelope text-emerald me-1"></i> <%= masjidProfile.email %></span>
                        <% } %>
                    </div>
                </div>
                
                <div class="col-lg-3 col-md-6">
                    <h5>Navigasi Publik</h5>
                    <ul class="list-unstyled d-flex flex-column gap-2 small">
                        <li><a href="/"><i class="bi bi-chevron-right me-1 small"></i> Beranda Utama</a></li>
                        <li><a href="/jadwal-sholat"><i class="bi bi-chevron-right me-1 small"></i> Waktu Sholat & Imsakiyah</a></li>
                        <li><a href="/transparansi"><i class="bi bi-chevron-right me-1 small"></i> Transparansi Kas Masjid</a></li>
                        <li><a href="/berita"><i class="bi bi-chevron-right me-1 small"></i> Berita & Artikel Dakwah</a></li>
                        <li><a href="/galeri"><i class="bi bi-chevron-right me-1 small"></i> Galeri Dokumentasi Foto</a></li>
                    </ul>
                </div>

                <div class="col-lg-4 col-md-12">
                    <h5>Visi & Misi</h5>
                    <p class="small text-secondary mb-3">
                        <%= (masjidProfile.vision && masjidProfile.vision.substring(0, 150)) || 'Menjadi pusat peradaban dan pembinaan umat yang mandiri, makmur, dan berakhlak mulia.' %>...
                    </p>
                    <a href="/display-tv" target="_blank" class="btn btn-outline-light btn-sm rounded-pill px-3">
                        <i class="bi bi-tv me-1"></i> Buka Mode TV Digital Masjid
                    </a>
                </div>
            </div>

            <div class="footer-bottom d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                <div>
                    &copy; <%= new Date().getFullYear() %> <strong><%= masjidProfile.name || 'SIMASJID' %></strong>. <%= masjidProfile.footer_copyright || 'Hak Cipta Dilindungi.' %>
                </div>
                <div class="text-secondary small">
                    Powered by SIMASJID CMS System
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
