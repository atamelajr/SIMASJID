<div class="container-fluid px-0">
    <!-- Header Page -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a href="/dashboard" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Log Aktivitas</li>
                </ol>
            </nav>
            <h4 class="fw-bold text-dark mb-1">
                <i class="bi bi-clock-history text-primary me-2"></i>Log Aktivitas Pengguna (Audit Trail)
            </h4>
            <p class="text-muted small mb-0">Riwayat lengkap seluruh transaksi, pembaruan data, dan tindakan administratif oleh pengguna sistem.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/dashboard" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1 shadow-xs">
                <i class="bi bi-arrow-left"></i>
                <span>Kembali ke Dashboard</span>
            </a>
            <a href="/activity-logs" class="btn btn-light border btn-sm d-flex align-items-center gap-1 shadow-xs" title="Muat ulang data">
                <i class="bi bi-arrow-clockwise"></i>
                <span>Refresh</span>
            </a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card card-custom border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form action="/activity-logs" method="GET" class="row g-2 align-items-end">
                <div class="col-6 col-md-2">
                    <label class="form-label extra-small fw-bold text-muted mb-1"><i class="bi bi-calendar-event me-1"></i>Tanggal Dari</label>
                    <input type="date" name="start_date" class="form-control form-control-sm" value="<%= filters.start_date || '' %>">
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label extra-small fw-bold text-muted mb-1"><i class="bi bi-calendar-check me-1"></i>Tanggal Sampai</label>
                    <input type="date" name="end_date" class="form-control form-control-sm" value="<%= filters.end_date || '' %>">
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label extra-small fw-bold text-muted mb-1"><i class="bi bi-person me-1"></i>Pengguna</label>
                    <select name="user_id" class="form-select form-select-sm">
                        <option value="">-- Semua Pengguna --</option>
                        <% if (typeof logUsers !== 'undefined' && logUsers.length > 0) { %>
                            <% logUsers.forEach(u => { %>
                                <option value="<%= u.id %>" <%= filters.user_id == u.id ? 'selected' : '' %>>
                                    <%= u.username %> <%= u.full_name ? `(${u.full_name})` : '' %>
                                </option>
                            <% }) %>
                        <% } %>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label extra-small fw-bold text-muted mb-1"><i class="bi bi-tag me-1"></i>Jenis Tindakan / Aksi</label>
                    <select name="action" class="form-select form-select-sm">
                        <option value="">-- Semua Aksi --</option>
                        <% if (typeof actions !== 'undefined' && actions.length > 0) { %>
                            <% actions.forEach(act => { 
                                const meta = typeof getActionMeta === 'function' ? getActionMeta(act) : { label: act };
                            %>
                                <option value="<%= act %>" <%= filters.action === act ? 'selected' : '' %>>
                                    <%= meta.label %> (<%= act %>)
                                </option>
                            <% }) %>
                        <% } %>
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label extra-small fw-bold text-muted mb-1"><i class="bi bi-search me-1"></i>Cari Keterangan / Detail</label>
                    <input type="text" name="search" class="form-control form-control-sm" placeholder="Cari kode TRX, kata kunci..." value="<%= filters.search || '' %>">
                </div>
                <div class="col-12 col-md-1 d-flex gap-1">
                    <button type="submit" class="btn btn-sm btn-primary flex-fill" title="Terapkan Filter">
                        <i class="bi bi-filter"></i>
                    </button>
                    <a href="/activity-logs" class="btn btn-sm btn-light border" title="Reset Filter">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card card-custom border-0 shadow-sm">
        <div class="card-body p-0">
            <!-- Table Info Bar -->
            <div class="d-flex flex-wrap justify-content-between align-items-center p-3 border-bottom bg-light bg-opacity-50 gap-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary px-2 py-1"><i class="bi bi-database me-1"></i><%= pagination.total.toLocaleString('id-ID') %> Data</span>
                    <span class="small text-muted">
                        Menampilkan halaman <strong><%= pagination.page %></strong> dari <strong><%= pagination.totalPages %></strong>
                    </span>
                </div>
                <form action="/activity-logs" method="GET" class="d-flex align-items-center gap-2">
                    <% if (filters.start_date) { %><input type="hidden" name="start_date" value="<%= filters.start_date %>"><% } %>
                    <% if (filters.end_date) { %><input type="hidden" name="end_date" value="<%= filters.end_date %>"><% } %>
                    <% if (filters.user_id) { %><input type="hidden" name="user_id" value="<%= filters.user_id %>"><% } %>
                    <% if (filters.action) { %><input type="hidden" name="action" value="<%= filters.action %>"><% } %>
                    <% if (filters.search) { %><input type="hidden" name="search" value="<%= filters.search %>"><% } %>
                    
                    <label class="extra-small text-muted text-nowrap fw-semibold mb-0">Tampilkan:</label>
                    <select name="limit" class="form-select form-select-sm" style="width: auto;" onchange="this.form.submit()">
                        <option value="10" <%= pagination.limit === '10' ? 'selected' : '' %>>10</option>
                        <option value="20" <%= pagination.limit === '20' || !['10','50','100','all'].includes(pagination.limit) ? 'selected' : '' %>>20</option>
                        <option value="50" <%= pagination.limit === '50' ? 'selected' : '' %>>50</option>
                        <option value="100" <%= pagination.limit === '100' ? 'selected' : '' %>>100</option>
                        <option value="all" <%= pagination.limit === 'all' ? 'selected' : '' %>>Semua</option>
                    </select>
                </form>
            </div>

            <!-- Table Responsive -->
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center" style="width: 50px;">No</th>
                            <th style="min-width: 170px;">Waktu & Tanggal</th>
                            <th style="min-width: 140px;">Pengguna</th>
                            <th style="min-width: 150px;">Jenis Aksi</th>
                            <th>Rincian / Detail Aktivitas</th>
                            <th class="text-center" style="width: 80px;">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (logs && logs.length > 0) { %>
                            <% 
                                const limitNum = pagination.limit === 'all' ? pagination.total : parseInt(pagination.limit, 10);
                                const startIndex = (pagination.page - 1) * limitNum;
                            %>
                            <% logs.forEach((log, idx) => { 
                                const meta = typeof getActionMeta === 'function' ? getActionMeta(log.action) : { label: log.action, badgeClass: 'bg-secondary-subtle text-secondary border', icon: 'bi-activity' };
                            %>
                                <tr>
                                    <td class="text-center text-muted small"><%= startIndex + idx + 1 %></td>
                                    <td>
                                        <div class="fw-semibold text-dark small">
                                            <%= typeof formatDateTime !== 'undefined' ? formatDateTime(log.created_at) : log.created_at %>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-column">
                                            <span class="fw-bold text-primary small"><%= log.username || log.user_name || 'Sistem' %></span>
                                            <% if (log.role_name) { %>
                                                <span class="badge bg-light text-muted border extra-small mt-1 text-truncate" style="max-width: 110px;">
                                                    <%= log.role_name %>
                                                </span>
                                            <% } %>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge <%= meta.badgeClass %> px-2 py-1">
                                            <i class="bi <%= meta.icon %> me-1"></i><%= meta.label %>
                                        </span>
                                    </td>
                                    <td>
                                        <div class="small text-dark text-break" style="max-width: 500px; line-height: 1.5;">
                                            <%= log.details || '-' %>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1 py-1 px-2 btn-detail-log" 
                                            title="Lihat Detail Lengkap"
                                            data-waktu="<%= typeof formatDateTime !== 'undefined' ? formatDateTime(log.created_at) : log.created_at %>"
                                            data-username="<%= log.username || log.user_name || 'Sistem' %>"
                                            data-fullname="<%= log.user_name || '-' %>"
                                            data-role="<%= log.role_name || '-' %>"
                                            data-action="<%= log.action %>"
                                            data-details="<%= (log.details || '').replace(/"/g, '&quot;') %>">
                                            <i class="bi bi-eye"></i>
                                            <span class="extra-small">Detail</span>
                                        </button>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                    Tidak ada data log aktivitas yang sesuai dengan kriteria filter.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <!-- Pagination Bar -->
            <% if (pagination.totalPages > 1 && pagination.limit !== 'all') { 
                const queryParams = new URLSearchParams();
                if (filters.start_date) queryParams.set('start_date', filters.start_date);
                if (filters.end_date) queryParams.set('end_date', filters.end_date);
                if (filters.user_id) queryParams.set('user_id', filters.user_id);
                if (filters.action) queryParams.set('action', filters.action);
                if (filters.search) queryParams.set('search', filters.search);
                queryParams.set('limit', pagination.limit);
            %>
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-center p-3 border-top gap-2">
                    <div class="small text-muted">
                        Menampilkan halaman <strong><%= pagination.page %></strong> dari total <strong><%= pagination.totalPages %></strong> halaman
                    </div>
                    <nav aria-label="Navigasi Halaman Log">
                        <ul class="pagination pagination-sm mb-0 flex-wrap justify-content-center">
                            <!-- Prev -->
                            <% if (pagination.page > 1) { 
                                queryParams.set('page', pagination.page - 1);
                            %>
                                <li class="page-item">
                                    <a class="page-link" href="/activity-logs?<%= queryParams.toString() %>">&laquo; Sebelumnya</a>
                                </li>
                            <% } else { %>
                                <li class="page-item disabled"><span class="page-link">&laquo; Sebelumnya</span></li>
                            <% } %>

                            <!-- Windowing Page Numbers -->
                            <% 
                                const totalP = pagination.totalPages;
                                const currentP = pagination.page;
                                const windowSize = 2;
                                let pagesToShow = [];

                                for (let p = 1; p <= totalP; p++) {
                                    if (p === 1 || p === totalP || (p >= currentP - windowSize && p <= currentP + windowSize)) {
                                        pagesToShow.push(p);
                                    }
                                }

                                let lastShown = 0;
                                pagesToShow.forEach(p => {
                                    if (lastShown > 0 && p - lastShown > 1) {
                            %>
                                        <li class="page-item disabled"><span class="page-link px-2">...</span></li>
                            <%      }
                                    queryParams.set('page', p);
                            %>
                                    <li class="page-item <%= p === currentP ? 'active' : '' %>">
                                        <a class="page-link" href="/activity-logs?<%= queryParams.toString() %>"><%= p %></a>
                                    </li>
                            <%      lastShown = p;
                                });
                            %>

                            <!-- Next -->
                            <% if (pagination.page < pagination.totalPages) { 
                                queryParams.set('page', pagination.page + 1);
                            %>
                                <li class="page-item">
                                    <a class="page-link" href="/activity-logs?<%= queryParams.toString() %>">Selanjutnya &raquo;</a>
                                </li>
                            <% } else { %>
                                <li class="page-item disabled"><span class="page-link">Selanjutnya &raquo;</span></li>
                            <% } %>
                        </ul>
                    </nav>
                </div>
            <% } %>
        </div>
    </div>
</div>

<%- include('../partials/modal_log_detail') %>
