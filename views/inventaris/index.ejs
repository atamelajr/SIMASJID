<script>
    const rawAssetCatalog = <%- JSON.stringify(typeof assetCatalog !== 'undefined' ? assetCatalog : []) %>;

    function filterAddAssetItemsByCategory() {
        const catSelect = document.getElementById('add_asset_category');
        const nameSelect = document.getElementById('add_asset_name');
        const customWrapper = document.getElementById('wrapper_custom_add_asset_name');
        if (!catSelect || !nameSelect) return;

        const selectedCat = catSelect.value;
        if (customWrapper) customWrapper.classList.add('d-none');

        if (!selectedCat) {
            nameSelect.innerHTML = '<option value="">-- Pilih Kategori Terlebih Dahulu --</option>';
            return;
        }

        const filteredItems = rawAssetCatalog.filter(item => item.category === selectedCat);

        nameSelect.innerHTML = '';
        const defaultOpt = document.createElement('option');
        defaultOpt.value = '';
        defaultOpt.text = filteredItems.length > 0 ? '-- Pilih Nama Barang Aset --' : '-- Belum Ada Barang di Kategori Ini --';
        nameSelect.appendChild(defaultOpt);

        filteredItems.forEach(item => {
            const opt = document.createElement('option');
            opt.value = item.name;
            opt.text = `${item.code} - ${item.name}`;
            nameSelect.appendChild(opt);
        });

        const customOpt = document.createElement('option');
        customOpt.value = '__NEW__';
        customOpt.text = '➕ Ketik Nama Barang Baru...';
        nameSelect.appendChild(customOpt);

        if (filteredItems.length === 1) {
            nameSelect.selectedIndex = 1;
        }
    }

    function onAddAssetNameChange() {
        const nameSelect = document.getElementById('add_asset_name');
        const customWrapper = document.getElementById('wrapper_custom_add_asset_name');
        const customInput = document.getElementById('custom_add_asset_name');

        if (nameSelect && nameSelect.value === '__NEW__') {
            if (customWrapper) customWrapper.classList.remove('d-none');
            if (customInput) {
                customInput.required = true;
                customInput.focus();
            }
        } else {
            if (customWrapper) customWrapper.classList.add('d-none');
            if (customInput) {
                customInput.required = false;
                customInput.value = '';
            }
        }
    }

    function onAddAssetSubmit(e) {
        const nameSelect = document.getElementById('add_asset_name');
        const customInput = document.getElementById('custom_add_asset_name');
        if (nameSelect && nameSelect.value === '__NEW__') {
            nameSelect.removeAttribute('name');
            customInput.name = 'name';
        }
    }

    function filterEditAssetItemsByCategory(targetName = null) {
        const catSelect = document.getElementById('edit_asset_category');
        const nameSelect = document.getElementById('edit_asset_name');
        const customWrapper = document.getElementById('wrapper_custom_edit_asset_name');
        if (!catSelect || !nameSelect) return;

        const selectedCat = catSelect.value;
        const currentVal = targetName !== null ? targetName : nameSelect.value;

        if (customWrapper) customWrapper.classList.add('d-none');

        if (!selectedCat) {
            nameSelect.innerHTML = '<option value="">-- Pilih Kategori Terlebih Dahulu --</option>';
            return;
        }

        const filteredItems = rawAssetCatalog.filter(item => item.category === selectedCat);

        nameSelect.innerHTML = '';
        const defaultOpt = document.createElement('option');
        defaultOpt.value = '';
        defaultOpt.text = filteredItems.length > 0 ? '-- Pilih Nama Barang Aset --' : '-- Belum Ada Barang di Kategori Ini --';
        nameSelect.appendChild(defaultOpt);

        let found = false;
        filteredItems.forEach(item => {
            const opt = document.createElement('option');
            opt.value = item.name;
            opt.text = `${item.code} - ${item.name}`;
            if (item.name === currentVal) {
                opt.selected = true;
                found = true;
            }
            nameSelect.appendChild(opt);
        });

        const customOpt = document.createElement('option');
        customOpt.value = '__NEW__';
        customOpt.text = '➕ Ketik Nama Barang Baru...';
        nameSelect.appendChild(customOpt);

        if (!found && currentVal && currentVal !== '__NEW__') {
            const extraOpt = document.createElement('option');
            extraOpt.value = currentVal;
            extraOpt.text = currentVal;
            extraOpt.selected = true;
            nameSelect.appendChild(extraOpt);
        }
    }

    function onEditAssetNameChange() {
        const nameSelect = document.getElementById('edit_asset_name');
        const customWrapper = document.getElementById('wrapper_custom_edit_asset_name');
        const customInput = document.getElementById('custom_edit_asset_name');

        if (nameSelect && nameSelect.value === '__NEW__') {
            if (customWrapper) customWrapper.classList.remove('d-none');
            if (customInput) {
                customInput.required = true;
                customInput.focus();
            }
        } else {
            if (customWrapper) customWrapper.classList.add('d-none');
            if (customInput) {
                customInput.required = false;
                customInput.value = '';
            }
        }
    }

    function onEditAssetSubmit(e) {
        const nameSelect = document.getElementById('edit_asset_name');
        const customInput = document.getElementById('custom_edit_asset_name');
        if (nameSelect && nameSelect.value === '__NEW__') {
            nameSelect.removeAttribute('name');
            customInput.name = 'name';
        }
    }

    function openEditAssetModal(ast) {
        document.getElementById('formEditAsset').action = '/inventaris/asset/update/' + ast.id;
        
        document.getElementById('edit_asset_category').value = ast.category || 'Peralatan & Mesin';
        filterEditAssetItemsByCategory(ast.name);

        document.getElementById('edit_asset_brand').value = ast.brand || '';
        document.getElementById('edit_asset_model_no_plate').value = ast.model_no_plate || '';
        if (document.getElementById('edit_asset_source_origin')) {
            document.getElementById('edit_asset_source_origin').value = ast.source_origin || 'Pembelian';
        }
        if (document.getElementById('edit_asset_location')) {
            document.getElementById('edit_asset_location').value = ast.location || '';
        }
        document.getElementById('edit_asset_purchase_date').value = ast.purchase_date ? ast.purchase_date.split('T')[0] : '';
        document.getElementById('edit_asset_cost').value = ast.cost || 0;
        document.getElementById('edit_asset_condition_status').value = ast.condition_status || 'Baik';
        document.getElementById('edit_asset_description').value = ast.description || '';

        const modal = new bootstrap.Modal(document.getElementById('modalEditAsset'));
        modal.show();
    }

    document.addEventListener('DOMContentLoaded', function() {
        const addModalEl = document.getElementById('modalAddAsset');
        if (addModalEl) {
            addModalEl.addEventListener('show.bs.modal', function () {
                const catSelect = document.getElementById('add_asset_category');
                if (catSelect) {
                    if (!catSelect.value) {
                        catSelect.value = 'Peralatan & Mesin';
                    }
                    filterAddAssetItemsByCategory();
                }
            });
        }

        const tabEls = document.querySelectorAll('#inventarisTab button[data-bs-toggle="tab"]');
        tabEls.forEach(tabEl => {
            tabEl.addEventListener('shown.bs.tab', function(e) {
                const targetId = e.target.getAttribute('data-bs-target');
                let tabParam = 'aset';
                if (targetId === '#persediaan') tabParam = 'persediaan';
                if (targetId === '#logs') tabParam = 'logs';
                
                const url = new URL(window.location);
                url.searchParams.set('tab', tabParam);
                window.history.replaceState(null, '', url.toString());
            });
        });
    });
</script>
