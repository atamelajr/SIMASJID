<div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-2">
    <div>
        <h4 class="fw-bold text-dark mb-1"><i class="bi bi-box-seam text-primary me-2"></i>Manajemen Aset & Inventaris Masjid</h4>
        <p class="text-muted small mb-0">Pengelolaan Aset Tetap (Modal) dan Stok Persediaan (Material & Operasional Harian).</p>
    </div>
    <div class="d-flex gap-2">
        <% if (user && (user.role_name === 'Admin' || user.role_name === 'Operator')) { %>
            <button class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#modalAddAsset">
                <i class="bi bi-plus-lg me-1"></i> Tambah Aset Tetap Baru
            </button>
            <button class="btn btn-warning shadow-sm" data-bs-toggle="modal" data-bs-target="#modalUsage">
                <i class="bi bi-box-arrow-right me-1"></i> Catat Pemakaian Persediaan
            </button>
        <% } %>
    </div>
</div>

<!-- Tabs Navigation -->
<ul class="nav nav-tabs mb-4" id="inventarisTab" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link <%= activeTab === 'aset' ? 'active' : '' %> fw-semibold" id="aset-tab" data-bs-toggle="tab" data-bs-target="#aset" type="button" role="tab">
            <i class="bi bi-box-seam me-1"></i> Aset Tetap (Modal) (<%= assetPagination.totalCount %>)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link <%= activeTab === 'persediaan' ? 'active' : '' %> fw-semibold" id="persediaan-tab" data-bs-toggle="tab" data-bs-target="#persediaan" type="button" role="tab">
            <i class="bi bi-boxes me-1"></i> Persediaan & Material (<%= inventoryPagination.totalCount %>)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link <%= activeTab === 'logs' ? 'active' : '' %> fw-semibold" id="logs-tab" data-bs-toggle="tab" data-bs-target="#logs" type="button" role="tab">
            <i class="bi bi-clock-history me-1"></i> Log Masuk / Keluar (<%= logPagination.totalCount %>)
        </button>
    </li>
</ul>

<div class="tab-content" id="inventarisTabContent">
    <!-- Tab 1: Aset Tetap -->
    <div class="tab-pane fade <%= activeTab === 'aset' ? 'show active' : '' %>" id="aset" role="tabpanel">
        <!-- Filter Card Aset Tetap -->
        <div class="card card-custom mb-3 p-3 bg-light-subtle">
            <form method="GET" action="/inventaris" class="row g-2 align-items-center">
                <input type="hidden" name="tab" value="aset">
                <div class="col-md-3">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" name="asset_search" class="form-control" placeholder="Cari Nama / Kode / Merk / Model..." value="<%= assetFilters.search || '' %>">
                    </div>
                </div>
                <div class="col-md-3">
                    <select name="asset_category" class="form-select form-select-sm">
                        <option value="">-- Semua Kategori --</option>
                        <% if (typeof assetCategories !== 'undefined' && assetCategories.length > 0) { %>
                            <% assetCategories.forEach(cat => { %>
                                <option value="<%= cat.name %>" <%= assetFilters.category === cat.name ? 'selected' : '' %>><%= cat.name %></option>
                            <% }) %>
                        <% } %>
                    </select>
                </div>
                <div class="col-md-2">
                    <select name="asset_condition" class="form-select form-select-sm">
                        <option value="">-- Semua Kondisi --</option>
                        <option value="Baik" <%= assetFilters.condition === 'Baik' ? 'selected' : '' %>>Baik</option>
                        <option value="Rusak Ringan" <%= assetFilters.condition === 'Rusak Ringan' ? 'selected' : '' %>>Rusak Ringan</option>
                        <option value="Rusak Berat" <%= assetFilters.condition === 'Rusak Berat' ? 'selected' : '' %>>Rusak Berat</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <select name="asset_location" class="form-select form-select-sm">
                        <option value="">-- Semua Lokasi --</option>
                        <% if (typeof locations !== 'undefined' && locations.length > 0) { %>
                            <% locations.forEach(loc => { %>
                                <option value="<%= loc.name %>" <%= assetFilters.location === loc.name ? 'selected' : '' %>><%= loc.name %></option>
                            <% }) %>
                        <% } %>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-1">
                    <button type="submit" class="btn btn-sm btn-primary flex-fill"><i class="bi bi-funnel me-1"></i>Filter</button>
                    <a href="/inventaris?tab=aset" class="btn btn-sm btn-outline-secondary" title="Reset Filter"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>
        </div>

        <div class="card card-custom p-3">
            <div class="card-body">
                <h5 class="fw-bold text-dark mb-3">Daftar Barang Aset Tetap Masjid</h5>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Kode Aset</th>
                                <th>Nama & Detail Barang Aset</th>
                                <th>Nilai / Perolehan</th>
                                <th>Status Kondisi</th>
                                <th>Lokasi Simpan</th>
                                <th>Ref. Transaksi</th>
                                <th class="text-end">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (assets.length > 0) { %>
                                <% assets.forEach(ast => { %>
                                    <tr>
                                        <td class="fw-bold text-primary font-monospace" style="width: 150px;"><%= ast.asset_code %></td>
                                        <td>
                                            <div class="fw-bold text-dark mb-1">
                                                <%= ast.name %>
                                                <span class="badge bg-secondary-subtle text-dark border ms-1"><%= ast.category || 'Peralatan & Mesin' %></span>
                                                <span class="badge bg-info-subtle text-info border ms-1"><%= ast.source_origin || 'Pembelian' %></span>
                                            </div>
                                            <% if (ast.brand || ast.model_no_plate) { %>
                                                <div class="small text-secondary mt-1">
                                                    <% if (ast.brand) { %>
                                                        <span class="badge bg-light text-dark border me-1"><i class="bi bi-tag-fill text-muted me-1"></i>Merk: <%= ast.brand %></span>
                                                    <% } %>
                                                    <% if (ast.model_no_plate) { %>
                                                        <span class="badge bg-info-subtle text-info border"><i class="bi bi-card-text me-1"></i>Model/No.Polisi: <%= ast.model_no_plate %></span>
                                                    <% } %>
                                                </div>
                                            <% } %>
                                            <% if (ast.description) { %>
                                                <div class="extra-small text-muted mt-1"><i class="bi bi-info-circle me-1"></i><%= ast.description %></div>
                                            <% } %>
                                        </td>
                                        <td class="font-monospace fw-bold text-success"><%= formatRupiah(ast.cost) %></td>
                                        <td>
                                            <!-- Static Condition Badge -->
                                            <% if (ast.condition_status === 'Baik') { %>
                                                <span class="badge bg-success px-3 py-2"><i class="bi bi-check-circle me-1"></i>Baik</span>
                                            <% } else if (ast.condition_status === 'Rusak Ringan') { %>
                                                <span class="badge bg-warning text-dark px-3 py-2"><i class="bi bi-exclamation-triangle me-1"></i>Rusak Ringan</span>
                                            <% } else { %>
                                                <span class="badge bg-danger px-3 py-2"><i class="bi bi-x-circle me-1"></i>Rusak Berat</span>
                                            <% } %>
                                        </td>
                                        <td><i class="bi bi-geo-alt text-muted me-1"></i><%= ast.location || 'Masjid' %></td>
                                        <td class="small text-muted font-monospace"><%= ast.transaction_code || 'Input Manual' %></td>
                                        <td class="text-end text-nowrap">
                                            <% if (user && (user.role_name === 'Admin' || user.role_name === 'Operator')) { %>
                                                <button type="button" class="btn btn-sm btn-outline-warning me-1" onclick='openEditAssetModal(<%- JSON.stringify(ast) %>)' title="Edit Detail & Spesifikasi Aset">
                                                    <i class="bi bi-pencil me-1"></i> Edit Detail
                                                </button>
                                                <% if (user.role_name === 'Admin') { %>
                                                    <form action="/inventaris/asset/delete/<%= ast.id %>" method="POST" class="d-inline" onsubmit="return confirm('Apakah Anda yakin ingin menghapus aset ini?')">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Hapus Aset">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                <% } %>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">Belum ada barang aset tetap terdaftar.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Bar for Aset Tetap -->
                <div class="d-flex flex-wrap align-items-center justify-content-between pt-3 border-top mt-3 gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <span class="small text-muted">Tampilkan:</span>
                        <select class="form-select form-select-sm" style="width: 90px;" onchange="location = this.value;">
                            <% ['10', '25', '50', '100', 'all'].forEach(l => { %>
                                <option value="/inventaris?tab=aset&asset_limit=<%= l %>&asset_search=<%= encodeURIComponent(assetFilters.search || '') %>&asset_category=<%= encodeURIComponent(assetFilters.category || '') %>&asset_condition=<%= encodeURIComponent(assetFilters.condition || '') %>&asset_location=<%= encodeURIComponent(assetFilters.location || '') %>" <%= assetPagination.limit == l ? 'selected' : '' %>>
                                    <%= l === 'all' ? 'Semua' : l %>
                                </option>
                            <% }) %>
                        </select>
                        <span class="small text-muted ms-2">
                            Showing <%= assetPagination.totalCount > 0 ? (assetPagination.page - 1) * (assetPagination.limit === 'all' ? assetPagination.totalCount : parseInt(assetPagination.limit)) + 1 : 0 %> 
                            to <%= assetPagination.limit === 'all' ? assetPagination.totalCount : Math.min(assetPagination.page * parseInt(assetPagination.limit), assetPagination.totalCount) %> 
                            of <%= assetPagination.totalCount %> items
                        </span>
                    </div>
                    
                    <% if (assetPagination.totalPages > 1 && assetPagination.limit !== 'all') { %>
                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item <%= assetPagination.page <= 1 ? 'disabled' : '' %>">
                                    <a class="page-link" href="/inventaris?tab=aset&asset_page=<%= assetPagination.page - 1 %>&asset_limit=<%= assetPagination.limit %>&asset_search=<%= encodeURIComponent(assetFilters.search || '') %>&asset_category=<%= encodeURIComponent(assetFilters.category || '') %>&asset_condition=<%= encodeURIComponent(assetFilters.condition || '') %>&asset_location=<%= encodeURIComponent(assetFilters.location || '') %>">Previous</a>
                                </li>
                                <% for (let p = 1; p <= assetPagination.totalPages; p++) { %>
                                    <li class="page-item <%= assetPagination.page === p ? 'active' : '' %>">
                                        <a class="page-link" href="/inventaris?tab=aset&asset_page=<%= p %>&asset_limit=<%= assetPagination.limit %>&asset_search=<%= encodeURIComponent(assetFilters.search || '') %>&asset_category=<%= encodeURIComponent(assetFilters.category || '') %>&asset_condition=<%= encodeURIComponent(assetFilters.condition || '') %>&asset_location=<%= encodeURIComponent(assetFilters.location || '') %>"><%= p %></a>
                                    </li>
                                <% } %>
                                <li class="page-item <%= assetPagination.page >= assetPagination.totalPages ? 'disabled' : '' %>">
                                    <a class="page-link" href="/inventaris?tab=aset&asset_page=<%= assetPagination.page + 1 %>&asset_limit=<%= assetPagination.limit %>&asset_search=<%= encodeURIComponent(assetFilters.search || '') %>&asset_category=<%= encodeURIComponent(assetFilters.category || '') %>&asset_condition=<%= encodeURIComponent(assetFilters.condition || '') %>&asset_location=<%= encodeURIComponent(assetFilters.location || '') %>">Next</a>
                                </li>
                            </ul>
                        </nav>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <!-- Tab 2: Persediaan -->
    <div class="tab-pane fade <%= activeTab === 'persediaan' ? 'show active' : '' %>" id="persediaan" role="tabpanel">
        <!-- Filter Card Persediaan -->
        <div class="card card-custom mb-3 p-3 bg-light-subtle">
            <form method="GET" action="/inventaris" class="row g-2 align-items-center">
                <input type="hidden" name="tab" value="persediaan">
                <div class="col-md-5">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" name="inv_search" class="form-control" placeholder="Cari Nama / Kode Barang Persediaan..." value="<%= inventoryFilters.search || '' %>">
                    </div>
                </div>
                <div class="col-md-4">
                    <select name="inv_category" class="form-select form-select-sm">
                        <option value="">-- Semua Kategori --</option>
                        <% if (typeof inventoryCategories !== 'undefined' && inventoryCategories.length > 0) { %>
                            <% inventoryCategories.forEach(cat => { %>
                                <option value="<%= cat.name %>" <%= inventoryFilters.category === cat.name ? 'selected' : '' %>><%= cat.name %></option>
                            <% }) %>
                        <% } %>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-1">
                    <button type="submit" class="btn btn-sm btn-primary flex-fill"><i class="bi bi-funnel me-1"></i>Filter</button>
                    <a href="/inventaris?tab=persediaan" class="btn btn-sm btn-outline-secondary" title="Reset Filter"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>
        </div>

        <div class="card card-custom p-3">
            <div class="card-body">
                <h5 class="fw-bold text-dark mb-3">Stok Barang Persediaan (Habis Pakai)</h5>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Kode Barang</th>
                                <th>Nama Barang</th>
                                <th>Kategori</th>
                                <th>Stok Saat Ini</th>
                                <th>Satuan</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (items.length > 0) { %>
                                <% items.forEach(itm => { %>
                                    <tr>
                                        <td class="fw-bold text-dark font-monospace"><%= itm.item_code %></td>
                                        <td class="fw-semibold"><%= itm.name %></td>
                                        <td>
                                            <span class="badge <%= itm.category === 'Pembangunan' ? 'bg-warning text-dark' : 'bg-info' %>">
                                                <%= itm.category %>
                                            </span>
                                        </td>
                                        <td>
                                            <span class="fw-bold fs-5 <%= itm.stock <= 5 ? 'text-danger' : 'text-success' %>">
                                                <%= itm.stock %>
                                            </span>
                                        </td>
                                        <td class="text-muted"><%= itm.unit %></td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">Belum ada barang persediaan terdaftar.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Bar for Persediaan -->
                <div class="d-flex flex-wrap align-items-center justify-content-between pt-3 border-top mt-3 gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <span class="small text-muted">Tampilkan:</span>
                        <select class="form-select form-select-sm" style="width: 90px;" onchange="location = this.value;">
                            <% ['10', '25', '50', '100', 'all'].forEach(l => { %>
                                <option value="/inventaris?tab=persediaan&inv_limit=<%= l %>&inv_search=<%= encodeURIComponent(inventoryFilters.search || '') %>&inv_category=<%= encodeURIComponent(inventoryFilters.category || '') %>" <%= inventoryPagination.limit == l ? 'selected' : '' %>>
                                    <%= l === 'all' ? 'Semua' : l %>
                                </option>
                            <% }) %>
                        </select>
                        <span class="small text-muted ms-2">
                            Showing <%= inventoryPagination.totalCount > 0 ? (inventoryPagination.page - 1) * (inventoryPagination.limit === 'all' ? inventoryPagination.totalCount : parseInt(inventoryPagination.limit)) + 1 : 0 %> 
                            to <%= inventoryPagination.limit === 'all' ? inventoryPagination.totalCount : Math.min(inventoryPagination.page * parseInt(inventoryPagination.limit), inventoryPagination.totalCount) %> 
                            of <%= inventoryPagination.totalCount %> items
                        </span>
                    </div>
                    
                    <% if (inventoryPagination.totalPages > 1 && inventoryPagination.limit !== 'all') { %>
                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item <%= inventoryPagination.page <= 1 ? 'disabled' : '' %>">
                                    <a class="page-link" href="/inventaris?tab=persediaan&inv_page=<%= inventoryPagination.page - 1 %>&inv_limit=<%= inventoryPagination.limit %>&inv_search=<%= encodeURIComponent(inventoryFilters.search || '') %>&inv_category=<%= encodeURIComponent(inventoryFilters.category || '') %>">Previous</a>
                                </li>
                                <% for (let p = 1; p <= inventoryPagination.totalPages; p++) { %>
                                    <li class="page-item <%= inventoryPagination.page === p ? 'active' : '' %>">
                                        <a class="page-link" href="/inventaris?tab=persediaan&inv_page=<%= p %>&inv_limit=<%= inventoryPagination.limit %>&inv_search=<%= encodeURIComponent(inventoryFilters.search || '') %>&inv_category=<%= encodeURIComponent(inventoryFilters.category || '') %>"><%= p %></a>
                                    </li>
                                <% } %>
                                <li class="page-item <%= inventoryPagination.page >= inventoryPagination.totalPages ? 'disabled' : '' %>">
                                    <a class="page-link" href="/inventaris?tab=persediaan&inv_page=<%= inventoryPagination.page + 1 %>&inv_limit=<%= inventoryPagination.limit %>&inv_search=<%= encodeURIComponent(inventoryFilters.search || '') %>&inv_category=<%= encodeURIComponent(inventoryFilters.category || '') %>">Next</a>
                                </li>
                            </ul>
                        </nav>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <!-- Tab 3: Logs -->
    <div class="tab-pane fade <%= activeTab === 'logs' ? 'show active' : '' %>" id="logs" role="tabpanel">
        <!-- Filter Card Log Masuk/Keluar -->
        <div class="card card-custom mb-3 p-3 bg-light-subtle">
            <form method="GET" action="/inventaris" class="row g-2 align-items-center">
                <input type="hidden" name="tab" value="logs">
                <div class="col-md-3">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" name="log_search" class="form-control" placeholder="Cari Nama Barang / Catatan..." value="<%= logFilters.search || '' %>">
                    </div>
                </div>
                <div class="col-md-2">
                    <input type="date" name="log_start_date" class="form-control form-control-sm" value="<%= logFilters.start_date || '' %>" title="Tanggal Mulai">
                </div>
                <div class="col-md-2">
                    <input type="date" name="log_end_date" class="form-control form-control-sm" value="<%= logFilters.end_date || '' %>" title="Tanggal Akhir">
                </div>
                <div class="col-md-3">
                    <select name="log_type" class="form-select form-select-sm">
                        <option value="">-- Semua Tipe Mutasi --</option>
                        <option value="Masuk" <%= logFilters.type === 'Masuk' ? 'selected' : '' %>>Masuk (Pengadaan / Donasi)</option>
                        <option value="Keluar" <%= logFilters.type === 'Keluar' ? 'selected' : '' %>>Keluar (Pemakaian)</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-1">
                    <button type="submit" class="btn btn-sm btn-primary flex-fill"><i class="bi bi-funnel me-1"></i>Filter</button>
                    <a href="/inventaris?tab=logs" class="btn btn-sm btn-outline-secondary" title="Reset Filter"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>
        </div>

        <div class="card card-custom p-3">
            <div class="card-body">
                <h5 class="fw-bold text-dark mb-3">Riwayat Mutasi Persediaan</h5>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Waktu</th>
                                <th>Nama Barang</th>
                                <th>Tipe Mutasi</th>
                                <th>Jumlah</th>
                                <th>Catatan Pemakaian / Pengadaan</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (logs.length > 0) { %>
                                <% logs.forEach(lg => { %>
                                    <tr>
                                        <td class="small text-muted"><%= formatDate(lg.created_at) %></td>
                                        <td class="fw-semibold"><%= lg.item_name %></td>
                                        <td>
                                            <span class="badge <%= lg.type === 'Masuk' ? 'bg-success' : 'bg-danger' %>">
                                                <%= lg.type %>
                                            </span>
                                        </td>
                                        <td class="fw-bold"><%= lg.qty %> <%= lg.unit %></td>
                                        <td class="small text-muted"><%= lg.notes %></td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">Belum ada riwayat mutasi persediaan.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Bar for Logs -->
                <div class="d-flex flex-wrap align-items-center justify-content-between pt-3 border-top mt-3 gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <span class="small text-muted">Tampilkan:</span>
                        <select class="form-select form-select-sm" style="width: 90px;" onchange="location = this.value;">
                            <% ['10', '25', '50', '100', 'all'].forEach(l => { %>
                                <option value="/inventaris?tab=logs&log_limit=<%= l %>&log_search=<%= encodeURIComponent(logFilters.search || '') %>&log_start_date=<%= encodeURIComponent(logFilters.start_date || '') %>&log_end_date=<%= encodeURIComponent(logFilters.end_date || '') %>&log_type=<%= encodeURIComponent(logFilters.type || '') %>" <%= logPagination.limit == l ? 'selected' : '' %>>
                                    <%= l === 'all' ? 'Semua' : l %>
                                </option>
                            <% }) %>
                        </select>
                        <span class="small text-muted ms-2">
                            Showing <%= logPagination.totalCount > 0 ? (logPagination.page - 1) * (logPagination.limit === 'all' ? logPagination.totalCount : parseInt(logPagination.limit)) + 1 : 0 %> 
                            to <%= logPagination.limit === 'all' ? logPagination.totalCount : Math.min(logPagination.page * parseInt(logPagination.limit), logPagination.totalCount) %> 
                            of <%= logPagination.totalCount %> items
                        </span>
                    </div>
                    
                    <% if (logPagination.totalPages > 1 && logPagination.limit !== 'all') { %>
                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item <%= logPagination.page <= 1 ? 'disabled' : '' %>">
                                    <a class="page-link" href="/inventaris?tab=logs&log_page=<%= logPagination.page - 1 %>&log_limit=<%= logPagination.limit %>&log_search=<%= encodeURIComponent(logFilters.search || '') %>&log_start_date=<%= encodeURIComponent(logFilters.start_date || '') %>&log_end_date=<%= encodeURIComponent(logFilters.end_date || '') %>&log_type=<%= encodeURIComponent(logFilters.type || '') %>">Previous</a>
                                </li>
                                <% for (let p = 1; p <= logPagination.totalPages; p++) { %>
                                    <li class="page-item <%= logPagination.page === p ? 'active' : '' %>">
                                        <a class="page-link" href="/inventaris?tab=logs&log_page=<%= p %>&log_limit=<%= logPagination.limit %>&log_search=<%= encodeURIComponent(logFilters.search || '') %>&log_start_date=<%= encodeURIComponent(logFilters.start_date || '') %>&log_end_date=<%= encodeURIComponent(logFilters.end_date || '') %>&log_type=<%= encodeURIComponent(logFilters.type || '') %>"><%= p %></a>
                                    </li>
                                <% } %>
                                <li class="page-item <%= logPagination.page >= logPagination.totalPages ? 'disabled' : '' %>">
                                    <a class="page-link" href="/inventaris?tab=logs&log_page=<%= logPagination.page + 1 %>&log_limit=<%= logPagination.limit %>&log_search=<%= encodeURIComponent(logFilters.search || '') %>&log_start_date=<%= encodeURIComponent(logFilters.start_date || '') %>&log_end_date=<%= encodeURIComponent(logFilters.end_date || '') %>&log_type=<%= encodeURIComponent(logFilters.type || '') %>">Next</a>
                                </li>
                            </ul>
                        </nav>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

