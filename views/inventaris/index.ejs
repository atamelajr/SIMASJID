                            <label class="form-label fw-semibold">Tipe / Model / No. Seri / No. Polisi (Opsional)</label>
                            <input type="text" name="model_no_plate" class="form-control" placeholder="Contoh: CS-PN12WKJ / BL 1234 AB">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Asal Usul Barang</label>
                            <select name="source_origin" class="form-select" required>
                                <option value="Pembelian">🛒 Pembelian</option>
                                <option value="Hibah">🎁 Hibah</option>
                                <option value="Wakaf">🕌 Wakaf</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Lokasi Penempatan</label>
                            <select name="location" class="form-select" required>
                                <% if (typeof locations !== 'undefined' && locations.length > 0) { %>
                                    <% locations.forEach(loc => { %>
                                        <option value="<%= loc.name %>"><%= loc.code %> - <%= loc.name %></option>
                                    <% }) %>
                                <% } else { %>
                                    <option value="Ruang Utama Sholat">Ruang Utama Sholat</option>
                                    <option value="Masjid">Masjid</option>
                                <% } %>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Jumlah Aset (Qty / Unit)</label>
                            <input type="number" name="qty" class="form-control fw-bold" value="1" min="1" required placeholder="Contoh: 3">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Tanggal Perolehan</label>
                            <input type="date" name="purchase_date" class="form-control" value="<%= new Date().toISOString().split('T')[0] %>">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Nilai Perolehan / Cost (Rp)</label>
                            <input type="number" step="0.01" name="cost" class="form-control" placeholder="Contoh: 5000000" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Status Kondisi</label>
                            <select name="condition_status" class="form-select" required>
                                <option value="Baik">🟢 Baik</option>
                                <option value="Rusak Ringan">🟡 Rusak Ringan</option>
                                <option value="Rusak Berat">🔴 Rusak Berat</option>
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-semibold">Catatan / Spesifikasi Tambahan (Opsional)</label>
                            <textarea name="description" class="form-control" rows="2" placeholder="Detail garansi, spesifikasi teknis, dll."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-primary">Simpan Aset</button>
                </div>
            </form>
        </div>
    </div>
</div>

