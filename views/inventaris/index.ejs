                                    <% assetCatalog.forEach(catItem => { %>
                                        <option value="<%= catItem.name %>"><%= catItem.code %> - <%= catItem.name %></option>
                                    <% }) %>
                                <% } %>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Kategori Aset</label>
                            <select name="category" id="edit_asset_category" class="form-select" required>
                                <option value="Tanah & Lahan">Tanah & Lahan</option>
                                <option value="Bangunan & Infrastruktur">Bangunan & Infrastruktur</option>
                                <option value="Peralatan & Mesin">Peralatan & Mesin</option>
                                <option value="Meubiler & Mebel">Meubiler & Mebel</option>
                                <option value="Aset Tetap Lainnya">Aset Tetap Lainnya</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Merk / Brand (Opsional)</label>
                            <input type="text" name="brand" id="edit_asset_brand" class="form-control" placeholder="Contoh: Panasonic / Sharp / Jepara">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Tipe / Model / No. Seri / No. Polisi (Opsional)</label>
                            <input type="text" name="model_no_plate" id="edit_asset_model_no_plate" class="form-control" placeholder="Contoh: CS-PN12WKJ / BL 1234 AB">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Asal Usul Barang</label>
                            <select name="source_origin" id="edit_asset_source_origin" class="form-select" required>
                                <option value="Pembelian">🛒 Pembelian</option>
                                <option value="Hibah">🎁 Hibah</option>
                                <option value="Wakaf">🕌 Wakaf</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Lokasi Penempatan</label>
                            <select name="location" id="edit_asset_location" class="form-select" required>
                                <% if (typeof locations !== 'undefined' && locations.length > 0) { %>
                                    <% locations.forEach(loc => { %>
                                        <option value="<%= loc.name %>"><%= loc.code %> - <%= loc.name %></option>
                                    <% }) %>
                                <% } else { %>
                                    <option value="Ruang Utama Sholat">Ruang Utama Sholat</option>
                                    <option value="Masjid">Masjid</option>
                                <% } %>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Tanggal Perolehan</label>
                            <input type="date" name="purchase_date" id="edit_asset_purchase_date" class="form-control">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Nilai Perolehan / Cost (Rp)</label>
                            <input type="number" step="0.01" name="cost" id="edit_asset_cost" class="form-control" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Status Kondisi</label>
                            <select name="condition_status" id="edit_asset_condition_status" class="form-select" required>
                                <option value="Baik">🟢 Baik</option>
                                <option value="Rusak Ringan">🟡 Rusak Ringan</option>
                                <option value="Rusak Berat">🔴 Rusak Berat</option>
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-semibold">Catatan / Spesifikasi Tambahan (Opsional)</label>
                            <textarea name="description" id="edit_asset_description" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-warning fw-bold"><i class="bi bi-check-circle me-1"></i> Simpan Perubahan</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Pemakaian Persediaan -->
<div class="modal fade" id="modalUsage" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Catat Pemakaian Barang Persediaan</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/inventaris/usage" method="POST">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Pilih Barang</label>
                        <select name="item_id" class="form-select" required>
                            <% items.forEach(itm => { %>
                                <option value="<%= itm.id %>"><%= itm.name %> (Stok Tersedia: <%= itm.stock %> <%= itm.unit %>)</option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Jumlah Keluar / Dipakai</label>
                        <input type="number" step="0.1" name="qty" class="form-control" placeholder="Contoh: 2" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Keperluan Pemakaian / Catatan</label>
                        <textarea name="notes" class="form-control" rows="2" placeholder="Contoh: Digunakan untuk pengecoran menara masjid"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-warning">Simpan Pemakaian</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openEditAssetModal(ast) {
        document.getElementById('formEditAsset').action = '/inventaris/asset/update/' + ast.id;
        
        const nameSelect = document.getElementById('edit_asset_name');
        if (nameSelect) {
            let found = false;
            for (let i = 0; i < nameSelect.options.length; i++) {
                if (nameSelect.options[i].value === ast.name) {
                    nameSelect.selectedIndex = i;
                    found = true;
                    break;
                }
            }
            if (!found && ast.name) {
                const opt = document.createElement('option');
                opt.value = ast.name;
                opt.text = ast.name;
                opt.selected = true;
                nameSelect.appendChild(opt);
            }
        }

        document.getElementById('edit_asset_brand').value = ast.brand || '';
        document.getElementById('edit_asset_model_no_plate').value = ast.model_no_plate || '';
        document.getElementById('edit_asset_category').value = ast.category || 'Peralatan & Mesin';
        if (document.getElementById('edit_asset_source_origin')) {
            document.getElementById('edit_asset_source_origin').value = ast.source_origin || 'Pembelian';
        }
        if (document.getElementById('edit_asset_location')) {
            document.getElementById('edit_asset_location').value = ast.location || '';
        }
        document.getElementById('edit_asset_purchase_date').value = ast.purchase_date ? ast.purchase_date.split('T')[0] : '';
        document.getElementById('edit_asset_cost').value = ast.cost || 0;
        document.getElementById('edit_asset_condition_status').value = ast.condition_status || 'Baik';
        document.getElementById('edit_asset_description').value = ast.description || '';

        const modal = new bootstrap.Modal(document.getElementById('modalEditAsset'));
        modal.show();
    }
</script>
