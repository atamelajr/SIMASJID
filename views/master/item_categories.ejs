<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h4 class="fw-bold text-dark mb-1"><i class="bi bi-tags text-primary me-2"></i>Pengaturan Akun / Kategori Barang & Aset</h4>
        <p class="text-muted small mb-0">Standarisasi Kode Rekening Akun (COA ISAK 35) untuk Aset Tetap dan Material Persediaan.</p>
    </div>
    <button class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#modalAddItemCategory">
        <i class="bi bi-plus-lg me-1"></i> Tambah Kategori Baru
    </button>
</div>

<!-- Category List Card -->
<div class="card card-custom p-3">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width: 140px;">Kode Rekening</th>
                        <th>Kategori Utama</th>
                        <th>Tipe Kelompok</th>
                        <th>Contoh Barang / Deskripsi Sub-Kategori</th>
                        <th class="text-end">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (itemCategories.length > 0) { %>
                        <% itemCategories.forEach(cat => { %>
                            <tr>
                                <td class="fw-bold font-monospace text-primary"><code><%= cat.account_code %></code></td>
                                <td class="fw-bold text-dark"><%= cat.name %></td>
                                <td>
                                    <span class="badge <%= cat.type === 'Aset' ? 'bg-primary' : 'bg-warning text-dark' %>">
                                        <%= cat.type === 'Aset' ? 'Aset Tetap (Modal)' : 'Persediaan (Material)' %>
                                    </span>
                                </td>
                                <td class="small text-muted"><%= cat.description || '-' %></td>
                                <td class="text-end text-nowrap">
                                    <button class="btn btn-sm btn-outline-warning me-1" 
                                            onclick='editItemCategory(<%- JSON.stringify(cat) %>)' title="Edit Kategori">
                                        <i class="bi bi-pencil"></i> Edit
                                    </button>
                                    <% if (user.role_name === 'Admin') { %>
                                        <form action="/master/item-categories/delete/<%= cat.id %>" method="POST" class="d-inline" onsubmit="return confirm('Apakah Anda yakin ingin menghapus kategori barang ini?')">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Hapus Kategori"><i class="bi bi-trash"></i></button>
                                        </form>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">Belum ada kategori barang/aset terdaftar.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Tambah Kategori -->
<div class="modal fade" id="modalAddItemCategory" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Tambah Kategori Barang / Aset Baru</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/master/item-categories/create" method="POST">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tipe Kelompok</label>
                        <select name="type" id="add_cat_type" class="form-select" required onchange="onAddCatTypeChange()">
                            <option value="Aset">Barang Modal (Aset Tetap)</option>
                            <option value="Material">Persediaan (Material / Habis Pakai)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label fw-semibold mb-0">Kode Rekening Akun (COA ISAK 35)</label>
                            <span class="badge bg-info-subtle text-info border">Otomatis / Manual</span>
                        </div>
                        <input type="text" name="account_code" id="add_cat_account_code" class="form-control fw-bold font-monospace bg-light text-primary" placeholder="Contoh: 1210" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nama Kategori Utama</label>
                        <input type="text" name="name" class="form-control" placeholder="Contoh: Tanah & Lahan / Alat Tulis Kantor" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Contoh Barang / Deskripsi Sub-Kategori</label>
                        <textarea name="description" class="form-control" rows="2" placeholder="Contoh: Sound System, AC, Projector, Genset..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-primary">Simpan Kategori</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Edit Kategori -->
<div class="modal fade" id="modalEditItemCategory" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Edit Kategori Barang / Aset</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="formEditItemCategory" action="" method="POST">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tipe Kelompok</label>
                        <select name="type" id="edit_cat_type" class="form-select" required>
                            <option value="Aset">Barang Modal (Aset Tetap)</option>
                            <option value="Material">Persediaan (Material / Habis Pakai)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Kode Rekening Akun (COA ISAK 35)</label>
                        <input type="text" name="account_code" id="edit_cat_account_code" class="form-control fw-bold font-monospace" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nama Kategori Utama</label>
                        <input type="text" name="name" id="edit_cat_name" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Contoh Barang / Deskripsi Sub-Kategori</label>
                        <textarea name="description" id="edit_cat_description" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-warning">Update Kategori</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
const nextCodes = <%- JSON.stringify(nextCodes) %>;

function onAddCatTypeChange() {
    const selectedType = document.getElementById('add_cat_type').value;
    document.getElementById('add_cat_account_code').value = nextCodes[selectedType] || '';
}

document.addEventListener('DOMContentLoaded', function() {
    onAddCatTypeChange();
});

const modalAddItemCategory = document.getElementById('modalAddItemCategory');
if (modalAddItemCategory) {
    modalAddItemCategory.addEventListener('shown.bs.modal', function () {
        onAddCatTypeChange();
    });
}

function editItemCategory(cat) {
    document.getElementById('formEditItemCategory').action = '/master/item-categories/update/' + cat.id;
    document.getElementById('edit_cat_type').value = cat.type;
    document.getElementById('edit_cat_account_code').value = cat.account_code;
    document.getElementById('edit_cat_name').value = cat.name;
    document.getElementById('edit_cat_description').value = cat.description || '';
    
    new bootstrap.Modal(document.getElementById('modalEditItemCategory')).show();
}
</script>
