<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h4 class="fw-bold text-dark mb-1">Master Donatur & Mustahik (ZIS)</h4>
        <p class="text-muted small mb-0">Direktori Penyumbang (Donatur) dan Penerima Manfaat Zakat (Mustahik / Asnaf).</p>
    </div>
    <button class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#modalAddDonorMustahik">
        <i class="bi bi-person-plus me-1"></i> Tambah Data
    </button>
</div>

<!-- Nav Tabs Segregation: Donatur vs Mustahik -->
<ul class="nav nav-pills custom-pills mb-4 gap-2">
    <li class="nav-item">
        <a class="nav-link rounded-3 px-4 py-2 fw-bold <%= activeTab === 'Donatur' ? 'active bg-success text-white shadow-sm' : 'bg-white text-dark border' %>" 
           href="/master/donors-mustahik?tab=Donatur">
            <i class="bi bi-heart-fill me-2 <%= activeTab === 'Donatur' ? 'text-white' : 'text-success' %>"></i>
            Daftar Donatur Tetap / Instansi 
            <span class="badge rounded-pill ms-2 <%= activeTab === 'Donatur' ? 'bg-white text-success' : 'bg-success text-white' %>"><%= donorCount %></span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link rounded-3 px-4 py-2 fw-bold <%= activeTab === 'Mustahik' ? 'active bg-warning text-dark shadow-sm' : 'bg-white text-dark border' %>" 
           href="/master/donors-mustahik?tab=Mustahik">
            <i class="bi bi-people-fill me-2 <%= activeTab === 'Mustahik' ? 'text-dark' : 'text-warning' %>"></i>
            Daftar Mustahik ZIS (Asnaf) 
            <span class="badge rounded-pill ms-2 <%= activeTab === 'Mustahik' ? 'bg-dark text-white' : 'bg-warning text-dark' %>"><%= mustahikCount %></span>
        </a>
    </li>
</ul>

<!-- Card Container for Active Tab Data -->
<div class="card card-custom p-3 shadow-sm border-0 mb-4">
    <div class="card-body p-2">

        <!-- Search & Filter Bar -->
        <form action="/master/donors-mustahik" method="GET" class="row g-2 align-items-end mb-3">
            <input type="hidden" name="tab" value="<%= activeTab %>">
            <input type="hidden" name="limit" value="<%= pagination.limit %>">

            <div class="col-md-5">
                <label class="form-label extra-small fw-bold text-muted mb-1"><i class="bi bi-search me-1"></i>Cari Nama / No. HP / Alamat</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Ketik kata kunci pencarian..." value="<%= filters.search || '' %>">
                </div>
            </div>

            <div class="col-md-4">
                <label class="form-label extra-small fw-bold text-muted mb-1">
                    <i class="bi bi-funnel me-1"></i><%= activeTab === 'Mustahik' ? 'Filter Golongan Asnaf' : 'Filter Kategori Donatur' %>
                </label>
                <select name="category" class="form-select form-select-sm">
                    <option value="">-- Semua Kategori / Golongan --</option>
                    <% 
                    const availableCats = activeTab === 'Mustahik' 
                        ? ['Fakir', 'Miskin', 'Amil', 'Mualaf', 'Riqab', 'Gharim', 'Fisabilillah', 'Ibnu Sabil']
                        : ['Perorangan', 'OPD', 'Pemerintah Kampung', 'Instansi Vertikal', 'Badan Usaha', 'LSM', 'Komunitas'];
                    availableCats.forEach(cat => { 
                    %>
                        <option value="<%= cat %>" <%= filters.category === cat ? 'selected' : '' %>><%= cat %></option>
                    <% }) %>
                </select>
            </div>

            <div class="col-md-3 d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-primary w-100"><i class="bi bi-filter me-1"></i>Cari & Filter</button>
                <a href="/master/donors-mustahik?tab=<%= activeTab %>" class="btn btn-sm btn-light border w-100" title="Reset Filter"><i class="bi bi-arrow-counterclockwise me-1"></i>Reset</a>
            </div>
        </form>

        <!-- Table Display -->
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width: 50px;">No</th>
                        <th><%= activeTab === 'Mustahik' ? 'Nama Mustahik' : 'Nama Donatur / Instansi' %></th>
                        <th><%= activeTab === 'Mustahik' ? 'Golongan Asnaf' : 'Kategori Donatur' %></th>
                        <th>No. HP / WA</th>
                        <th>Alamat Lengkap</th>
                        <th class="text-end" style="width: 100px;">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (items && items.length > 0) { 
                        const startIndex = pagination.limit === 'all' ? 1 : ((pagination.page - 1) * parseInt(pagination.limit) + 1);
                    %>
                        <% items.forEach((item, idx) => { %>
                            <tr>
                                <td class="text-muted small"><%= startIndex + idx %></td>
                                <td class="fw-bold text-dark">
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle p-2 me-2 <%= activeTab === 'Mustahik' ? 'bg-warning-subtle text-warning' : 'bg-success-subtle text-success' %> d-flex align-items-center justify-content-center" style="width:32px; height:32px;">
                                            <i class="bi <%= activeTab === 'Mustahik' ? 'bi-person' : 'bi-building' %>"></i>
                                        </div>
                                        <div><%= item.name %></div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge <%= activeTab === 'Mustahik' ? 'bg-warning-subtle text-warning-emphasis border' : 'bg-success-subtle text-success-emphasis border' %>">
                                        <%= item.category %>
                                    </span>
                                </td>
                                <td>
                                    <% if (item.phone && item.phone.trim() !== '') { %>
                                        <a href="https://wa.me/<%= item.phone.replace(/[^0-9]/g, '') %>" target="_blank" class="text-decoration-none small text-success fw-semibold">
                                            <i class="bi bi-whatsapp me-1"></i><%= item.phone %>
                                        </a>
                                    <% } else { %>
                                        <span class="small text-muted">-</span>
                                    <% } %>
                                </td>
                                <td class="small text-muted text-truncate" style="max-width: 250px;" title="<%= item.address || '-' %>">
                                    <%= item.address || '-' %>
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-warning me-1" 
                                            onclick="editDonorMustahik(<%= JSON.stringify(item) %>)" title="Edit Data">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <% if (user && user.role_name === 'Admin') { %>
                                        <form action="/master/donors-mustahik/delete/<%= item.id %>" method="POST" class="d-inline" onsubmit="return confirm('Apakah Anda yakin ingin menghapus data ini?')">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Hapus Data"><i class="bi bi-trash"></i></button>
                                        </form>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-3 d-block mb-1 text-muted opacity-50"></i>
                                Belum ada data <%= activeTab === 'Mustahik' ? 'mustahik' : 'donatur' %> yang sesuai kriteria pencarian.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <!-- Pagination Bar -->
        <% if (pagination && pagination.totalCount > 0) { 
            const startItem = pagination.limit === 'all' ? 1 : Math.min((pagination.page - 1) * parseInt(pagination.limit) + 1, pagination.totalCount);
            const endItem = pagination.limit === 'all' ? pagination.totalCount : Math.min(pagination.page * parseInt(pagination.limit), pagination.totalCount);
            
            const queryParams = new URLSearchParams();
            queryParams.set('tab', activeTab);
            if (filters.search) queryParams.set('search', filters.search);
            if (filters.category) queryParams.set('category', filters.category);
            queryParams.set('limit', pagination.limit);
        %>
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mt-3 pt-3 border-top gap-2">
                <!-- Row Limit Selector & Total Summary -->
                <div class="d-flex align-items-center gap-2">
                    <span class="small text-muted">Tampilkan:</span>
                    <form action="/master/donors-mustahik" method="GET" class="d-inline-block">
                        <input type="hidden" name="tab" value="<%= activeTab %>">
                        <% if (filters.search) { %><input type="hidden" name="search" value="<%= filters.search %>"><% } %>
                        <% if (filters.category) { %><input type="hidden" name="category" value="<%= filters.category %>"><% } %>
                        
                        <select name="limit" class="form-select form-select-sm" style="width: auto;" onchange="this.form.submit()">
                            <option value="10" <%= pagination.limit === '10' ? 'selected' : '' %>>10</option>
                            <option value="25" <%= pagination.limit === '25' ? 'selected' : '' %>>25</option>
                            <option value="50" <%= pagination.limit === '50' ? 'selected' : '' %>>50</option>
                            <option value="100" <%= pagination.limit === '100' ? 'selected' : '' %>>100</option>
                            <option value="all" <%= pagination.limit === 'all' ? 'selected' : '' %>>Semua (<%= pagination.totalCount %>)</option>
                        </select>
                    </form>
                    <span class="small text-muted ms-2">
                        Menampilkan <strong><%= startItem %></strong> - <strong><%= endItem %></strong> dari <strong><%= pagination.totalCount %></strong> data
                    </span>
                </div>

                <!-- Page Navigation Links -->
                <% if (pagination.limit !== 'all' && pagination.totalPages > 1) { %>
                    <nav aria-label="Navigasi Halaman">
                        <ul class="pagination pagination-sm mb-0">
                            <!-- Previous Page -->
                            <li class="page-item <%= pagination.page <= 1 ? 'disabled' : '' %>">
                                <% queryParams.set('page', pagination.page - 1); %>
                                <a class="page-link" href="/master/donors-mustahik?<%= queryParams.toString() %>">Sebelumnya</a>
                            </li>

                            <!-- Page Numbers -->
                            <% for (let p = 1; p <= pagination.totalPages; p++) { 
                                queryParams.set('page', p);
                            %>
                                <li class="page-item <%= p === pagination.page ? 'active' : '' %>">
                                    <a class="page-link" href="/master/donors-mustahik?<%= queryParams.toString() %>"><%= p %></a>
                                </li>
                            <% } %>

                            <!-- Next Page -->
                            <li class="page-item <%= pagination.page >= pagination.totalPages ? 'disabled' : '' %>">
                                <% queryParams.set('page', pagination.page + 1); %>
                                <a class="page-link" href="/master/donors-mustahik?<%= queryParams.toString() %>">Selanjutnya</a>
                            </li>
                        </ul>
                    </nav>
                <% } %>
            </div>
        <% } %>

    </div>
</div>

<!-- Modal Tambah Data Donatur / Mustahik -->
<div class="modal fade" id="modalAddDonorMustahik" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Tambah Data Donatur / Mustahik</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/master/donors-mustahik/create" method="POST">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tipe Data</label>
                        <select id="add_dm_type" name="type" class="form-select" required onchange="onAddTypeChange()">
                            <option value="Donatur">Donatur (Penyumbang)</option>
                            <option value="Mustahik">Mustahik (Penerima Zakat/Bantuan)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nama Lengkap / Instansi</label>
                        <input type="text" name="name" class="form-control" required placeholder="Contoh: H. Ahmad / PT Amanah">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" id="lbl_add_category">Kategori Donatur</label>
                        <select id="add_dm_category" name="category" class="form-select" required></select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">No. HP / WA</label>
                        <input type="text" name="phone" class="form-control" placeholder="0812...">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Alamat Lengkap</label>
                        <textarea name="address" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-primary">Simpan Data</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Edit Data Donatur / Mustahik -->
<div class="modal fade" id="modalEditDonorMustahik" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Edit Data Donatur / Mustahik</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="formEditDonorMustahik" action="" method="POST">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tipe Data</label>
                        <select id="edit_dm_type" name="type" class="form-select" required onchange="onEditTypeChange()">
                            <option value="Donatur">Donatur (Penyumbang)</option>
                            <option value="Mustahik">Mustahik (Penerima Zakat/Bantuan)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nama Lengkap / Instansi</label>
                        <input type="text" id="edit_dm_name" name="name" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" id="lbl_edit_category">Kategori Donatur</label>
                        <select id="edit_dm_category" name="category" class="form-select" required></select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">No. HP / WA</label>
                        <input type="text" id="edit_dm_phone" name="phone" class="form-control">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Alamat Lengkap</label>
                        <textarea id="edit_dm_address" name="address" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-warning">Update Data</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
const donorCategories = ['Perorangan', 'OPD', 'Pemerintah Kampung', 'Instansi Vertikal', 'Badan Usaha', 'LSM', 'Komunitas'];
const mustahikCategories = ['Fakir', 'Miskin', 'Amil', 'Mualaf', 'Riqab', 'Gharim', 'Fisabilillah', 'Ibnu Sabil'];

function populateCategories(typeVal, selectEl, labelEl, selectedVal) {
    if (!selectEl) return;
    selectEl.innerHTML = '';
    
    const categories = typeVal === 'Mustahik' ? mustahikCategories : donorCategories;
    if (labelEl) {
        labelEl.innerText = typeVal === 'Mustahik' ? 'Golongan Asnaf Mustahik' : 'Kategori Donatur';
    }

    categories.forEach(cat => {
        const opt = document.createElement('option');
        opt.value = cat;
        opt.textContent = cat;
        if (cat === selectedVal) opt.selected = true;
        selectEl.appendChild(opt);
    });

    if (selectedVal && !categories.includes(selectedVal)) {
        const opt = document.createElement('option');
        opt.value = selectedVal;
        opt.textContent = selectedVal;
        opt.selected = true;
        selectEl.appendChild(opt);
    }
}

function onAddTypeChange() {
    const typeVal = document.getElementById('add_dm_type').value;
    const catSelect = document.getElementById('add_dm_category');
    const labelEl = document.getElementById('lbl_add_category');
    populateCategories(typeVal, catSelect, labelEl);
}

function onEditTypeChange() {
    const typeVal = document.getElementById('edit_dm_type').value;
    const catSelect = document.getElementById('edit_dm_category');
    const labelEl = document.getElementById('lbl_edit_category');
    const currentVal = catSelect.value;
    populateCategories(typeVal, catSelect, labelEl, currentVal);
}

function editDonorMustahik(dm) {
    document.getElementById('formEditDonorMustahik').action = '/master/donors-mustahik/update/' + dm.id;
    document.getElementById('edit_dm_type').value = dm.type;
    document.getElementById('edit_dm_name').value = dm.name;
    document.getElementById('edit_dm_phone').value = dm.phone || '';
    document.getElementById('edit_dm_address').value = dm.address || '';
    
    const catSelect = document.getElementById('edit_dm_category');
    const labelEl = document.getElementById('lbl_edit_category');
    populateCategories(dm.type, catSelect, labelEl, dm.category || '');
    
    new bootstrap.Modal(document.getElementById('modalEditDonorMustahik')).show();
}

document.addEventListener('DOMContentLoaded', function() {
    const defaultType = '<%= activeTab %>';
    const addTypeEl = document.getElementById('add_dm_type');
    if (addTypeEl) {
        addTypeEl.value = defaultType;
        onAddTypeChange();
    }
});
</script>
