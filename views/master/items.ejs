<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h4 class="fw-bold text-dark mb-1">Master Katalog Barang & Material</h4>
        <p class="text-muted small mb-0">Standarisasi nama barang aset tetap dan material persediaan masjid.</p>
    </div>
    <button class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#modalAddItem">
        <i class="bi bi-plus-lg me-1"></i> Tambah Barang / Material
    </button>
</div>

<!-- Filter & Search Card -->
<div class="card card-custom mb-4 no-print">
    <div class="card-body">
        <form action="/master/items" method="GET" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Pencarian Nama / Kode / SKU</label>
                <input type="text" name="search" class="form-control form-control-sm" placeholder="Cari nama barang, kode 1230-001, dll..." value="<%= filters.search %>">
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Tipe Kelompok</label>
                <select name="type" class="form-select form-select-sm">
                    <option value="">-- Semua Tipe --</option>
                    <option value="Aset" <%= filters.type === 'Aset' ? 'selected' : '' %>>Barang Modal (Aset)</option>
                    <option value="Material" <%= filters.type === 'Material' ? 'selected' : '' %>>Persediaan (Material)</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Kategori Barang</label>
                <select name="category" class="form-select form-select-sm">
                    <option value="">-- Semua Kategori --</option>
                    <% if (typeof itemCategories !== 'undefined' && itemCategories.length > 0) { %>
                        <% itemCategories.forEach(cat => { %>
                            <option value="<%= cat.name %>" <%= filters.category === cat.name ? 'selected' : '' %>><%= cat.account_code %> - <%= cat.name %> (<%= cat.type %>)</option>
                        <% }) %>
                    <% } %>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-fill">
                    <i class="bi bi-filter me-1"></i> Filter
                </button>
                <a href="/master/items" class="btn btn-light btn-sm border">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card card-custom p-3">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Kode Barang</th>
                        <th>Nama Barang / Material</th>
                        <th>Tipe</th>
                        <th>Satuan Standar</th>
                        <th>Kategori</th>
                        <th>Keterangan</th>
                        <th class="text-end">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (items.length > 0) { %>
                        <% items.forEach(itm => { %>
                            <tr>
                                <td class="fw-bold text-primary font-monospace"><code><%= itm.code %></code></td>
                                <td class="fw-semibold"><%= itm.name %></td>
                                <td>
                                    <span class="badge <%= itm.type === 'Aset' ? 'bg-primary' : 'bg-warning text-dark' %>">
                                        <%= itm.type === 'Aset' ? 'Barang Modal (Aset)' : 'Persediaan (Material)' %>
                                    </span>
                                </td>
                                <td><span class="badge bg-light text-dark border"><%= itm.unit_name ? itm.unit_name + ' (' + itm.unit_code + ')' : '-' %></span></td>
                                <td><%= itm.category %></td>
                                <td class="small text-muted"><%= itm.description || '-' %></td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-warning me-1" 
                                            onclick="editItem(<%= JSON.stringify(itm) %>)">
                                        <i class="bi bi-pencil"></i> Edit
                                    </button>
                                    <% if (user.role_name === 'Admin') { %>
                                        <form action="/master/items/delete/<%= itm.id %>" method="POST" class="d-inline" onsubmit="return confirm('Hapus master barang ini?')">
                                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                        </form>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">Belum ada katalog barang/material yang sesuai filter.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <!-- Pagination Bar -->
        <% if (pagination && pagination.totalCount > 0) { 
            const startItem = pagination.limit === 'all' ? 1 : Math.min((pagination.page - 1) * parseInt(pagination.limit) + 1, pagination.totalCount);
            const endItem = pagination.limit === 'all' ? pagination.totalCount : Math.min(pagination.page * parseInt(pagination.limit), pagination.totalCount);
            
            const queryParams = new URLSearchParams();
            if (filters.search) queryParams.set('search', filters.search);
            if (filters.type) queryParams.set('type', filters.type);
            if (filters.category) queryParams.set('category', filters.category);
            queryParams.set('limit', pagination.limit);
        %>
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mt-3 pt-3 border-top gap-2">
                <!-- Row Limit Selector & Total Summary -->
                <div class="d-flex align-items-center gap-2">
                    <span class="small text-muted">Tampilkan:</span>
                    <form action="/master/items" method="GET" class="d-inline-block">
                        <% if (filters.search) { %><input type="hidden" name="search" value="<%= filters.search %>"><% } %>
                        <% if (filters.type) { %><input type="hidden" name="type" value="<%= filters.type %>"><% } %>
                        <% if (filters.category) { %><input type="hidden" name="category" value="<%= filters.category %>"><% } %>
                        
                        <select name="limit" class="form-select form-select-sm" style="width: auto;" onchange="this.form.submit()">
                            <option value="10" <%= pagination.limit === '10' ? 'selected' : '' %>>10</option>
                            <option value="25" <%= pagination.limit === '25' ? 'selected' : '' %>>25</option>
                            <option value="50" <%= pagination.limit === '50' ? 'selected' : '' %>>50</option>
                            <option value="100" <%= pagination.limit === '100' ? 'selected' : '' %>>100</option>
                            <option value="all" <%= pagination.limit === 'all' ? 'selected' : '' %>>Semua (<%= pagination.totalCount %>)</option>
                        </select>
                    </form>
                    <span class="small text-muted ms-2">
                        Menampilkan <strong><%= startItem %></strong> - <strong><%= endItem %></strong> dari <strong><%= pagination.totalCount %></strong> barang
                    </span>
                </div>

                <!-- Page Navigation Links -->
                <% if (pagination.limit !== 'all' && pagination.totalPages > 1) { %>
                    <nav aria-label="Navigasi Halaman">
                        <ul class="pagination pagination-sm mb-0">
                            <!-- Previous Page -->
                            <li class="page-item <%= pagination.page <= 1 ? 'disabled' : '' %>">
                                <% queryParams.set('page', pagination.page - 1); %>
                                <a class="page-link" href="/master/items?<%= queryParams.toString() %>">Sebelumnya</a>
                            </li>

                            <!-- Page Numbers -->
                            <% for (let p = 1; p <= pagination.totalPages; p++) { 
                                queryParams.set('page', p);
                            %>
                                <li class="page-item <%= p === pagination.page ? 'active' : '' %>">
                                    <a class="page-link" href="/master/items?<%= queryParams.toString() %>"><%= p %></a>
                                </li>
                            <% } %>

                            <!-- Next Page -->
                            <li class="page-item <%= pagination.page >= pagination.totalPages ? 'disabled' : '' %>">
                                <% queryParams.set('page', pagination.page + 1); %>
                                <a class="page-link" href="/master/items?<%= queryParams.toString() %>">Selanjutnya</a>
                            </li>
                        </ul>
                    </nav>
                <% } %>
            </div>
        <% } %>
    </div>
</div>

<!-- Modal Tambah Barang -->
<div class="modal fade" id="modalAddItem" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Tambah Katalog Barang / Material</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/master/items/create" method="POST">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tipe Kelompok Barang</label>
                        <select name="type" id="add_item_type" class="form-select" required onchange="onAddItemTypeChange()">
                            <option value="Material">Persediaan (Material / Habis Pakai)</option>
                            <option value="Aset">Barang Modal (Aset Tetap)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label fw-semibold mb-0">Kode Barang / SKU (Otomatis)</label>
                            <span class="badge bg-info-subtle text-info border">Penomoran Otomatis</span>
                        </div>
                        <input type="text" name="code" id="add_item_code" class="form-control fw-bold bg-light text-primary" required readonly>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nama Barang / Material</label>
                        <input type="text" name="name" class="form-control" placeholder="Contoh: Semen Gresik 50kg" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Satuan Standar</label>
                        <select name="unit_id" class="form-select" required>
                            <option value="">-- Pilih Satuan --</option>
                            <% units.forEach(u => { %>
                                <option value="<%= u.id %>"><%= u.name %> (<%= u.code %>)</option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Kategori Peruntukan</label>
                        <select name="category" id="add_item_category" class="form-select" required onchange="onAddItemCategoryChange()">
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Keterangan / Spesifikasi</label>
                        <textarea name="description" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-primary">Simpan Barang</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Edit Barang -->
<div class="modal fade" id="modalEditItem" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Edit Katalog Barang / Material</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="formEditItem" action="" method="POST">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tipe Kelompok</label>
                        <select id="edit_item_type" name="type" class="form-select" required onchange="onEditItemTypeChange()">
                            <option value="Material">Persediaan (Material / Habis Pakai)</option>
                            <option value="Aset">Barang Modal (Aset Tetap)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Kode Barang / SKU</label>
                        <input type="text" id="edit_item_code" name="code" class="form-control fw-bold" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nama Barang / Material</label>
                        <input type="text" id="edit_item_name" name="name" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Satuan Standar</label>
                        <select id="edit_item_unit_id" name="unit_id" class="form-select" required>
                            <option value="">-- Pilih Satuan --</option>
                            <% units.forEach(u => { %>
                                <option value="<%= u.id %>"><%= u.name %> (<%= u.code %>)</option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Kategori Peruntukan</label>
                        <select id="edit_item_category" name="category" class="form-select" required>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Keterangan / Spesifikasi</label>
                        <textarea id="edit_item_description" name="description" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-warning">Update Barang</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
const nextCodes = <%- JSON.stringify(nextCodes) %>;
const dbItemCategories = <%- typeof itemCategories !== 'undefined' ? JSON.stringify(itemCategories) : '[]' %>;

const assetCategories = [
    'Tanah & Lahan',
    'Bangunan & Infrastruktur',
    'Peralatan & Mesin',
    'Meubiler & Mebel',
    'Aset Tetap Lainnya'
];

const materialCategories = [
    'Bahan Bangunan',
    'Bahan & Alat Kebersihan',
    'Alat Tulis Kantor (ATK)',
    'Perlengkapan Dapur & Harian',
    'Material dan Bahan Lainnya'
];

function populateCategoryDropdown(selectId, itemType, selectedVal = null) {
    const select = document.getElementById(selectId);
    if (!select) return;
    select.innerHTML = '';

    let cats = [];
    if (dbItemCategories && dbItemCategories.length > 0) {
        cats = dbItemCategories.filter(c => c.type === itemType).map(c => ({
            name: c.name,
            code: c.account_code
        }));
    }
    
    if (cats.length === 0) {
        const defaultList = itemType === 'Aset' ? assetCategories : materialCategories;
        cats = defaultList.map(name => ({ name, code: '' }));
    }

    cats.forEach(cat => {
        const opt = document.createElement('option');
        opt.value = cat.name;
        opt.textContent = cat.code ? `${cat.code} - ${cat.name}` : cat.name;
        if (selectedVal && selectedVal === cat.name) {
            opt.selected = true;
        }
        select.appendChild(opt);
    });
}

function onAddItemCategoryChange() {
    const selectedCat = document.getElementById('add_item_category').value;
    if (nextCodes && nextCodes[selectedCat]) {
        document.getElementById('add_item_code').value = nextCodes[selectedCat];
    }
}

function onAddItemTypeChange() {
    const selectedType = document.getElementById('add_item_type').value;
    populateCategoryDropdown('add_item_category', selectedType);
    onAddItemCategoryChange();
}

function onEditItemTypeChange() {
    const selectedType = document.getElementById('edit_item_type').value;
    populateCategoryDropdown('edit_item_category', selectedType);
}

document.addEventListener('DOMContentLoaded', function() {
    onAddItemTypeChange();
});

const modalAddItem = document.getElementById('modalAddItem');
if (modalAddItem) {
    modalAddItem.addEventListener('shown.bs.modal', function () {
        onAddItemTypeChange();
    });
}

function editItem(itm) {
    document.getElementById('formEditItem').action = '/master/items/update/' + itm.id;
    document.getElementById('edit_item_code').value = itm.code;
    document.getElementById('edit_item_name').value = itm.name;
    document.getElementById('edit_item_type').value = itm.type;
    document.getElementById('edit_item_unit_id').value = itm.unit_id || '';
    populateCategoryDropdown('edit_item_category', itm.type, itm.category);
    document.getElementById('edit_item_description').value = itm.description || '';
    
    new bootstrap.Modal(document.getElementById('modalEditItem')).show();
}
</script>
