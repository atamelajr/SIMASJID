<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold text-dark mb-1">Profil Masjid & Struktur DKM</h4>
        <p class="text-muted small mb-0">Informasi Umum, Visi, Misi, Sejarah, dan Susunan Pengurus DKM.</p>
    </div>
</div>

<div class="row g-4">
    <!-- Profil umum card -->
    <div class="col-md-7">
        <div class="card card-custom p-3 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0"><i class="bi bi-bank text-primary me-2"></i>Informasi Umum</h5>
                </div>
                <form action="/profil/update" method="POST">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nama Masjid</label>
                        <input type="text" name="name" class="form-control" value="<%= profile.name || '' %>" <%= user.role_name !== 'Admin' ? 'readonly' : '' %>>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Alamat Lengkap</label>
                        <textarea name="address" class="form-control" rows="2" <%= user.role_name !== 'Admin' ? 'readonly' : '' %>><%= profile.address || '' %></textarea>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">No. Telepon / WA</label>
                            <input type="text" name="phone" class="form-control" value="<%= profile.phone || '' %>" <%= user.role_name !== 'Admin' ? 'readonly' : '' %>>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Email</label>
                            <input type="email" name="email" class="form-control" value="<%= profile.email || '' %>" <%= user.role_name !== 'Admin' ? 'readonly' : '' %>>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Visi</label>
                        <textarea name="vision" class="form-control" rows="2" <%= user.role_name !== 'Admin' ? 'readonly' : '' %>><%= profile.vision || '' %></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Misi</label>
                        <textarea name="mission" class="form-control" rows="3" <%= user.role_name !== 'Admin' ? 'readonly' : '' %>><%= profile.mission || '' %></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Sejarah Singkat</label>
                        <textarea name="history" class="form-control" rows="3" <%= user.role_name !== 'Admin' ? 'readonly' : '' %>><%= profile.history || '' %></textarea>
                    </div>
                    <% if (user.role_name === 'Admin') { %>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Simpan Perubahan Profil</button>
                    <% } %>
                </form>
            </div>
        </div>
    </div>

    <!-- DKM Structure Card -->
    <div class="col-md-5">
        <div class="card card-custom p-3 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0"><i class="bi bi-people-fill text-success me-2"></i>Struktur DKM</h5>
                    <% if (user.role_name === 'Admin') { %>
                        <button class="btn btn-sm btn-outline-success" data-bs-toggle="modal" data-bs-target="#modalAddDkm">
                            <i class="bi bi-plus-lg"></i> Tambah Anggota
                        </button>
                    <% } %>
                </div>

                <div class="list-group list-group-flush">
                    <% if (dkmMembers.length > 0) { %>
                        <% dkmMembers.forEach(m => { %>
                            <div class="list-group-item d-flex align-items-center gap-3 py-3">
                                <div class="bg-primary-subtle text-primary rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;">
                                    <i class="bi bi-person-badge fs-4"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark"><%= m.name %></div>
                                    <span class="badge bg-secondary"><%= m.position %></span>
                                    <% if (m.phone) { %>
                                        <div class="extra-small text-muted mt-1"><i class="bi bi-whatsapp me-1 text-success"></i><%= m.phone %></div>
                                    <% } %>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p class="text-muted small">Belum ada struktur DKM yang diinput.</p>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Add DKM -->
<div class="modal fade" id="modalAddDkm" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Tambah Anggota DKM</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/profil/dkm/add" method="POST">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nama Lengkap</label>
                        <input type="text" name="name" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Jabatan</label>
                        <input type="text" name="position" class="form-control" placeholder="Contoh: Ketua DKM / Bendahara" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">No. Telepon / WA</label>
                        <input type="text" name="phone" class="form-control">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-success">Simpan</button>
                </div>
            </form>
        </div>
    </div>
</div>
