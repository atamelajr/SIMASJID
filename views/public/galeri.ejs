<div class="bg-dark text-white py-5 mb-4" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);">
    <div class="container text-center">
        <h1 class="fw-extrabold display-5 mb-2"><i class="bi bi-camera text-warning me-2"></i> Galeri Dokumentasi Foto</h1>
        <p class="lead opacity-75 max-w-xl mx-auto">
            Dokumentasi foto kegiatan ibadah, fasilitas, dan momen kemasyarakatan di <%= masjidProfile.name || 'Masjid' %>.
        </p>
    </div>
</div>

<div class="container pb-5">
    <!-- Category Filter Bar -->
    <div class="d-flex flex-wrap justify-content-center align-items-center gap-2 mb-4">
        <button type="button" class="btn btn-sm rounded-pill btn-emerald px-3 fw-bold filter-btn active" data-filter="all" style="background-color: #0d9488; color: white;">Semua Dokumentasi</button>
        <button type="button" class="btn btn-sm rounded-pill btn-outline-secondary px-3 filter-btn" data-filter="Kegiatan">Kegiatan Ibadah & PHBI</button>
        <button type="button" class="btn btn-sm rounded-pill btn-outline-secondary px-3 filter-btn" data-filter="Fasilitas">Fasilitas Masjid</button>
        <button type="button" class="btn btn-sm rounded-pill btn-outline-secondary px-3 filter-btn" data-filter="Pembangunan">Pembangunan</button>
        <button type="button" class="btn btn-sm rounded-pill btn-outline-secondary px-3 filter-btn" data-filter="Kajian">Kajian & Pendidikan</button>
        <button type="button" class="btn btn-sm rounded-pill btn-outline-secondary px-3 filter-btn" data-filter="Bakti Social">Bakti Sosial</button>
    </div>

    <div class="row g-4" id="gallery-container">
        <% if (galleries && galleries.length > 0) { %>
            <% galleries.forEach((g, idx) => { %>
                <div class="col-lg-3 col-md-4 col-sm-6 gallery-item" data-category="<%= g.category %>">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white h-100 group-gallery">
                        <a href="#" data-bs-toggle="modal" data-bs-target="#modalGalleryZoom<%= idx %>" class="d-block overflow-hidden">
                            <img src="<%= g.image_url %>" class="card-img-top object-fit-cover hover-zoom" style="height: 200px; transition: transform 0.3s ease;" alt="<%= g.title %>" onerror="this.src='/images/hero-default.jpg'">
                        </a>
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="badge bg-light text-dark border small"><%= g.category %></span>
                                <% if (g.event_date) { %>
                                    <small class="text-muted extra-small"><i class="bi bi-calendar3 me-1"></i> <%= formatDate(g.event_date) %></small>
                                <% } %>
                            </div>
                            <h6 class="fw-bold text-dark m-0 text-truncate"><%= g.title %></h6>
                            <% if (g.description) { %>
                                <small class="text-muted d-block mt-1 text-truncate"><%= g.description %></small>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Modal Zoom Image -->
                <div class="modal fade" id="modalGalleryZoom<%= idx %>" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered modal-lg">
                        <div class="modal-content border-0 bg-dark text-white rounded-4 overflow-hidden shadow-lg">
                            <div class="modal-header border-0 bg-secondary bg-opacity-25 py-2">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-warning text-dark"><%= g.category %></span>
                                    <h5 class="modal-title fw-bold text-white mb-0 fs-6"><%= g.title %></h5>
                                </div>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body text-center p-3">
                                <img src="<%= g.image_url %>" class="img-fluid rounded-3 shadow" style="max-height: 70vh; object-fit: contain;" alt="<%= g.title %>">
                                <% if (g.description) { %>
                                    <div class="mt-3 text-start bg-secondary bg-opacity-10 p-3 rounded-3">
                                        <p class="mb-0 text-light small"><%= g.description %></p>
                                        <% if (g.event_date) { %>
                                            <small class="text-muted d-block mt-1"><i class="bi bi-calendar3 me-1"></i> Pelaksanaan: <%= formatDate(g.event_date) %></small>
                                        <% } %>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <div class="col-12 text-center py-5 bg-white rounded-4 shadow-sm text-muted">
                <i class="bi bi-images display-4 d-block mb-3"></i>
                <h5>Belum ada dokumentasi foto di galeri.</h5>
            </div>
        <% } %>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const filterBtns = document.querySelectorAll('.filter-btn');
        const items = document.querySelectorAll('.gallery-item');

        filterBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                filterBtns.forEach(b => {
                    b.classList.remove('active', 'btn-emerald');
                    b.classList.add('btn-outline-secondary');
                    b.style.backgroundColor = '';
                    b.style.color = '';
                });

                btn.classList.remove('btn-outline-secondary');
                btn.classList.add('active');
                btn.style.backgroundColor = '#0d9488';
                btn.style.color = 'white';

                const cat = btn.getAttribute('data-filter');
                items.forEach(item => {
                    if (cat === 'all' || item.getAttribute('data-category').includes(cat)) {
                        item.style.display = 'block';
                    } else {
                        item.style.display = 'none';
                    }
                });
            });
        });
    });
</script>
