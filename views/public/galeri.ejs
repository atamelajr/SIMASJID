<div class="bg-dark text-white py-5 mb-4" style="background: linear-gradient(135deg, #0f766e 0%, #042f2e 100%);">
    <div class="container text-center">
        <span class="badge bg-warning text-dark px-3 py-1.5 rounded-pill fw-bold mb-3 shadow-sm">
            <i class="bi bi-camera-fill me-1"></i> Dokumentasi Foto & Kegiatan
        </span>
        <h1 class="fw-extrabold display-5 mb-2">Album Galeri Masjid</h1>
        <p class="lead opacity-75 max-w-xl mx-auto mb-0" style="max-width: 650px;">
            Kumpulan album dokumentasi momen kegiatan ibadah, fasilitas, kajian, dan pembangunan di <%= masjidProfile.name || 'Masjid' %>.
        </p>
    </div>
</div>

<div class="container pb-5">
    <!-- Category Filter Bar -->
    <% 
        const counts = (typeof categoryCounts !== 'undefined' && categoryCounts) ? categoryCounts : {};
        const catList = [
            { key: 'all', label: 'Semua Album', count: counts['Semua'] || (albums ? albums.length : 0) },
            { key: 'Kegiatan', label: 'Kegiatan Ibadah & PHBI', count: counts['Kegiatan'] },
            { key: 'Fasilitas', label: 'Fasilitas Masjid', count: counts['Fasilitas'] },
            { key: 'Pembangunan', label: 'Pembangunan', count: counts['Pembangunan'] },
            { key: 'Kajian', label: 'Kajian & Pendidikan', count: counts['Kajian'] },
            { key: 'Bakti Social', label: 'Bakti Sosial', count: counts['Bakti Social'] }
        ];
    %>
    <div class="d-flex flex-wrap justify-content-center align-items-center gap-2 mb-4">
        <% catList.forEach((cat, idx) => { %>
            <button type="button" 
                    class="btn btn-sm rounded-pill px-3 fw-semibold filter-btn <%= idx === 0 ? 'active btn-emerald text-white' : 'btn-outline-secondary' %>" 
                    data-filter="<%= cat.key %>"
                    style="<%= idx === 0 ? 'background-color: #0d9488; color: white;' : '' %>">
                <%= cat.label %>
                <% if (cat.count !== undefined && cat.count !== null) { %>
                    <span class="badge <%= idx === 0 ? 'bg-white text-teal' : 'bg-light text-secondary border' %> ms-1 rounded-pill" style="<%= idx === 0 ? 'color: #0d9488;' : '' %>">
                        <%= cat.count %>
                    </span>
                <% } %>
            </button>
        <% }); %>
    </div>

    <!-- Album Cards Grid -->
    <div class="row g-4" id="albumGrid">
        <% if (albums && albums.length > 0) { %>
            <% albums.forEach(a => { %>
                <div class="col-xl-3 col-lg-4 col-md-6 album-grid-item" data-category="<%= a.category %>">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white h-100 d-flex flex-column album-card-hover transition-all">
                        <!-- Cover Image with Badges -->
                        <div class="position-relative overflow-hidden" style="height: 210px;">
                            <a href="/galeri/<%= a.slug %>" class="d-block w-100 h-100 text-decoration-none">
                                <img src="<%= a.cover_image || '/images/hero-default.jpg' %>" 
                                     class="w-100 h-100 object-fit-cover album-thumb-img" 
                                     alt="<%= a.title %>" 
                                     onerror="this.src='/images/hero-default.jpg'">
                            </a>
                            
                            <!-- Category Badge (Top-Left) -->
                            <div class="position-absolute top-0 start-0 p-2 z-1">
                                <span class="badge bg-dark bg-opacity-75 text-white backdrop-blur px-2.5 py-1.5 rounded-pill small fw-normal">
                                    <%= a.category %>
                                </span>
                            </div>

                            <!-- Photo Count Badge (Top-Right) -->
                            <div class="position-absolute top-0 end-0 p-2 z-1">
                                <span class="badge bg-warning text-dark shadow-sm px-2.5 py-1.5 rounded-pill fw-bold small">
                                    <i class="bi bi-images me-1"></i> <%= a.photo_count || 1 %> Foto
                                </span>
                            </div>
                        </div>

                        <!-- Card Content -->
                        <div class="card-body p-3 p-md-4 d-flex flex-column flex-grow-1">
                            <div class="d-flex align-items-center text-muted extra-small mb-2">
                                <i class="bi bi-calendar3 me-1.5 text-teal" style="color: #0d9488;"></i>
                                <span><%= formatDate(a.event_date || a.created_at) %></span>
                            </div>

                            <h5 class="fw-bold text-dark mb-2" style="font-size: 1.05rem; line-height: 1.4;">
                                <a href="/galeri/<%= a.slug %>" class="text-dark text-decoration-none hover-teal line-clamp-2" title="<%= a.title %>">
                                    <%= a.title %>
                                </a>
                            </h5>

                            <p class="text-secondary small mb-3 flex-grow-1 line-clamp-2" style="font-size: 0.85rem; line-height: 1.5;">
                                <%= (a.description || 'Kumpulan dokumentasi foto kegiatan dan momen masjid.').substring(0, 95) %>
                            </p>

                            <div class="pt-2 border-top mt-auto">
                                <a href="/galeri/<%= a.slug %>" class="btn btn-outline-teal btn-sm rounded-pill fw-semibold w-100 py-1.5" style="color: #0d9488; border-color: #0d9488;">
                                    Buka Album (<%= a.photo_count || 1 %> Foto) <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <div class="col-12 text-center py-5 bg-white rounded-4 shadow-sm text-muted">
                <i class="bi bi-images display-3 d-block mb-3 text-secondary opacity-50"></i>
                <h5 class="fw-bold text-dark mb-1">Belum Ada Album Foto Dokumentasi</h5>
                <p class="text-muted small">Dokumentasi foto kegiatan masjid akan segera ditampilkan di sini.</p>
            </div>
        <% } %>
    </div>

    <!-- Empty State Filter Feedback -->
    <div id="noFilterMatch" class="text-center py-5 bg-white rounded-4 shadow-sm text-muted d-none mt-4">
        <i class="bi bi-search display-4 d-block mb-2 text-secondary opacity-50"></i>
        <h5 class="fw-bold text-dark">Tidak ada album di kategori ini</h5>
        <p class="text-muted small mb-0">Silakan pilih kategori dokumentasi lainnya.</p>
    </div>
</div>

<style>
    .album-card-hover {
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }
    .album-card-hover:hover {
        transform: translateY(-5px);
        box-shadow: 0 14px 28px rgba(0,0,0,0.1) !important;
    }
    .album-thumb-img {
        transition: transform 0.4s ease;
    }
    .album-card-hover:hover .album-thumb-img {
        transform: scale(1.05);
    }
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .hover-teal:hover {
        color: #0d9488 !important;
    }
    .backdrop-blur {
        backdrop-filter: blur(4px);
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const filterBtns = document.querySelectorAll('.filter-btn');
        const items = document.querySelectorAll('.album-grid-item');
        const emptyAlert = document.getElementById('noFilterMatch');

        filterBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                filterBtns.forEach(b => {
                    b.classList.remove('active', 'btn-emerald', 'text-white');
                    b.classList.add('btn-outline-secondary');
                    b.style.backgroundColor = '';
                    b.style.color = '';
                    const badge = b.querySelector('.badge');
                    if (badge) {
                        badge.classList.remove('bg-white', 'text-teal');
                        badge.classList.add('bg-light', 'text-secondary', 'border');
                        badge.style.color = '';
                    }
                });

                btn.classList.remove('btn-outline-secondary');
                btn.classList.add('active', 'btn-emerald', 'text-white');
                btn.style.backgroundColor = '#0d9488';
                btn.style.color = 'white';
                const activeBadge = btn.querySelector('.badge');
                if (activeBadge) {
                    activeBadge.classList.remove('bg-light', 'text-secondary', 'border');
                    activeBadge.classList.add('bg-white');
                    activeBadge.style.color = '#0d9488';
                }

                const cat = btn.getAttribute('data-filter');
                let matchCount = 0;
                items.forEach(item => {
                    const itemCat = item.getAttribute('data-category') || '';
                    if (cat === 'all' || itemCat.includes(cat)) {
                        item.style.display = '';
                        matchCount++;
                    } else {
                        item.style.display = 'none';
                    }
                });

                if (matchCount === 0 && items.length > 0) {
                    emptyAlert.classList.remove('d-none');
                } else {
                    emptyAlert.classList.add('d-none');
                }
            });
        });
    });
</script>
