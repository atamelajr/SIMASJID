<div class="bg-dark text-white py-5 mb-5" style="background: linear-gradient(135deg, #0f766e 0%, #064e3b 100%);">
    <div class="container text-center">
        <h1 class="fw-extrabold display-5 mb-2"><i class="bi bi-newspaper text-warning me-2"></i> Berita & Artikel Dakwah</h1>
        <p class="lead opacity-75 max-w-xl mx-auto">
            Kumpulan artikel keislaman, kabar kegiatan jamaah, dan pengumuman resmi DKM <%= masjidProfile.name || 'Masjid' %>.
        </p>
    </div>
</div>

<div class="container pb-5">
    <div class="row g-4">
        <% if (articles && articles.length > 0) { %>
            <% articles.forEach(a => { %>
                <div class="col-lg-4 col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden bg-white">
                        <img src="<%= a.thumbnail || '/images/hero-default.jpg' %>" class="card-img-top object-fit-cover" style="height: 220px;" alt="<%= a.title %>">
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-emerald text-white px-3 py-1 rounded-pill small" style="background-color: #0d9488;"><%= a.category %></span>
                                <small class="text-muted"><i class="bi bi-calendar3 me-1"></i> <%= formatDate(a.created_at) %></small>
                            </div>
                            <h5 class="fw-bold text-dark mb-2"><%= a.title %></h5>
                            <p class="text-secondary small mb-4 flex-grow-1"><%= (a.summary || a.content.replace(/<[^>]*>?/gm, '')).substring(0, 120) %>...</p>
                            
                            <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                                <small class="text-muted"><i class="bi bi-person me-1"></i> <%= a.author_name %></small>
                                <a href="/berita/<%= a.slug %>" class="btn btn-outline-dark btn-sm rounded-pill px-3 fw-semibold">
                                    Baca <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <div class="col-12 text-center py-5 bg-white rounded-4 shadow-sm text-muted">
                <i class="bi bi-journal-x display-4 d-block mb-3"></i>
                <h5>Belum ada berita atau artikel yang diterbitkan.</h5>
            </div>
        <% } %>
    </div>
</div>
