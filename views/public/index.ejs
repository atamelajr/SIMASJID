<!-- Hero Section: Carousel Banners / Dynamic Slide -->
<% if (banners && banners.length > 0) { %>
    <div id="heroCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel" data-bs-interval="6000">
        <div class="carousel-indicators">
            <% banners.forEach((b, idx) => { %>
                <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="<%= idx %>" class="<%= idx === 0 ? 'active' : '' %>"></button>
            <% }); %>
        </div>

        <div class="carousel-inner">
            <% banners.forEach((b, idx) => { %>
                <div class="carousel-item <%= idx === 0 ? 'active' : '' %>" style="max-height: 520px;">
                    <div class="position-relative w-100 h-100" style="min-height: 440px;">
                        <img src="<%= b.image_url %>" class="d-block w-100 h-100 object-fit-cover filter-brightness" alt="<%= b.title %>" style="filter: brightness(0.45); height: 520px; object-fit: cover;" onerror="this.src='/images/hero-default.jpg'">
                        <div class="carousel-caption d-flex flex-column justify-content-center h-100 text-start px-md-5" style="top: 0; bottom: 0;">
                            <div class="container">
                                <div class="col-lg-8">
                                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold mb-3">
                                        <i class="bi bi-star-fill me-1"></i> <%= masjidProfile.name || 'SIMASJID' %>
                                    </span>
                                    <h1 class="display-4 fw-extrabold text-white mb-3 leading-tight"><%= b.title %></h1>
                                    <% if (b.subtitle) { %>
                                        <p class="lead text-white-50 mb-4 opacity-90 d-none d-sm-block"><%= b.subtitle %></p>
                                    <% } %>
                                    <% if (b.button_text && b.button_link) { %>
                                        <a href="<%= b.button_link %>" class="btn btn-emerald btn-lg px-4 fw-bold rounded-pill text-white shadow" style="background-color: #0d9488;">
                                            <%= b.button_text %> <i class="bi bi-arrow-right me-1"></i>
                                        </a>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>

        <% if (banners.length > 1) { %>
            <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
            </button>
        <% } %>
    </div>
<% } else { %>
    <!-- Fallback Default Hero -->
    <section class="py-5 text-white" style="background: linear-gradient(135deg, #0f766e 0%, #064e3b 100%);">
        <div class="container py-4">
            <div class="row align-items-center g-4">
                <div class="col-lg-7">
                    <span class="badge bg-amber text-dark px-3 py-2 rounded-pill fw-bold mb-3" style="background-color: #f59e0b;">
                        <i class="bi bi-geo-alt-fill me-1"></i> <%= masjidProfile.name || 'SIMASJID' %>
                    </span>
                    <h1 class="display-4 fw-extrabold mb-3">Selamat Datang di Portal Resmi <%= masjidProfile.name || 'Masjid SIMASJID' %></h1>
                    <p class="lead mb-4 opacity-90"><%= masjidProfile.address || 'Pusat ibadah, dakwah, dan pelayanan sosial kemasyarakatan.' %></p>
                    <div class="d-flex flex-wrap gap-3">
                        <a href="/proyek-donasi" class="btn btn-warning btn-lg px-4 fw-bold shadow-sm rounded-pill text-dark">
                            <i class="bi bi-heart-fill me-2 text-danger"></i> Salurkan Donasi
                        </a>
                        <a href="/jadwal-sholat" class="btn btn-outline-light btn-lg px-4 fw-semibold rounded-pill">
                            <i class="bi bi-clock-fill me-2"></i> Jadwal Sholat Realtime
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
<% } %>

<!-- Widget Jadwal Sholat & Countdown Hari Ini -->
<section class="py-4 bg-white border-bottom shadow-sm">
    <div class="container">
        <div class="row align-items-center g-3">
            <div class="col-lg-3 col-md-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle p-3 bg-teal-subtle text-teal" style="background-color: #ccfbf1; color: #0f766e;">
                        <i class="bi bi-moon-stars-fill fs-3"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark fs-5">Waktu Sholat</div>
                        <div class="small text-muted" id="current-date-badge">-</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-9 col-md-8">
                <div class="row text-center g-2" id="prayer-times-widget">
                    <div class="col">
                        <div class="p-2 rounded bg-light border">
                            <div class="extra-small text-muted fw-bold">SUBUH</div>
                            <div class="fw-extrabold text-teal fs-5" id="time-subuh">04:35</div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="p-2 rounded bg-light border">
                            <div class="extra-small text-muted fw-bold">DZUHUR</div>
                            <div class="fw-extrabold text-teal fs-5" id="time-dzuhur">11:54</div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="p-2 rounded bg-light border">
                            <div class="extra-small text-muted fw-bold">ASHAR</div>
                            <div class="fw-extrabold text-teal fs-5" id="time-ashar">15:10</div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="p-2 rounded bg-light border">
                            <div class="extra-small text-muted fw-bold">MAGHRIB</div>
                            <div class="fw-extrabold text-teal fs-5" id="time-maghrib">17:56</div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="p-2 rounded bg-light border">
                            <div class="extra-small text-muted fw-bold">ISYA</div>
                            <div class="fw-extrabold text-teal fs-5" id="time-isya">19:05</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Ringkasan Kas & Transparansi -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="text-center max-w-2xl mx-auto mb-5">
            <span class="text-emerald fw-bold text-uppercase tracking-wider" style="color: #0d9488;">Akuntabilitas Umat</span>
            <h2 class="fw-bold text-slate-800">Transparansi Keuangan Masjid</h2>
            <p class="text-muted">Setiap rupiah donasi jamaah dikelola secara transparan dan dipertanggungjawabkan.</p>
        </div>

        <div class="row g-4">
            <div class="col-lg-4 col-md-6">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-4 border-start border-4 bg-white" style="border-color: #0d9488 !important;">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="text-muted fw-semibold">Total Saldo Kas</span>
                        <div class="rounded-circle p-3 bg-teal-subtle text-teal" style="background-color: #ccfbf1; color: #0f766e;">
                            <i class="bi bi-wallet2 fs-4"></i>
                        </div>
                    </div>
                    <h3 class="fw-extrabold mb-1" style="color: #0f766e;"><%= formatRupiah(summary.totalSaldo) %></h3>
                    <div class="small text-muted">Saldo terkonsolidasi seluruh rekening DKM</div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-4 border-start border-4 border-success bg-white">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="text-muted fw-semibold">Infaq & Donasi Bulan Ini</span>
                        <div class="rounded-circle p-3 bg-success-subtle text-success">
                            <i class="bi bi-arrow-down-left-circle fs-4"></i>
                        </div>
                    </div>
                    <h3 class="fw-extrabold mb-1 text-success"><%= formatRupiah(summary.totalPenerimaanBulanIni) %></h3>
                    <div class="small text-muted">Total pemasukan kas operasional & ZIS</div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-4 border-start border-4 border-danger bg-white">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="text-muted fw-semibold">Pengeluaran Bulan Ini</span>
                        <div class="rounded-circle p-3 bg-danger-subtle text-danger">
                            <i class="bi bi-arrow-up-right-circle fs-4"></i>
                        </div>
                    </div>
                    <h3 class="fw-extrabold mb-1 text-danger"><%= formatRupiah(summary.totalPengeluaranBulanIni) %></h3>
                    <div class="small text-muted">Biaya operasional, kajian, & pemeliharaan</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Section Berita & Artikel Terbaru -->
<% if (articles && articles.length > 0) { %>
<section class="py-5 bg-white">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <span class="badge bg-primary-subtle text-primary border border-primary px-3 py-1 rounded-pill fw-bold mb-2">Kabar & Informasi</span>
                <h2 class="fw-bold m-0">Berita & Artikel Dakwah</h2>
            </div>
            <a href="/berita" class="btn btn-outline-primary rounded-pill px-3 fw-semibold">
                Semua Berita <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="row g-4">
            <% articles.forEach(a => { %>
                <div class="col-lg-4 col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden bg-white">
                        <img src="<%= a.thumbnail || '/images/hero-default.jpg' %>" class="card-img-top object-fit-cover" style="height: 200px;" alt="<%= a.title %>">
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-light text-dark border small"><%= a.category %></span>
                                <small class="text-muted"><i class="bi bi-calendar3 me-1"></i> <%= formatDate(a.created_at) %></small>
                            </div>
                            <h5 class="fw-bold text-dark mb-2 text-truncate" title="<%= a.title %>"><%= a.title %></h5>
                            <p class="text-secondary small mb-4 flex-grow-1"><%= (a.summary || a.content.replace(/<[^>]*>?/gm, '')).substring(0, 100) %>...</p>
                            <a href="/berita/<%= a.slug %>" class="btn btn-outline-teal btn-sm rounded-pill fw-semibold" style="color: #0f766e; border-color: #0f766e;">
                                Baca Selengkapnya <i class="bi bi-chevron-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>
</section>
<% } %>

<!-- Section Galeri Foto Dokumentasi -->
<% if (galleries && galleries.length > 0) { %>
<section class="py-5 bg-light">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <span class="badge bg-success-subtle text-success border border-success px-3 py-1 rounded-pill fw-bold mb-2">Dokumentasi</span>
                <h2 class="fw-bold m-0">Galeri Foto Kegiatan Masjid</h2>
            </div>
            <a href="/galeri" class="btn btn-emerald text-white rounded-pill px-3 fw-semibold" style="background-color: #0d9488;">
                Lihat Galeri Lengkap <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="row g-4">
            <% galleries.forEach(g => { %>
                <div class="col-lg-3 col-md-4 col-6">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                        <img src="<%= g.image_url %>" class="card-img-top object-fit-cover" style="height: 180px;" alt="<%= g.title %>">
                        <div class="card-body p-3">
                            <span class="badge bg-light text-dark border small mb-1"><%= g.category %></span>
                            <h6 class="fw-bold text-dark m-0 text-truncate" title="<%= g.title %>"><%= g.title %></h6>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>
</section>
<% } %>

<!-- Google Maps Section -->
<% if (masjidProfile.maps_embed) { %>
<section class="py-5 bg-white">
    <div class="container">
        <div class="text-center mb-4">
            <h3 class="fw-bold text-slate-800"><i class="bi bi-geo-alt text-danger me-2"></i> Lokasi <%= masjidProfile.name || 'Masjid' %></h3>
            <p class="text-muted"><%= masjidProfile.address %></p>
        </div>
        <div class="rounded-4 overflow-hidden shadow-sm border border-2">
            <%- masjidProfile.maps_embed %>
        </div>
    </div>
</section>
<% } %>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const dateOptions = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
        document.getElementById('current-date-badge').innerText = new Date().toLocaleDateString('id-ID', dateOptions);

        const prayerCity = encodeURIComponent('<%= masjidProfile.prayer_city || "Jakarta" %>');
        const prayerCountry = encodeURIComponent('<%= masjidProfile.prayer_country || "Indonesia" %>');
        const calcMethod = '<%= masjidProfile.calculation_method || 20 %>';
        const subuhOffset = parseInt('<%= masjidProfile.subuh_offset || 0 %>');
        const dzuhurOffset = parseInt('<%= masjidProfile.dzuhur_offset || 0 %>');
        const asharOffset = parseInt('<%= masjidProfile.ashar_offset || 0 %>');
        const maghribOffset = parseInt('<%= masjidProfile.maghrib_offset || 0 %>');
        const isyaOffset = parseInt('<%= masjidProfile.isya_offset || 0 %>');

        function adjustTime(timeStr, offset) {
            if (!timeStr || !offset) return timeStr;
            const [h, m] = timeStr.split(':').map(Number);
            const d = new Date();
            d.setHours(h, m + offset, 0);
            return String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0');
        }

        fetch(`https://api.aladhan.com/v1/timingsByCity?city=${prayerCity}&country=${prayerCountry}&method=${calcMethod}`)
            .then(res => res.json())
            .then(data => {
                if (data && data.data && data.data.timings) {
                    const t = data.data.timings;
                    const subuh = adjustTime(t.Fajr, subuhOffset);
                    const dzuhur = adjustTime(t.Dhuhr, dzuhurOffset);
                    const ashar = adjustTime(t.Asr, asharOffset);
                    const maghrib = adjustTime(t.Maghrib, maghribOffset);
                    const isya = adjustTime(t.Isha, isyaOffset);

                    document.getElementById('time-subuh').innerText = subuh;
                    document.getElementById('time-dzuhur').innerText = dzuhur;
                    document.getElementById('time-ashar').innerText = ashar;
                    document.getElementById('time-maghrib').innerText = maghrib;
                    document.getElementById('time-isya').innerText = isya;
                }
            }).catch(err => console.log(err));
    });
</script>
