<!-- Hero Section -->
<section class="py-5 text-white" style="background: linear-gradient(135deg, #0f766e 0%, #064e3b 100%);">
    <div class="container py-4">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <span class="badge bg-amber text-dark px-3 py-2 rounded-pill fw-bold mb-3" style="background-color: #f59e0b;">
                    <i class="bi bi-geo-alt-fill me-1"></i> <%= masjidProfile.name || 'SIMASJID' %>
                </span>
                <h1 class="display-4 fw-extrabold mb-3">Selamat Datang di Portal Resmi <%= masjidProfile.name || 'Masjid SIMASJID' %></h1>
                <p class="lead mb-4 opacity-90">
                    <%= masjidProfile.address || 'Pusat ibadah, dakwah, dan pelayanan sosial kemasyarakatan.' %>
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a href="/proyek-donasi" class="btn btn-warning btn-lg px-4 fw-bold shadow-sm rounded-pill text-dark">
                        <i class="bi bi-heart-fill me-2 text-danger"></i> Salurkan Donasi
                    </a>
                    <a href="/jadwal-sholat" class="btn btn-outline-light btn-lg px-4 fw-semibold rounded-pill">
                        <i class="bi bi-clock-fill me-2"></i> Jadwal Sholat Realtime
                    </a>
                </div>
            </div>
            <div class="col-lg-5">
                <!-- Card Jadwal Sholat Hari Ini -->
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden text-dark bg-white">
                    <div class="card-header bg-dark text-white p-3 d-flex justify-content-between align-items-center">
                        <div class="fw-bold"><i class="bi bi-moon-stars-fill text-warning me-2"></i> Waktu Sholat Hari Ini</div>
                        <small class="badge bg-emerald text-white px-2 py-1" style="background-color: #0d9488;" id="current-date-badge">-</small>
                    </div>
                    <div class="card-body p-3">
                        <div class="row text-center g-2" id="prayer-times-widget">
                            <div class="col-4">
                                <div class="p-2 rounded bg-light border">
                                    <div class="small text-muted fw-bold">SUBUH</div>
                                    <div class="fs-5 fw-extrabold text-teal" id="time-subuh">04:35</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 rounded bg-light border">
                                    <div class="small text-muted fw-bold">DZUHUR</div>
                                    <div class="fs-5 fw-extrabold text-teal" id="time-dzuhur">11:54</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 rounded bg-light border">
                                    <div class="small text-muted fw-bold">ASHAR</div>
                                    <div class="fs-5 fw-extrabold text-teal" id="time-ashar">15:10</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 rounded bg-light border">
                                    <div class="small text-muted fw-bold">MAGHRIB</div>
                                    <div class="fs-5 fw-extrabold text-teal" id="time-maghrib">17:56</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 rounded bg-light border">
                                    <div class="small text-muted fw-bold">ISYA</div>
                                    <div class="fs-5 fw-extrabold text-teal" id="time-isya">19:05</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 rounded bg-amber-subtle border border-warning">
                                    <div class="small text-warning-emphasis fw-bold">NEXT SHOLAT</div>
                                    <div class="fs-6 fw-bold text-dark" id="next-prayer-name">--:--</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-light text-center small text-muted py-2">
                        <i class="bi bi-info-circle me-1"></i> Sinkronisasi otomatis DKI Jakarta & Sekitarnya
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Ringkasan Kas & Transparansi -->
<section class="py-5 bg-white">
    <div class="container">
        <div class="text-center max-w-2xl mx-auto mb-5">
            <span class="text-emerald fw-bold text-uppercase tracking-wider" style="color: #0d9488;">Akuntabilitas Umat</span>
            <h2 class="fw-bold text-slate-800">Transparansi Keuangan Masjid</h2>
            <p class="text-muted">Setiap rupiah donasi jamaah dikelola secara transparan dan dipertanggungjawabkan.</p>
        </div>

        <div class="row g-4">
            <div class="col-lg-4 col-md-6">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-4 border-start border-4" style="border-color: #0d9488 !important;">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="text-muted fw-semibold">Total Saldo Kas</span>
                        <div class="rounded-circle p-3 bg-teal-subtle text-teal" style="background-color: #ccfbf1; color: #0f766e;">
                            <i class="bi bi-wallet2 fs-4"></i>
                        </div>
                    </div>
                    <h3 class="fw-extrabold mb-1" style="color: #0f766e;"><%= formatRupiah(summary.totalSaldo) %></h3>
                    <div class="small text-muted">Saldo terkonsolidasi seluruh rekening DKM</div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-4 border-start border-4 border-success">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="text-muted fw-semibold">Infaq & Donasi Bulan Ini</span>
                        <div class="rounded-circle p-3 bg-success-subtle text-success">
                            <i class="bi bi-arrow-down-left-circle fs-4"></i>
                        </div>
                    </div>
                    <h3 class="fw-extrabold mb-1 text-success"><%= formatRupiah(summary.totalPenerimaanBulanIni) %></h3>
                    <div class="small text-muted">Total pemasukan kas operasional & ZIS</div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-4 border-start border-4 border-danger">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="text-muted fw-semibold">Pengeluaran Bulan Ini</span>
                        <div class="rounded-circle p-3 bg-danger-subtle text-danger">
                            <i class="bi bi-arrow-up-right-circle fs-4"></i>
                        </div>
                    </div>
                    <h3 class="fw-extrabold mb-1 text-danger"><%= formatRupiah(summary.totalPengeluaranBulanIni) %></h3>
                    <div class="small text-muted">Biaya operasional, kajian, & pemeliharaan</div>
                </div>
            </div>
        </div>

        <div class="text-center mt-4">
            <a href="/transparansi" class="btn btn-outline-dark rounded-pill px-4 fw-semibold">
                Lihat Laporan Mutasi Kas Lengkap <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
    </div>
</section>

<!-- Proyek Pembangunan / Penggalangan Dana Aktif -->
<% if (projects && projects.length > 0) { %>
<section class="py-5 bg-light">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <span class="badge bg-warning text-dark px-3 py-1 rounded-pill fw-bold mb-2">Program Kebajikan</span>
                <h2 class="fw-bold m-0">Proyek & Penggalangan Dana Masjid</h2>
            </div>
            <a href="/proyek-donasi" class="btn btn-emerald text-white fw-semibold rounded-pill px-3" style="background-color: #0d9488;">
                Semua Proyek <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="row g-4">
            <% projects.slice(0, 3).forEach(project => { %>
                <div class="col-lg-4 col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-info-subtle text-info-emphasis rounded-pill px-3 py-1 fw-semibold"><%= project.status %></span>
                                <small class="text-muted"><i class="bi bi-calendar3 me-1"></i> Target: <%= formatDate(project.target_date) %></small>
                            </div>
                            <h5 class="fw-bold mb-3"><%= project.title %></h5>
                            <p class="text-secondary small mb-4 flex-grow-1">Target Anggaran: <strong><%= formatRupiah(project.target_budget) %></strong></p>

                            <div class="mb-3">
                                <div class="d-flex justify-content-between small fw-bold mb-1">
                                    <span>Progress Pengerjaan</span>
                                    <span class="text-emerald" style="color: #0d9488;"><%= project.current_percentage %>%</span>
                                </div>
                                <div class="progress" style="height: 10px;">
                                    <div class="progress-bar bg-success" role="progressbar" style="width: <%= project.current_percentage %>%;"></div>
                                </div>
                            </div>

                            <a href="/proyek-donasi#project-<%= project.id %>" class="btn btn-outline-success btn-sm w-100 rounded-pill fw-semibold">
                                Detail & Salurkan Donasi
                            </a>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>
</section>
<% } %>

<!-- Struktur DKM & Pengurus -->
<% if (dkmMembers && dkmMembers.length > 0) { %>
<section class="py-5 bg-white">
    <div class="container">
        <div class="text-center max-w-2xl mx-auto mb-5">
            <h2 class="fw-bold">Pengurus DKM <%= masjidProfile.name || 'Masjid' %></h2>
            <p class="text-muted">Pengabdi dan pelayan umat yang amanah dalam mengelola kegiatan masjid.</p>
        </div>

        <div class="row g-4 justify-content-center">
            <% dkmMembers.forEach(member => { %>
                <div class="col-lg-3 col-md-4 col-6">
                    <div class="card border-0 shadow-sm rounded-4 text-center p-3 h-100">
                        <div class="mb-3 mx-auto" style="width: 90px; height: 90px;">
                            <img src="<%= member.photo || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(member.name) + '&background=0d9488&color=fff' %>" 
                                 class="rounded-circle img-fluid w-100 h-100 object-fit-cover border border-3 border-emerald" alt="<%= member.name %>">
                        </div>
                        <h6 class="fw-bold mb-1 text-slate-800"><%= member.name %></h6>
                        <span class="badge bg-light text-emerald border border-teal rounded-pill px-3 py-1 small" style="color: #0f766e;"><%= member.position %></span>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>
</section>
<% } %>

<!-- JavaScript untuk Live Widget Jadwal Sholat -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const dateOptions = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
        document.getElementById('current-date-badge').innerText = new Date().toLocaleDateString('id-ID', dateOptions);

        // Fetch Jadwal Sholat dari API publik (Aladhan / Kemenag)
        fetch('https://api.aladhan.com/v1/timingsByCity?city=Jakarta&country=Indonesia&method=2')
            .then(res => res.json())
            .then(data => {
                if (data && data.data && data.data.timings) {
                    const t = data.data.timings;
                    document.getElementById('time-subuh').innerText = t.Fajr;
                    document.getElementById('time-dzuhur').innerText = t.Dhuhr;
                    document.getElementById('time-ashar').innerText = t.Asr;
                    document.getElementById('time-maghrib').innerText = t.Maghrib;
                    document.getElementById('time-isya').innerText = t.Isha;

                    // Hitung next sholat
                    const now = new Date();
                    const currentMinutes = now.getHours() * 60 + now.getMinutes();
                    const parseMins = (str) => {
                        const [h, m] = str.split(':').map(Number);
                        return h * 60 + m;
                    };

                    const list = [
                        { name: 'Subuh', time: t.Fajr, mins: parseMins(t.Fajr) },
                        { name: 'Dzuhur', time: t.Dhuhr, mins: parseMins(t.Dhuhr) },
                        { name: 'Ashar', time: t.Asr, mins: parseMins(t.Asr) },
                        { name: 'Maghrib', time: t.Maghrib, mins: parseMins(t.Maghrib) },
                        { name: 'Isya', time: t.Isha, mins: parseMins(t.Isha) }
                    ];

                    let next = list.find(item => item.mins > currentMinutes) || list[0];
                    document.getElementById('next-prayer-name').innerText = `${next.name} (${next.time})`;
                }
            })
            .catch(err => console.log('Error fetching prayer times:', err));
    });
</script>
