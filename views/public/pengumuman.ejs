<div class="bg-dark text-white py-5 mb-5" style="background: linear-gradient(135deg, #0f766e 0%, #064e3b 100%);">
    <div class="container text-center">
        <h1 class="fw-extrabold display-5 mb-2"><i class="bi bi-megaphone text-warning me-2"></i> Pengumuman Masjid</h1>
        <p class="lead opacity-75 max-w-xl mx-auto">
            Informasi pengumuman penting, imbauan, dan jadwal kegiatan jamaah <%= masjidProfile.name || 'Masjid' %>.
        </p>
    </div>
</div>

<div class="container pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <% if (announcements && announcements.length > 0) { %>
                <% announcements.forEach(a => { %>
                    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white border-start border-5 <%= a.type === 'Penting' ? 'border-danger' : 'border-emerald' %>" style="<%= a.type !== 'Penting' ? 'border-color: #0d9488 !important;' : '' %>">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge <%= a.type === 'Penting' ? 'bg-danger' : 'bg-emerald text-white' %> px-3 py-1 rounded-pill" style="<%= a.type !== 'Penting' ? 'background-color: #0d9488;' : '' %>"><%= a.type %></span>
                            <small class="text-muted"><i class="bi bi-clock me-1"></i> <%= formatDate(a.created_at) %></small>
                        </div>
                        <h4 class="fw-bold text-slate-800 mb-2"><%= a.title %></h4>
                        <p class="text-secondary leading-relaxed m-0"><%= a.content %></p>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white text-muted">
                    <i class="bi bi-check-circle display-3 text-success mb-3"></i>
                    <h5>Saat ini belum ada pengumuman khusus.</h5>
                </div>
            <% } %>
        </div>
    </div>
</div>
