<div class="container-fluid p-4">
    <!-- Header Cetak Resmi (Hanya Tampil Saat Print) -->
    <div class="print-header">
        <h3 class="fw-bold mb-1">MASJID AL-IKHLAS</h3>
        <h5 class="fw-bold text-uppercase mb-1">LAPORAN STOK PERSEDIAAN & MATERIAL HABIS PAKAI</h5>
        <p class="mb-0 text-muted">Per Tanggal: <%= formatDate(new Date()) %></p>
        <hr style="border-top: 2px double #000;" class="my-2">
    </div>

    <!-- Header & Action Buttons -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 no-print">
        <div>
            <h4 class="fw-bold mb-1 text-dark"><i class="bi bi-boxes text-primary me-2"></i>Laporan Persediaan / Material</h4>
            <p class="text-muted small mb-0">Rincian stok barang persediaan habis pakai (Semen, Pasir, Cat, Sabun, dll.), akumulasi masuk/keluar, serta sisa stok tersedia.</p>
        </div>
        <div class="d-flex gap-2 mt-2 mt-md-0">
            <button onclick="window.print()" class="btn btn-outline-primary btn-print shadow-sm">
                <i class="bi bi-printer me-1"></i> Cetak Laporan / PDF
            </button>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card card-custom mb-4 no-print">
        <div class="card-body">
            <form action="/laporan/persediaan" method="GET" class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label small fw-semibold">Pencarian Nama Barang / Kode</label>
                    <input type="text" name="search" class="form-control form-control-sm" placeholder="Cari nama material..." value="<%= search %>">
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-semibold">Kategori Material</label>
                    <select name="category" class="form-select form-select-sm">
                        <option value="">-- Semua Kategori --</option>
                        <option value="Bahan Bangunan" <%= selectedCategory === 'Bahan Bangunan' ? 'selected' : '' %>>Bahan Bangunan</option>
                        <option value="Bahan & Alat Kebersihan" <%= selectedCategory === 'Bahan & Alat Kebersihan' ? 'selected' : '' %>>Bahan & Alat Kebersihan</option>
                        <option value="Alat Tulis Kantor (ATK)" <%= selectedCategory === 'Alat Tulis Kantor (ATK)' ? 'selected' : '' %>>Alat Tulis Kantor (ATK)</option>
                        <option value="Perlengkapan Dapur & Harian" <%= selectedCategory === 'Perlengkapan Dapur & Harian' ? 'selected' : '' %>>Perlengkapan Dapur & Harian</option>
                        <option value="Material dan Bahan Lainnya" <%= selectedCategory === 'Material dan Bahan Lainnya' ? 'selected' : '' %>>Material dan Bahan Lainnya</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-sm flex-fill">
                        <i class="bi bi-filter me-1"></i> Filter Data
                    </button>
                    <a href="/laporan/persediaan" class="btn btn-light btn-sm border">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Inventory Stock Table -->
    <div class="card card-custom mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0 text-dark">Daftar Stok Persediaan Material Available</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 120px;">Kode Barang</th>
                            <th>Nama Barang Material</th>
                            <th>Satuan</th>
                            <th>Kategori</th>
                            <th class="text-end">Total Masuk</th>
                            <th class="text-end">Total Keluar</th>
                            <th class="text-end">Sisa Stok Saat Ini</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (items.length > 0) { %>
                            <% items.forEach(item => { %>
                                <tr>
                                    <td><span class="badge bg-secondary-subtle text-dark border font-monospace"><%= item.item_code %></span></td>
                                    <td class="fw-bold text-dark"><%= item.name %></td>
                                    <td><span class="badge bg-light text-dark border"><%= item.unit %></span></td>
                                    <td><span class="badge bg-info-subtle text-info border border-info"><%= item.category %></span></td>
                                    <td class="text-end font-monospace text-success fw-semibold">+ <%= item.total_masuk %></td>
                                    <td class="text-end font-monospace text-danger fw-semibold">- <%= item.total_keluar %></td>
                                    <td class="text-end font-monospace fw-bold fs-6 text-primary"><%= item.stock %> <%= item.unit %></td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">Belum ada barang persediaan material.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Inventory Logs Table -->
    <div class="card card-custom">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0 text-dark">Riwayat Log Mutasi Keluar & Masuk Persediaan</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 160px;">Waktu Input</th>
                            <th>Nama Barang Material</th>
                            <th>Tipe Mutasi</th>
                            <th class="text-end">Jumlah (Qty)</th>
                            <th>Catatan / Keterangan</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (logs.length > 0) { %>
                            <% logs.forEach(log => { %>
                                <tr>
                                    <td class="small text-muted"><%= new Date(log.created_at).toLocaleString('id-ID') %></td>
                                    <td class="fw-bold text-dark"><%= log.item_name %></td>
                                    <td>
                                        <% if (log.type === 'Masuk') { %>
                                            <span class="badge bg-success-subtle text-success border border-success"><i class="bi bi-arrow-down-left me-1"></i>Masuk</span>
                                        <% } else { %>
                                            <span class="badge bg-danger-subtle text-danger border border-danger"><i class="bi bi-arrow-up-right me-1"></i>Keluar</span>
                                        <% } %>
                                    </td>
                                    <td class="text-end font-monospace fw-bold <%= log.type === 'Masuk' ? 'text-success' : 'text-danger' %>">
                                        <%= log.type === 'Masuk' ? '+' : '-' %> <%= log.qty %> <%= log.unit %>
                                    </td>
                                    <td class="small text-secondary"><%= log.notes || '-' %></td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="text-center text-muted py-3">Belum ada log mutasi persediaan.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
