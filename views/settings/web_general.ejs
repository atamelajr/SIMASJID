<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="bi bi-globe me-2 text-primary"></i> Pengaturan Umum & Logo Web</h4>
            <p class="text-muted small m-0">Kelola identitas website, logo, kontak, media sosial, & running text.</p>
        </div>
        <a href="/" target="_blank" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-box-arrow-up-right me-1"></i> Lihat Halaman Publik
        </a>
    </div>

    <% if (typeof successMsg !== 'undefined' && successMsg) { %>
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> <%= successMsg %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>
    <% if (typeof errorMsg !== 'undefined' && errorMsg) { %>
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= errorMsg %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <form action="/settings/web/general" method="POST" enctype="multipart/form-data">
        <div class="row g-4">
            <!-- Identitas & Logo -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-3 p-4 bg-white mb-4">
                    <h5 class="fw-bold mb-3 border-bottom pb-2 text-dark"><i class="bi bi-building me-2 text-primary"></i> Identitas & Branding</h5>
                    
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nama Masjid / Lembaga</label>
                        <input type="text" name="name" class="form-control" value="<%= profile.name || '' %>" required>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Logo Website</label>
                            <% if (profile.logo) { %>
                                <div class="mb-2">
                                    <img src="<%= profile.logo %>" alt="Logo" height="50" class="img-thumbnail">
                                </div>
                            <% } %>
                            <input type="file" name="logo" class="form-control" accept="image/*">
                            <small class="text-muted">Format PNG/JPG max 2MB (Background Transparan disarankan)</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Favicon Icon</label>
                            <% if (profile.favicon) { %>
                                <div class="mb-2">
                                    <img src="<%= profile.favicon %>" alt="Favicon" height="32" class="img-thumbnail">
                                </div>
                            <% } %>
                            <input type="file" name="favicon" class="form-control" accept="image/*">
                            <small class="text-muted">Icon Tab Browser (32x32 px)</small>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Alamat Lengkap</label>
                        <textarea name="address" class="form-control" rows="2"><%= profile.address || '' %></textarea>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">No. Telepon / Pengurus</label>
                            <input type="text" name="phone" class="form-control" value="<%= profile.phone || '' %>">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Email Resmi</label>
                            <input type="email" name="email" class="form-control" value="<%= profile.email || '' %>">
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-3 p-4 bg-white">
                    <h5 class="fw-bold mb-3 border-bottom pb-2 text-dark"><i class="bi bi-broadcast me-2 text-primary"></i> Running Text Pengumuman</h5>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Teks Berjalan di Header Publik</label>
                        <textarea name="running_text" class="form-control" rows="3" placeholder="Tuliskan teks pengumuman yang akan berjalan di bagian atas website..."><%= profile.running_text || '' %></textarea>
                    </div>
                </div>
            </div>

            <!-- Media Sosial & Visi Misi -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-3 p-4 bg-white mb-4">
                    <h5 class="fw-bold mb-3 border-bottom pb-2 text-dark"><i class="bi bi-clock-history me-2 text-primary"></i> Pengaturan Wilayah Sholat & Zona Waktu</h5>
                    
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Kota / Kabupaten</label>
                            <input type="text" name="prayer_city" class="form-control" placeholder="Aceh Tamiang / Jakarta / Medan / Surabaya" value="<%= profile.prayer_city || 'Jakarta' %>" required>
                            <small class="text-muted">Nama kota/kabupaten untuk pencarian jadwal sholat</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Negara</label>
                            <input type="text" name="prayer_country" class="form-control" value="<%= profile.prayer_country || 'Indonesia' %>" required>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Zona Waktu (Timezone)</label>
                            <select name="timezone" class="form-select">
                                <option value="Asia/Jakarta" <%= (profile.timezone === 'Asia/Jakarta' || !profile.timezone) ? 'selected' : '' %>>WIB - Asia/Jakarta (GMT+7)</option>
                                <option value="Asia/Makassar" <%= profile.timezone === 'Asia/Makassar' ? 'selected' : '' %>>WITA - Asia/Makassar (GMT+8)</option>
                                <option value="Asia/Jayapura" <%= profile.timezone === 'Asia/Jayapura' ? 'selected' : '' %>>WIT - Asia/Jayapura (GMT+9)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Metode Perhitungan Sholat</label>
                            <select name="calculation_method" class="form-select">
                                <option value="20" <%= (profile.calculation_method == 20 || !profile.calculation_method) ? 'selected' : '' %>>Kemenag Indonesia (SIHAT)</option>
                                <option value="11" <%= profile.calculation_method == 11 ? 'selected' : '' %>>Majelis Ugama Islam Singapura (MUIS)</option>
                                <option value="3" <%= profile.calculation_method == 3 ? 'selected' : '' %>>Muslim World League (MWL)</option>
                                <option value="4" <%= profile.calculation_method == 4 ? 'selected' : '' %>>Umm Al-Qura University, Makkah</option>
                                <option value="2" <%= profile.calculation_method == 2 ? 'selected' : '' %>>Islamic Society of North America (ISNA)</option>
                            </select>
                        </div>
                    </div>

                    <label class="form-label fw-semibold text-dark border-top pt-2 mt-2 w-100">Koreksi Penyesuaian Menit Sholat (+/- Menit)</label>
                    <div class="row g-2 text-center">
                        <div class="col">
                            <small class="fw-bold d-block text-muted">SUBUH</small>
                            <input type="number" name="subuh_offset" class="form-control form-control-sm text-center" value="<%= profile.subuh_offset || 0 %>">
                        </div>
                        <div class="col">
                            <small class="fw-bold d-block text-muted">DZUHUR</small>
                            <input type="number" name="dzuhur_offset" class="form-control form-control-sm text-center" value="<%= profile.dzuhur_offset || 0 %>">
                        </div>
                        <div class="col">
                            <small class="fw-bold d-block text-muted">ASHAR</small>
                            <input type="number" name="ashar_offset" class="form-control form-control-sm text-center" value="<%= profile.ashar_offset || 0 %>">
                        </div>
                        <div class="col">
                            <small class="fw-bold d-block text-muted">MAGHRIB</small>
                            <input type="number" name="maghrib_offset" class="form-control form-control-sm text-center" value="<%= profile.maghrib_offset || 0 %>">
                        </div>
                        <div class="col">
                            <small class="fw-bold d-block text-muted">ISYA</small>
                            <input type="number" name="isya_offset" class="form-control form-control-sm text-center" value="<%= profile.isya_offset || 0 %>">
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-3 p-4 bg-white mb-4">
                    <h5 class="fw-bold mb-3 border-bottom pb-2 text-dark"><i class="bi bi-people me-2 text-primary"></i> Petugas Sholat Jumat Minggu Ini</h5>
                    
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Khatib Sholat Jumat</label>
                        <input type="text" name="friday_khatib" class="form-control" placeholder="Ustadz Drs. H. Ahmad Dahlan" value="<%= profile.friday_khatib || '' %>">
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Imam Sholat Jumat</label>
                        <input type="text" name="friday_imam" class="form-control" placeholder="Ust. Muhammad Ridwan, S.Pd.I" value="<%= profile.friday_imam || '' %>">
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Muadzin & Bilal</label>
                        <input type="text" name="friday_muadzin" class="form-control" placeholder="Akang Abdullah" value="<%= profile.friday_muadzin || '' %>">
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-3 p-4 bg-white mb-4">
                    <h5 class="fw-bold mb-3 border-bottom pb-2 text-dark"><i class="bi bi-share me-2 text-primary"></i> Media Sosial & Kontak</h5>
                    
                    <div class="mb-3">
                        <label class="form-label fw-semibold"><i class="bi bi-whatsapp text-success me-1"></i> WhatsApp Center</label>
                        <input type="text" name="social_whatsapp" class="form-control" placeholder="628123456789" value="<%= profile.social_whatsapp || '' %>">
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold"><i class="bi bi-instagram text-danger me-1"></i> Link Instagram</label>
                        <input type="url" name="social_instagram" class="form-control" placeholder="https://instagram.com/masjid" value="<%= profile.social_instagram || '' %>">
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold"><i class="bi bi-facebook text-primary me-1"></i> Link Facebook</label>
                        <input type="url" name="social_facebook" class="form-control" placeholder="https://facebook.com/masjid" value="<%= profile.social_facebook || '' %>">
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold"><i class="bi bi-youtube text-danger me-1"></i> Link YouTube Channel</label>
                        <input type="url" name="social_youtube" class="form-control" placeholder="https://youtube.com/@masjid" value="<%= profile.social_youtube || '' %>">
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-3 p-4 bg-white mb-4">
                    <h5 class="fw-bold mb-3 border-bottom pb-2 text-dark"><i class="bi bi-map me-2 text-primary"></i> Embed Google Maps</h5>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Iframe / Share Link Embed Google Maps</label>
                        <textarea name="maps_embed" class="form-control font-monospace small" rows="3" placeholder='<iframe src="https://www.google.com/maps/embed?pb=..." ...></iframe>'><%= profile.maps_embed || '' %></textarea>
                    </div>
                </div>
            </div>

            <div class="col-12 text-end">
                <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm">
                    <i class="bi bi-save me-1"></i> Simpan Perubahan Pengaturan
                </button>
            </div>
        </div>
    </form>
</div>
