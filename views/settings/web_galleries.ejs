<div class="container-fluid px-0">
    <!-- Header Page -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="bi bi-camera me-2 text-primary"></i> Kelola Galeri Album & Foto Kegiatan</h4>
            <p class="text-muted small m-0">Kelola dokumentasi masjid dalam bentuk album, atur penayangan di Beranda (Home), dan unggah foto secara massal.</p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-primary btn-sm fw-semibold shadow-sm px-3" data-bs-toggle="modal" data-bs-target="#modalAddAlbum">
                <i class="bi bi-folder-plus me-1"></i> Buat Album Baru
            </button>
        </div>
    </div>

    <!-- Alert Flash Message -->
    <% if (typeof successMsg !== 'undefined' && successMsg) { %>
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> <%= successMsg %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>
    <% if (typeof errorMsg !== 'undefined' && errorMsg) { %>
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= errorMsg %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <!-- Filter & Toolbar Bar -->
    <div class="card border-0 shadow-sm rounded-3 p-3 bg-white mb-4">
        <div class="row g-3 align-items-center">
            <!-- Search Input -->
            <div class="col-lg-4 col-md-5">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" id="albumSearchInput" class="form-control bg-light border-start-0" placeholder="Cari nama album atau kegiatan...">
                    <button class="btn btn-outline-secondary d-none" type="button" id="clearSearchBtn"><i class="bi bi-x-lg"></i></button>
                </div>
            </div>

            <!-- Kategori Tabs -->
            <div class="col-lg-8 col-md-7">
                <div class="d-flex flex-wrap align-items-center gap-1 justify-content-md-end">
                    <% 
                        const counts = typeof categoryCounts !== 'undefined' ? categoryCounts : {};
                        const catList = [
                            { key: 'Semua', label: 'Semua Album' },
                            { key: 'Kegiatan', label: 'Kegiatan Ibadah & PHBI' },
                            { key: 'Fasilitas', label: 'Fasilitas Masjid' },
                            { key: 'Pembangunan', label: 'Pembangunan' },
                            { key: 'Kajian', label: 'Kajian & Pendidikan' },
                            { key: 'Bakti Social', label: 'Bakti Sosial' }
                        ];
                    %>
                    <% catList.forEach(c => { %>
                        <a href="/settings/web/galleries?category=<%= encodeURIComponent(c.key) %>" 
                           class="btn btn-sm rounded-pill <%= selectedCategory === c.key ? 'btn-primary fw-bold' : 'btn-outline-secondary' %>">
                            <%= c.label %>
                            <% if (typeof counts[c.key] !== 'undefined') { %>
                                <span class="badge <%= selectedCategory === c.key ? 'bg-white text-primary' : 'bg-light text-secondary border' %> ms-1 rounded-pill">
                                    <%= counts[c.key] %>
                                </span>
                            <% } %>
                        </a>
                    <% }); %>
                </div>
            </div>
        </div>
    </div>

    <!-- Grid Album Galeri -->
    <div class="row g-4" id="albumGrid">
        <% const listAlbums = (typeof albums !== 'undefined' && albums) ? albums : []; %>
        <% if (listAlbums.length > 0) { %>
            <% listAlbums.forEach(a => { %>
                <div class="col-xl-3 col-lg-4 col-md-6 album-card-col" 
                     data-title="<%= (a.title || '').toLowerCase() %>" 
                     data-desc="<%= (a.description || '').toLowerCase() %>" 
                     data-category="<%= a.category %>">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white h-100 album-item-card position-relative d-flex flex-column">
                        <!-- Cover Image with Badges -->
                        <div class="position-relative overflow-hidden bg-light" style="height: 190px;">
                            <img src="<%= a.cover_image || '/images/hero-default.jpg' %>" 
                                 class="w-100 h-100 object-fit-cover" 
                                 alt="<%= a.title %>" 
                                 onerror="this.src='/images/hero-default.jpg'">
                            
                            <!-- Category Badge (Top-Left) -->
                            <div class="position-absolute top-0 start-0 p-2 z-2">
                                <span class="badge bg-dark bg-opacity-75 text-white backdrop-blur shadow-sm small">
                                    <%= a.category %>
                                </span>
                            </div>

                            <!-- Photo Count Badge (Top-Right) -->
                            <div class="position-absolute top-0 end-0 p-2 z-2">
                                <span class="badge bg-warning text-dark shadow-sm px-2.5 py-1.5 rounded-pill fw-bold small">
                                    <i class="bi bi-images me-1"></i> <%= a.photo_count || 0 %> Foto
                                </span>
                            </div>
                        </div>

                        <!-- Card Body -->
                        <div class="card-body p-3 d-flex flex-column flex-grow-1">
                            <!-- Home Display Badge & Toggle Button -->
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <small class="text-muted extra-small">
                                    <i class="bi bi-calendar3 me-1 text-primary"></i> 
                                    <%= a.event_date ? formatDate(a.event_date) : formatDate(a.created_at) %>
                                </small>
                                
                                <form action="/settings/web/galleries/album/toggle-home/<%= a.id %>" method="POST" class="d-inline">
                                    <% if (a.show_on_home) { %>
                                        <button type="submit" class="btn btn-xs btn-outline-success fw-bold rounded-pill px-2 py-0.5" style="font-size: 0.72rem;" title="Klik untuk sembunyikan dari Beranda Utama">
                                            <i class="bi bi-house-check-fill me-1"></i> Tampil di Beranda
                                        </button>
                                    <% } else { %>
                                        <button type="submit" class="btn btn-xs btn-outline-secondary fw-semibold rounded-pill px-2 py-0.5" style="font-size: 0.72rem;" title="Klik untuk tayangkan di Beranda Utama">
                                            <i class="bi bi-house-dash me-1"></i> Tidak di Beranda
                                        </button>
                                    <% } %>
                                </form>
                            </div>

                            <h6 class="fw-bold text-dark mb-1 text-truncate" title="<%= a.title %>"><%= a.title %></h6>

                            <p class="text-secondary small mb-3 flex-grow-1 line-clamp-2" style="font-size: 0.85rem; line-height: 1.4;">
                                <%= a.description ? a.description : 'Tidak ada keterangan album.' %>
                            </p>

                            <!-- Bottom Quick Controls -->
                            <div class="pt-2 border-top d-flex justify-content-between align-items-center mt-auto">
                                <button type="button" class="btn btn-primary btn-sm rounded-pill fw-semibold btn-manage-photos" 
                                        data-album-id="<%= a.id %>" 
                                        data-album-title="<%= a.title %>" 
                                        data-bs-toggle="modal" 
                                        data-bs-target="#modalManagePhotos">
                                    <i class="bi bi-images me-1"></i> Foto (<%= a.photo_count || 0 %>)
                                </button>
                                
                                <div class="d-flex gap-1">
                                    <a href="/galeri/<%= a.slug %>" target="_blank" class="btn btn-sm btn-outline-secondary rounded-circle p-1.5" title="Lihat di Web">
                                        <i class="bi bi-box-arrow-up-right"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-warning rounded-circle p-1.5 text-dark" 
                                            data-bs-toggle="modal" data-bs-target="#modalEditAlbum<%= a.id %>" 
                                            title="Edit Info Album">
                                        <i class="bi bi-pencil-fill"></i>
                                    </button>
                                    <form action="/settings/web/galleries/album/delete/<%= a.id %>" method="POST" class="d-inline" onsubmit="return confirm('Hapus album ini beserta seluruh fotonya?')">
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle p-1.5" title="Hapus Album">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <div class="col-12 text-center py-5 bg-white rounded-4 shadow-sm text-muted">
                <i class="bi bi-images display-3 d-block mb-3 text-secondary opacity-50"></i>
                <h5 class="fw-bold text-dark mb-1">Belum Ada Album di Kategori Ini</h5>
                <p class="text-muted small mb-3">Klik tombol di bawah untuk membuat album dokumentasi foto kegiatan atau sarana masjid.</p>
                <button type="button" class="btn btn-primary btn-sm fw-semibold px-3" data-bs-toggle="modal" data-bs-target="#modalAddAlbum">
                    <i class="bi bi-folder-plus me-1"></i> Buat Album Sekarang
                </button>
            </div>
        <% } %>
    </div>

    <!-- Empty State for Search Filter (JS driven) -->
    <div id="noSearchMatchAlert" class="col-12 text-center py-5 bg-white rounded-4 shadow-sm text-muted d-none mt-3">
        <i class="bi bi-search display-4 d-block mb-2 text-secondary opacity-50"></i>
        <h5 class="fw-bold text-dark">Tidak Ada Album yang Cocok</h5>
        <p class="text-muted small">Coba ubah kata kunci pencarian Anda.</p>
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL BUAT ALBUM BARU                      -->
<!-- ========================================== -->
<div class="modal fade" id="modalAddAlbum" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-primary text-white py-3 px-4">
                <h5 class="modal-title fw-bold"><i class="bi bi-folder-plus me-2"></i> Buat Album Galeri Baru</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <form action="/settings/web/galleries/album/create" method="POST" enctype="multipart/form-data" id="formAddAlbum">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-7">
                            <label class="form-label fw-semibold">Nama / Judul Album <span class="text-danger">*</span></label>
                            <input type="text" name="title" class="form-control" placeholder="Misal: Sholat Tarawih & Witir 1447H" required>
                        </div>

                        <div class="col-md-5">
                            <label class="form-label fw-semibold">Kategori Dokumentasi</label>
                            <select name="category" class="form-select">
                                <option value="Kegiatan">Kegiatan Ibadah & PHBI</option>
                                <option value="Fasilitas">Fasilitas Masjid</option>
                                <option value="Pembangunan">Proyek Pembangunan</option>
                                <option value="Kajian">Kajian & Pendidikan</option>
                                <option value="Bakti Social">Bakti Sosial</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Tanggal Pelaksanaan / Momen</label>
                            <input type="date" name="event_date" class="form-control" value="<%= new Date().toISOString().substring(0,10) %>">
                        </div>

                        <div class="col-md-6 d-flex align-items-center">
                            <div class="form-check form-switch mt-3">
                                <input class="form-check-input" type="checkbox" role="switch" id="switchShowOnHome" name="show_on_home" value="1" checked>
                                <label class="form-check-label fw-semibold text-dark" for="switchShowOnHome">
                                    Tampilkan Album di Beranda (Home)
                                </label>
                                <small class="text-muted d-block extra-small">Jika aktif, album akan tampil di halaman depan seperti berita.</small>
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Deskripsi Singkat Album (Opsional)</label>
                            <textarea name="description" class="form-control" rows="2" placeholder="Catatan atau rangkuman dokumentasi kegiatan ini..."></textarea>
                        </div>

                        <!-- Dropzone Upload Foto Album -->
                        <div class="col-12">
                            <label class="form-label fw-semibold">Unggah Foto Album (Bisa Pilih Banyak Foto Sekaligus)</label>
                            <div class="dropzone-box text-center p-4 rounded-3 border-dashed position-relative" id="albumDropzone">
                                <input type="file" name="images" id="albumFileInput" class="dropzone-input" accept="image/jpeg,image/png,image/webp,image/gif" multiple>
                                
                                <div class="dropzone-placeholder" id="albumPlaceholder">
                                    <i class="bi bi-images display-5 text-primary mb-2 d-block"></i>
                                    <p class="mb-1 fw-bold text-dark">Tarik & lepas foto di sini, atau <span class="text-primary text-decoration-underline">pilih file</span></p>
                                    <small class="text-muted">Maksimal 30 foto sekaligus (JPG, PNG, WEBP, GIF, masing-masing maks 5 MB). Foto pertama otomatis jadi cover jika cover belum diset.</small>
                                </div>
                            </div>
                        </div>

                        <!-- Multi Preview Grid Container -->
                        <div class="col-12 d-none" id="albumPreviewContainer">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-semibold small text-dark"><span id="albumCountText">0</span> Foto Terpilih:</span>
                                <button type="button" class="btn btn-link text-danger text-decoration-none p-0 small" id="btnClearAlbumFiles">
                                    <i class="bi bi-trash me-1"></i> Hapus Pilihan
                                </button>
                            </div>
                            <div class="row g-2 p-2 border rounded-3 bg-light overflow-auto" id="albumThumbGrid" style="max-height: 180px;">
                                <!-- Thumbnails injected via JS -->
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light px-4 py-3">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-primary btn-sm fw-bold px-4" id="btnSubmitAlbum">
                        <i class="bi bi-check2-circle me-1"></i> Simpan Album & Unggah Foto
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL KELOLA FOTO ALBUM (AJAX UNIFIED)     -->
<!-- ========================================== -->
<div class="modal fade" id="modalManagePhotos" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-dark text-white py-3 px-4 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-images text-warning fs-5"></i>
                    <div>
                        <h5 class="modal-title fw-bold text-white mb-0" id="manageModalAlbumTitle">Kelola Foto Album</h5>
                        <small class="text-white-50" id="manageModalPhotoCount">Memuat data foto...</small>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body p-4 bg-light">
                <!-- Section Unggah Foto Tambahan ke Album -->
                <div class="card border-0 shadow-sm rounded-3 p-3 bg-white mb-4">
                    <h6 class="fw-bold text-dark mb-2"><i class="bi bi-cloud-arrow-up text-primary me-1"></i> Tambah Foto Baru ke Album Ini</h6>
                    <form id="formAddPhotosToAlbum" action="" method="POST" enctype="multipart/form-data">
                        <div class="row g-2 align-items-center">
                            <div class="col-md-9">
                                <input type="file" name="images" class="form-control form-control-sm" accept="image/jpeg,image/png,image/webp,image/gif" multiple required>
                                <small class="text-muted extra-small">Bisa memilih beberapa foto sekaligus (Maksimal 30 foto).</small>
                            </div>
                            <div class="col-md-3">
                                <button type="submit" class="btn btn-success btn-sm fw-semibold w-100">
                                    <i class="bi bi-upload me-1"></i> Unggah Foto
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- Grid Foto Dalam Album -->
                <h6 class="fw-bold text-dark mb-3"><i class="bi bi-collection text-teal me-1"></i> Daftar Foto Dalam Album</h6>
                
                <div id="managePhotosLoading" class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="text-muted small mt-2">Memuat koleksi foto...</p>
                </div>

                <div id="managePhotosEmpty" class="text-center py-5 d-none bg-white rounded-3 border">
                    <i class="bi bi-images display-5 text-secondary opacity-50 d-block mb-2"></i>
                    <h6 class="fw-bold text-dark">Belum ada foto dalam album ini</h6>
                    <p class="text-muted small mb-0">Silakan gunakan form di atas untuk mengunggah foto.</p>
                </div>

                <div class="row g-3" id="managePhotosGrid">
                    <!-- Photo cards injected dynamically by JS -->
                </div>
            </div>

            <div class="modal-footer bg-white px-4 py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Tutup</button>
            </div>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL EDIT DATA ALBUM                      -->
<!-- ========================================== -->
<% if (listAlbums.length > 0) { %>
    <% listAlbums.forEach(a => { %>
        <div class="modal fade" id="modalEditAlbum<%= a.id %>" tabindex="-1" data-bs-backdrop="static">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg rounded-4">
                    <div class="modal-header bg-warning text-dark py-3 px-4">
                        <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2"></i> Edit Data Album</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <form action="/settings/web/galleries/album/update/<%= a.id %>" method="POST" enctype="multipart/form-data">
                        <div class="modal-body p-4 text-start">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Nama / Judul Album <span class="text-danger">*</span></label>
                                <input type="text" name="title" class="form-control" value="<%= a.title %>" required>
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Kategori Dokumentasi</label>
                                    <select name="category" class="form-select">
                                        <option value="Kegiatan" <%= a.category === 'Kegiatan' ? 'selected' : '' %>>Kegiatan Ibadah & PHBI</option>
                                        <option value="Fasilitas" <%= a.category === 'Fasilitas' ? 'selected' : '' %>>Fasilitas Masjid</option>
                                        <option value="Pembangunan" <%= a.category === 'Pembangunan' ? 'selected' : '' %>>Proyek Pembangunan</option>
                                        <option value="Kajian" <%= a.category === 'Kajian' ? 'selected' : '' %>>Kajian & Pendidikan</option>
                                        <option value="Bakti Social" <%= a.category === 'Bakti Social' ? 'selected' : '' %>>Bakti Sosial</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Tanggal Kegiatan</label>
                                    <input type="date" name="event_date" class="form-control" value="<%= a.event_date ? new Date(a.event_date).toISOString().substring(0,10) : '' %>">
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch" id="editShowOnHome<%= a.id %>" name="show_on_home" value="1" <%= a.show_on_home ? 'checked' : '' %>>
                                    <label class="form-check-label fw-semibold text-dark" for="editShowOnHome<%= a.id %>">
                                        Tampilkan di Beranda (Home)
                                    </label>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Foto Sampul (Cover Image)</label>
                                <div class="p-2 border rounded-3 bg-light text-center mb-2">
                                    <img src="<%= a.cover_image || '/images/hero-default.jpg' %>" id="editCoverPreview<%= a.id %>" class="img-fluid rounded border shadow-sm" style="max-height: 120px; object-fit: contain;">
                                </div>
                                <input type="file" name="cover_image" class="form-control edit-file-input" data-target="#editCoverPreview<%= a.id %>" accept="image/jpeg,image/png,image/webp,image/gif">
                                <small class="text-muted extra-small">Biarkan kosong jika tidak ingin mengganti cover.</small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Deskripsi / Keterangan Album</label>
                                <textarea name="description" class="form-control" rows="3" placeholder="Keterangan singkat tentang album..."><%= a.description || '' %></textarea>
                            </div>
                        </div>
                        <div class="modal-footer bg-light px-4 py-3">
                            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Batal</button>
                            <button type="submit" class="btn btn-warning btn-sm fw-bold px-3">Simpan Perubahan</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    <% }); %>
<% } %>

<!-- Custom Style -->
<style>
    .border-dashed {
        border: 2px dashed #cbd5e1;
        background-color: #f8fafc;
        transition: all 0.2s ease-in-out;
        cursor: pointer;
    }
    .border-dashed:hover {
        border-color: #0d9488;
        background-color: #f0fdfa;
    }
    .dropzone-input {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        cursor: pointer;
        z-index: 5;
    }
    .album-item-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .album-item-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 24px rgba(0,0,0,0.08) !important;
    }
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .backdrop-blur {
        backdrop-filter: blur(4px);
    }
</style>

<!-- Scripts -->
<script>
document.addEventListener('DOMContentLoaded', () => {
    // 1. Live Filter Pencarian Album
    const searchInput = document.getElementById('albumSearchInput');
    const clearBtn = document.getElementById('clearSearchBtn');
    const albumCols = document.querySelectorAll('.album-card-col');
    const emptySearchAlert = document.getElementById('noSearchMatchAlert');

    if (searchInput) {
        searchInput.addEventListener('input', function () {
            const query = this.value.toLowerCase().trim();
            if (query.length > 0) {
                clearBtn.classList.remove('d-none');
            } else {
                clearBtn.classList.add('d-none');
            }

            let visibleCount = 0;
            albumCols.forEach(col => {
                const title = col.getAttribute('data-title') || '';
                const desc = col.getAttribute('data-desc') || '';
                if (title.includes(query) || desc.includes(query)) {
                    col.style.display = '';
                    visibleCount++;
                } else {
                    col.style.display = 'none';
                }
            });

            if (visibleCount === 0 && albumCols.length > 0) {
                emptySearchAlert.classList.remove('d-none');
            } else {
                emptySearchAlert.classList.add('d-none');
            }
        });

        clearBtn.addEventListener('click', function () {
            searchInput.value = '';
            clearBtn.classList.add('d-none');
            albumCols.forEach(col => col.style.display = '');
            emptySearchAlert.classList.add('d-none');
            searchInput.focus();
        });
    }

    // 2. Dropzone Preview Unggah Foto Album Baru
    const albumFileInput = document.getElementById('albumFileInput');
    const albumPreviewContainer = document.getElementById('albumPreviewContainer');
    const albumThumbGrid = document.getElementById('albumThumbGrid');
    const albumCountText = document.getElementById('albumCountText');
    const btnClearAlbumFiles = document.getElementById('btnClearAlbumFiles');

    if (albumFileInput) {
        albumFileInput.addEventListener('change', function () {
            const files = Array.from(this.files || []);
            if (files.length > 30) {
                alert('Maksimal dapat mengunggah 30 foto sekaligus.');
                this.value = '';
                return;
            }
            if (files.length > 0) {
                albumThumbGrid.innerHTML = '';
                albumCountText.textContent = files.length;
                albumPreviewContainer.classList.remove('d-none');

                files.forEach((file, idx) => {
                    const col = document.createElement('div');
                    col.className = 'col-3 col-sm-2 text-center position-relative';
                    
                    const img = document.createElement('img');
                    img.className = 'img-thumbnail rounded object-fit-cover w-100 shadow-sm';
                    img.style.height = '60px';
                    
                    const caption = document.createElement('div');
                    caption.className = 'text-truncate extra-small text-muted mt-1';
                    caption.textContent = (idx === 0 ? 'Cover: ' : '') + file.name;

                    const reader = new FileReader();
                    reader.onload = function (e) {
                        img.src = e.target.result;
                    };
                    reader.readAsDataURL(file);

                    col.appendChild(img);
                    col.appendChild(caption);
                    albumThumbGrid.appendChild(col);
                });
            } else {
                albumPreviewContainer.classList.add('d-none');
                albumThumbGrid.innerHTML = '';
            }
        });
    }

    if (btnClearAlbumFiles) {
        btnClearAlbumFiles.addEventListener('click', function () {
            albumFileInput.value = '';
            albumThumbGrid.innerHTML = '';
            albumPreviewContainer.classList.add('d-none');
        });
    }

    // 3. Live Preview saat ganti gambar di Modal Edit
    document.querySelectorAll('.edit-file-input').forEach(input => {
        input.addEventListener('change', function () {
            const targetSelector = this.getAttribute('data-target');
            const targetImg = document.querySelector(targetSelector);
            if (this.files && this.files[0] && targetImg) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    targetImg.src = e.target.result;
                };
                reader.readAsDataURL(this.files[0]);
            }
        });
    });

    // 4. Unified Modal Kelola Foto Album (AJAX loader)
    const manageModal = document.getElementById('modalManagePhotos');
    const manageTitle = document.getElementById('manageModalAlbumTitle');
    const manageCount = document.getElementById('manageModalPhotoCount');
    const manageForm = document.getElementById('formAddPhotosToAlbum');
    const manageGrid = document.getElementById('managePhotosGrid');
    const manageLoading = document.getElementById('managePhotosLoading');
    const manageEmpty = document.getElementById('managePhotosEmpty');

    document.querySelectorAll('.btn-manage-photos').forEach(btn => {
        btn.addEventListener('click', function () {
            const albumId = this.getAttribute('data-album-id');
            const albumTitle = this.getAttribute('data-album-title');

            manageTitle.textContent = 'Kelola Foto: ' + albumTitle;
            manageCount.textContent = 'Memuat foto...';
            manageForm.action = `/settings/web/galleries/album/${albumId}/photos/add`;
            manageGrid.innerHTML = '';
            manageLoading.classList.remove('d-none');
            manageEmpty.classList.add('d-none');

            fetch(`/settings/web/galleries/album/${albumId}/photos`)
                .then(res => res.json())
                .then(data => {
                    manageLoading.classList.add('d-none');
                    if (!data.success || !data.photos || data.photos.length === 0) {
                        manageEmpty.classList.remove('d-none');
                        manageCount.textContent = '0 Foto dalam album';
                        return;
                    }

                    const album = data.album || {};
                    const photos = data.photos;
                    manageCount.textContent = `${photos.length} Foto dalam album`;

                    photos.forEach((photo, idx) => {
                        const isCover = (photo.image_url === album.cover_image);
                        const col = document.createElement('div');
                        col.className = 'col-lg-3 col-md-4 col-sm-6';

                        col.innerHTML = `
                            <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white h-100 position-relative">
                                <div class="position-relative" style="height: 140px;">
                                    <img src="${photo.image_url}" class="w-100 h-100 object-fit-cover" alt="Foto ${idx + 1}">
                                    ${isCover ? `
                                        <div class="position-absolute top-0 start-0 p-1.5">
                                            <span class="badge bg-success shadow-sm extra-small"><i class="bi bi-star-fill me-1"></i> Cover</span>
                                        </div>
                                    ` : ''}
                                </div>
                                <div class="card-body p-2 d-flex flex-column justify-content-between">
                                    <small class="text-muted extra-small text-truncate mb-2">${photo.caption || 'Foto ' + (idx + 1)}</small>
                                    <div class="d-flex justify-content-between align-items-center gap-1 border-top pt-1.5">
                                        ${!isCover ? `
                                            <form action="/settings/web/galleries/album/${albumId}/cover/${photo.id}" method="POST" class="d-inline">
                                                <button type="submit" class="btn btn-xs btn-outline-primary py-0.5 px-2" style="font-size: 0.72rem;">
                                                    <i class="bi bi-star me-1"></i>Jadikan Cover
                                                </button>
                                            </form>
                                        ` : `
                                            <span class="text-success extra-small fw-bold"><i class="bi bi-check2"></i> Sampul Utama</span>
                                        `}
                                        <form action="/settings/web/galleries/album/photo/delete/${photo.id}" method="POST" class="d-inline" onsubmit="return confirm('Hapus foto ini?')">
                                            <button type="submit" class="btn btn-xs btn-outline-danger py-0.5 px-1.5" title="Hapus Foto">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        `;
                        manageGrid.appendChild(col);
                    });
                })
                .catch(err => {
                    manageLoading.classList.add('d-none');
                    manageGrid.innerHTML = `<div class="col-12 text-center text-danger py-4">Gagal memuat foto album: ${err.message}</div>`;
                });
        });
    });
});
</script>
