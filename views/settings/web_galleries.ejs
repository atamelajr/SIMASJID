<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="bi bi-camera me-2 text-primary"></i> Kelola Galeri Foto Kegiatan</h4>
            <p class="text-muted small m-0">Unggah foto kegiatan, fasilitas, & dokumentasi momen masjid.</p>
        </div>
        <button type="button" class="btn btn-primary btn-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#modalAddGallery">
            <i class="bi bi-upload me-1"></i> Unggah Foto Baru
        </button>
    </div>

    <% if (typeof successMsg !== 'undefined' && successMsg) { %>
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> <%= successMsg %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>
    <% if (typeof errorMsg !== 'undefined' && errorMsg) { %>
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= errorMsg %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <!-- Filter Kategori Nav -->
    <div class="card border-0 shadow-sm rounded-3 p-3 bg-white mb-4">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <span class="fw-bold text-muted me-2 small"><i class="bi bi-funnel me-1"></i> Filter Kategori:</span>
            <a href="/settings/web/galleries?category=Semua" class="btn btn-sm rounded-pill <%= selectedCategory === 'Semua' ? 'btn-primary fw-bold' : 'btn-outline-secondary' %>">Semua Foto</a>
            <a href="/settings/web/galleries?category=Kegiatan" class="btn btn-sm rounded-pill <%= selectedCategory === 'Kegiatan' ? 'btn-primary fw-bold' : 'btn-outline-secondary' %>">Kegiatan Ibadah & PHBI</a>
            <a href="/settings/web/galleries?category=Fasilitas" class="btn btn-sm rounded-pill <%= selectedCategory === 'Fasilitas' ? 'btn-primary fw-bold' : 'btn-outline-secondary' %>">Fasilitas Masjid</a>
            <a href="/settings/web/galleries?category=Pembangunan" class="btn btn-sm rounded-pill <%= selectedCategory === 'Pembangunan' ? 'btn-primary fw-bold' : 'btn-outline-secondary' %>">Proyek Pembangunan</a>
            <a href="/settings/web/galleries?category=Kajian" class="btn btn-sm rounded-pill <%= selectedCategory === 'Kajian' ? 'btn-primary fw-bold' : 'btn-outline-secondary' %>">Kajian & Pendidikan</a>
            <a href="/settings/web/galleries?category=Bakti Social" class="btn btn-sm rounded-pill <%= selectedCategory === 'Bakti Social' ? 'btn-primary fw-bold' : 'btn-outline-secondary' %>">Bakti Sosial</a>
        </div>
    </div>

    <!-- Grid Galeri Foto -->
    <div class="row g-4">
        <% if (galleries && galleries.length > 0) { %>
            <% galleries.forEach(g => { %>
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white h-100 position-relative group-gallery">
                        <img src="<%= g.image_url %>" class="card-img-top object-fit-cover" style="height: 180px;" alt="<%= g.title %>" onerror="this.src='/images/hero-default.jpg'">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="badge bg-primary-subtle text-primary border border-primary small"><%= g.category %></span>
                                <% if (g.event_date) { %>
                                    <small class="text-muted extra-small"><i class="bi bi-calendar3 me-1"></i> <%= formatDate(g.event_date) %></small>
                                <% } %>
                            </div>
                            <h6 class="fw-bold text-dark m-0 text-truncate" title="<%= g.title %>"><%= g.title %></h6>
                            <small class="text-muted d-block mt-1 text-truncate"><%= g.description || '-' %></small>
                        </div>
                        <div class="card-footer bg-light p-2 d-flex justify-content-between align-items-center">
                            <button type="button" class="btn btn-outline-warning btn-sm py-0 px-2" data-bs-toggle="modal" data-bs-target="#modalEditGallery<%= g.id %>" title="Edit Data"><i class="bi bi-pencil"></i></button>
                            <form action="/settings/web/galleries/delete/<%= g.id %>" method="POST" class="d-inline" onsubmit="return confirm('Hapus foto ini dari galeri?')">
                                <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2" title="Hapus Data"><i class="bi bi-trash"></i></button>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Modal Edit Galeri Foto -->
                <div class="modal fade" id="modalEditGallery<%= g.id %>" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-0 shadow">
                            <div class="modal-header bg-warning text-dark">
                                <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2"></i> Edit Foto Galeri</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <form action="/settings/web/galleries/update/<%= g.id %>" method="POST" enctype="multipart/form-data">
                                <div class="modal-body p-4 text-start">
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Judul / Nama Foto</label>
                                        <input type="text" name="title" class="form-control" value="<%= g.title %>" required>
                                    </div>
                                    <div class="row g-2 mb-3">
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">Kategori Dokumentasi</label>
                                            <select name="category" class="form-select">
                                                <option value="Kegiatan" <%= g.category === 'Kegiatan' ? 'selected' : '' %>>Kegiatan Ibadah & PHBI</option>
                                                <option value="Fasilitas" <%= g.category === 'Fasilitas' ? 'selected' : '' %>>Fasilitas Masjid</option>
                                                <option value="Pembangunan" <%= g.category === 'Pembangunan' ? 'selected' : '' %>>Proyek Pembangunan</option>
                                                <option value="Kajian" <%= g.category === 'Kajian' ? 'selected' : '' %>>Kajian & Pendidikan</option>
                                                <option value="Bakti Social" <%= g.category === 'Bakti Social' ? 'selected' : '' %>>Bakti Sosial</option>
                                            </select>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">Tanggal Kegiatan</label>
                                            <input type="date" name="event_date" class="form-control" value="<%= g.event_date ? g.event_date.toISOString().substring(0,10) : '' %>">
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Ganti File Foto (Kosongkan jika tidak diubah)</label>
                                        <div class="mb-2">
                                            <img src="<%= g.image_url %>" height="70" class="rounded border">
                                        </div>
                                        <input type="file" name="image" class="form-control" accept="image/*">
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Deskripsi / Keterangan</label>
                                        <textarea name="description" class="form-control" rows="2"><%= g.description || '' %></textarea>
                                    </div>
                                </div>
                                <div class="modal-footer bg-light">
                                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Batal</button>
                                    <button type="submit" class="btn btn-warning btn-sm fw-bold px-3">Simpan Perubahan</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <div class="col-12 text-center py-5 bg-white rounded shadow-sm text-muted">
                <i class="bi bi-images display-4 d-block mb-2"></i>
                <p>Belum ada foto yang diunggah ke galeri untuk kategori ini.</p>
            </div>
        <% } %>
    </div>
</div>

<!-- Modal Tambah Galeri Foto -->
<div class="modal fade" id="modalAddGallery" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-upload me-2"></i> Unggah Foto ke Galeri</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="/settings/web/galleries/create" method="POST" enctype="multipart/form-data">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Judul / Nama Foto</label>
                        <input type="text" name="title" class="form-control" placeholder="Misal: Sholat Idul Fitri 1447H" required>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Kategori Dokumentasi</label>
                            <select name="category" class="form-select">
                                <option value="Kegiatan">Kegiatan Ibadah & PHBI</option>
                                <option value="Fasilitas">Fasilitas Masjid</option>
                                <option value="Pembangunan">Proyek Pembangunan</option>
                                <option value="Kajian">Kajian & Pendidikan</option>
                                <option value="Bakti Social">Bakti Sosial</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Tanggal Kegiatan</label>
                            <input type="date" name="event_date" class="form-control">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">File Foto</label>
                        <input type="file" name="image" class="form-control" accept="image/*" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Deskripsi / Keterangan (Opsional)</label>
                        <textarea name="description" class="form-control" rows="2" placeholder="Keterangan singkat tentang foto..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-primary btn-sm fw-bold px-3">Unggah Foto</button>
                </div>
            </form>
        </div>
    </div>
</div>
